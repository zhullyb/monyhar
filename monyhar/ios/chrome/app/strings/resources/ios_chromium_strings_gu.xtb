<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="102360288709523007">ઉપયોગનાં આંકડા અને ક્રૅશ રિપોર્ટ Googleને મોકલીને Monyharને બહેતર બનાવવામાં મદદ કરો.</translation>
<translation id="1185134272377778587">Monyhar વિશે</translation>
<translation id="1257458525759135959">છબીઓ સાચવવા માટે, સેટિંગ પર ટૅપ કરો જેથી Monyhar તમારા ફોટા ઉમેરી શકે</translation>
<translation id="1289216811211435351">Monyhar પર સ્વિચ કરો</translation>
<translation id="1361748954329991663">Monyhar જૂનું થઈ ગયું છે. જો <ph name="BEGIN_LINK" />ઍપ સ્ટોર<ph name="END_LINK" />માં કોઈ અપડેટ ઉપલબ્ધ ન હોય, તો એવું બની શકે છે કે તમારું ડિવાઇસ હવેથી Monyharના નવા વર્ઝનને સપોર્ટ ન કરતું હોય.</translation>
<translation id="1431818719585918472">Monyharને તમારી છૂપી ટૅબ લૉક કરવા દો.</translation>
<translation id="1472013873724362412">તમારું એકાઉન્ટ Monyhar પર કાર્ય કરતું નથી. કૃપા કરીને તમારા ડોમેન એડમિનનો સંપર્ક કરો અથવા સાઇન ઇન કરવા માટે નિયમિત Google એકાઉન્ટનો ઉપયોગ કરો.</translation>
<translation id="1507010443238049608">Monyharની સુવિધાઓ અને કાર્યપ્રદર્શનને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="1531155317299575425">Monyharમાં સાઇન ઇન કરવા માટેના સંકેતો બતાવો.</translation>
<translation id="1584569488888892906">Monyhar હવે પહેલાં કરતાં વધુ સરળ, સુરક્ષિત અને ઝડપી છે</translation>
<translation id="1617663976202781617">Monyhar સિંકમાંનો ડેટા</translation>
<translation id="1736662517232558588">Monyhar ડેટા સાફ કર્યો</translation>
<translation id="1838412507805038478">Monyhar એ ચકાસણી કરી છે કે <ph name="ISSUER" /> એ આ વેબસાઇટનું પ્રમાણપત્ર જારી કર્યું છે.</translation>
<translation id="1843424232666537147">Monyhar માં એવી સુવિધાઓ છે જે તમારા ઇન્ટરનેટ ડેટા અને તમે કેટલી ઝડપથી વેબ પૃષ્ઠોને લોડ કરવામાં સમર્થ છો તેનું સંચાલન કરવામાં તમારી સહાય કરે છે.
<ph name="BEGIN_LINK" />વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="2006345422933397527">Monyhar અપડેટ ચેક કરી શક્યું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="2054703085270098503">Monyharનો ઉપયોગ કરીને સલામત રહો</translation>
<translation id="2168108852149185974">કેટલાક એડ-ઓનને કારણે Monyhar ક્રૅશ થાય છે. કૃપા કરી આને અનઇન્સ્ટૉલ કરો:</translation>
<translation id="2178608107313874732">Monyhar, અત્યારે તમારા કૅમેરાનો ઉપયોગ કરી શકતું નથી</translation>
<translation id="2195025571279539885">શું તમે Monyharને આ સાઇટથી આગલી વખતે <ph name="LANGUAGE_NAME" /> પેજને અનુવાદ કરવાની ઓફર કરવા માગો છો?</translation>
<translation id="2567507405773541360">અગાઉ ક્યારેય ન હતું એટલા સરળ, સુરક્ષિત અને વધુ ઝડપી Monyhar વડે વધુ કાર્યો પૂર્ણ કરો</translation>
<translation id="2590893390871230428">તમારો Monyhar ડેટા સિંક કરો</translation>
<translation id="2650312721222849884">તમે જ્યાંથી Monyharનો ઉપયોગ કરો ત્યાંથી તમારા ટૅબ જોવા માટે, સિંક કરવાનું ચાલુ કરો</translation>
<translation id="2684230048001240293">તમારા બધા ડિવાઇસ પર તમારી ટૅબ, પાસવર્ડ અને ચુકવણી સંબંધિત માહિતી સિંક કરવા માટે, Monyharને ડિફૉલ્ટ તરીકે સેટ કરો</translation>
<translation id="2730884209570016437">Monyhar, તમારા કૅમેરાનો ઉપયોગ કરી શકતું નથી કારણ કે તે બીજી ઍપ્લિકેશન દ્વારા ઉપયોગમાં છે</translation>
<translation id="2915596697727466327">તમારા પાસવર્ડની અધિકૃત ઍક્સેસની ખાતરી કરવા માટે, Monyhar ચહેરાના IDનો ઉપયોગ કરે છે.</translation>
<translation id="2918709798697875261">તમારી સંસ્થા માટે જરૂરી છે કે તમે Monyharમાં સાઇન આઉટ કરીને રાખો.</translation>
<translation id="2942241131342758843">લિંક ખોલવા, વિજેટથી શોધવા અને અન્ય ઍપમાં પાસવર્ડ ઑટોમૅટિક રીતે ભરવાની સુવિધા માટે ડિફૉલ્ટ તરીકે Monyharનો ઉપયોગ કરો</translation>
<translation id="2977470724722393594">Monyhar અપ ટૂ ડેટ છે</translation>
<translation id="3256316712990552818">Monyhar પર કૉપી કરી</translation>
<translation id="3344973607274501920">Monyhar તમારા પાસવર્ડ ચેક કરી શક્યું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="3472200483164753384">Monyhar Canary પર સપોર્ટ કરવામાં આવતી નથી</translation>
<translation id="3639997914391704523">જ્યારે તમે તમારા Google એકાઉન્ટ વડે સાઇન ઇન કરો, ત્યારે Monyhar તમારા પાસવર્ડ ચેક કરી શકે છે.</translation>
<translation id="3805899903892079518">Monyharને તમારા ફોટા અથવા વીડિયોનો ઍક્સેસ નથી. iOS સેટિંગ &gt; પ્રાઇવસી &gt; ફોટામાં ઍક્સેસને ચાલુ કરો.</translation>
<translation id="3946918322491238254">તમે હજુ પણ આ ડિવાઇસ પરના તમારા બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને અન્ય સેટિંગને જોઈ શકો છો. જો તમે ફેરફારો કરશો, તો તેમને તમારા એકાઉન્ટ સાથે સિંક કરવામાં આવશે નહીં.</translation>
<translation id="4099085513035183040">Monyhar બીટા પર સપોર્ટ કરવામાં આવતી નથી</translation>
<translation id="4166206055865952171">Monyharને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવો</translation>
<translation id="4555020257205549924">જ્યારે આ સુવિધા ચાલુ કરી હોય, ત્યારે Monyhar, Google અનુવાદનો ઉપયોગ કરીને અન્ય ભાષાઓમાં લખેલા પૃષ્ઠોના અનુવાદની ઓફર કરશે. <ph name="BEGIN_LINK" />વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">હવે તમે સંદેશા, દસ્તાવેજો અને અન્ય ઍપમાં લિંક પર કોઈપણ સમયે ટૅપ કરીને Monyharનો ઉપયોગ કરી શકશો.</translation>
<translation id="4681781466797808448">Monyhar સ્કૅન ચાલુ કરો</translation>
<translation id="4736424910885271643">તમારું એકાઉન્ટ <ph name="HOSTED_DOMAIN" /> દ્વારા મેનેજ કરવામાં આવતું હોવાથી, આ ડિવાઇસમાંથી તમારો Monyhar ડેટા સાફ કરવામાં આવશે</translation>
<translation id="4806326830773390517">Googleને વપરાશનાં આંકડા અને ક્રૅશ રિપોર્ટ ઑટોમૅટિક રીતે મોકલીને Monyharને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="4828317641996116749">Monyhar બધા પાસવર્ડ ચેક કરી શક્યું નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="4852878756222711218">Monyharનો સૌથી વધુ લાભ લેવા માટે, તમારા Google એકાઉન્ટ વડે સાઇન ઇન કરો</translation>
<translation id="4985291216379576555">ઑફલાઇન, Monyhar અપડેટ ચેક કરી શકતાં નથી</translation>
<translation id="4999538639245140991">કારણ કે તમે <ph name="SIGNOUT_MANAGED_DOMAIN" /> દ્વારા મેનેજ કરવામાં આવેલ એકાઉન્ટમાંથી સાઇન આઉટ કરી રહ્યાં છો, આ ડિવાઇસમાંથી તમારા Monyhar ડેટા ડિલીટ થઈ જશે. તમારો ડેટા તમારા Google એકાઉન્ટમાં જળવાઈ રહેશે.</translation>
<translation id="5171868502429358653">Monyharમાં સાઇન ઇન કરો</translation>
<translation id="5224391634244552924">કોઈ સાચવેલા પાસવર્ડ નથી. જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Monyhar તેને ચેક કરી શકે છે.</translation>
<translation id="5308226104666789935">Monyhar અપડેટ ચેક કરી શકતું નથી</translation>
<translation id="5396916991083608703">Monyharને ડિફૉલ્ટ તરીકે સેટ કરીએ?</translation>
<translation id="5521125884468363740">તમે જ્યાંથી Monyharનો ઉપયોગ કરો ત્યાંથી તમારી ટૅબ જોવા માટે, સાઇન ઇન કરો અને સિંક કરવાનું ચાલુ કરો</translation>
<translation id="5573014823074921752">Monyhar ટિપ. ટૅબના વધુ વિકલ્પો માટે, તમારી સ્ક્રીનના તળિયે અથવા ટોચે આવેલા ટૂલબારમાંના 'ટૅબ બતાવો' બટનને ટચ કરીને થોડીવાર દબાવી રાખો.</translation>
<translation id="5700709190537129682">Monyhar તમારા પાસવર્ડ ચેક કરી શકતું નથી</translation>
<translation id="5715349567881822785">Monyhar વડે વધુ કાર્યો કરો</translation>
<translation id="5742135483959137648">લિંક ખોલવા માટે Monyharનો ઉપયોગ કરો</translation>
<translation id="5777187867430702742">Monyhar પેજ</translation>
<translation id="5862307444128926510">Monyhar માં સ્વાગત છે</translation>
<translation id="5945387852661427312">તમે <ph name="DOMAIN" /> દ્વારા મેનેજ એકાઉન્ટમાં સાઇન ઇન કરી રહ્યાં છો અને તમારા Monyhar ડેટા પર એનું એડમિન નિયંત્રણ આપી રહ્યાં છો. તમારો ડેટા આ એકાઉન્ટ સાથે કાયમીરૂપે જોડાયેલું રહેશે. Monyharમાંથી સાઇન આઉટ કરવું આ ડિવાઇસ પરથી તમારો ડેટા ડિલીટ કરશે, પરંતુ એ તમારા Google એકાઉન્ટમાં સ્ટોર રહેશે.</translation>
<translation id="602807004951640891">Monyharનો ઉપયોગ કરીને, તમે તેની <ph name="BEGIN_LINK_TOS" />સેવાની શરતો<ph name="END_LINK_TOS" /> સાથે સંમત થાઓ છો.</translation>
<translation id="6119647025869519954">Monyharને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવવા માટે:
1. સેટિંગ ખોલો
2. ડિફૉલ્ટ બ્રાઉઝર ઍપ પર ટૅપ કરો
3. Monyhar પસંદ કરો.</translation>
<translation id="6155422572367400359">આ સાઇટમાં, તમારા Google એકાઉન્ટમાં અને Monyharમાં સાઇન ઇન કરો. તમે પછીથી તમારી સિંક કરવાની સુવિધા ચાલુ કરી શકો છો.</translation>
<translation id="6268381023930128611">Monyharમાંથી સાઇન આઉટ કરીએ?</translation>
<translation id="632825460376924298">Monyharમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="6337530241089703714">આ ડિવાઇસમાંથી તમારો Monyhar ડેટા સાફ કરવો છે કે તેને જાળવી રાખવો છે તે પસંદ કરો</translation>
<translation id="6424492062988593837">Chrome હવે વધારે સારું બન્યું છે! નવું વર્ઝન ઉપલબ્ધ છે.</translation>
<translation id="6820823224820483452">Monyhar બધા પાસવર્ડ ચેક કરી શક્યું નથી. આવતી કાલે ફરી પ્રયાસ કરો.</translation>
<translation id="6827294685447036764">જો તમે Monyharને તમારું સ્થાન જાણવાની મંજૂરી આપો, તો Monyhar તમે જે પણ સાઇટને મંજૂરી આપશો, તેને તેની માહિતી મોકલે છે. જ્યારે સાઇટ પાસે તમને બતાવવા માટે નજીકની દુકાનો અથવા સમાચાર જેવી કોઈ સ્થાનિક માહિતી હોય, ત્યારે સાઇટ તમારા સ્થાન માટે પૂછી શકે છે.</translation>
<translation id="7018284295775193585">Monyhar અપડેટ થઈ શકતું નથી</translation>
<translation id="7045244423563602563">Monyhar કસ્ટમાઇઝ કરો</translation>
<translation id="7099326575020694068">Monyhar, વિભાજિત દૃશ્ય મોડમાં તમારા કૅમેરાનો ઉપયોગ કરી શકતુંં નથી</translation>
<translation id="7118091470949186573">હવે તમે સંદેશા, દસ્તાવેજો અને અન્ય ઍપમાં લિંક પર કોઈપણ સમયે ટૅપ કરીને Monyharનો ઉપયોગ કરી શકશો.</translation>
<translation id="7208566199746267865">વેબ પર તમારા એકાઉન્ટ્સ લાવીને Monyhar તમારો સમય બચાવે છે. તમે સેટિંગ્સમાં એકાઉન્ટ્સ ઉમેરી અથવા દૂર કરી શકો છો.</translation>
<translation id="725427773388857052">ડેટા ઉલ્લંઘનો, અસુરક્ષિત વેબસાઇટ જેવી બીજી ઘણી બાબતોથી તમને સુરક્ષિત રાખવામાં Monyhar તમારી સહાય કરી શકે છે.</translation>
<translation id="7269362888766543920">કેટલાક એડ-ઓનને કારણે Monyhar ક્રૅશ થાય છે. કૃપા કરીને તેમને અનઇન્સ્ટૉલ કરવાનો પ્રયાસ કરો.</translation>
<translation id="7313655110045230863">Monyharને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવવા માટે, સેટિંગ ખોલો. ડિફૉલ્ટ બ્રાઉઝર ઍપ પર ટૅપ કરો અને પછી Monyharને પસંદ કરો.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7357211569052832586">પસંદ કરેલ ડેટા Monyhar અને સિંક કરેલ ડિવાઇસમાંથી દૂર કરવામાં આવ્યો છે. તમારા Google એકાઉન્ટમાં બ્રાઉઝિંગ ઇતિહાસના બીજા સ્વરૂપો જેમ કે શોધ અને history.google.com પરની બીજા Google સેવાઓમાંની પ્રવૃત્તિ હોય શકે છે.</translation>
<translation id="7400689562045506105">Monyhar નો ઉપયોગ સર્વત્ર કરો</translation>
<translation id="766897673682622022">ડેટા ઉલ્લંઘનમાં તમારો પાસવર્ડ જાહેર થઈ ગયો હતો. Monyhar હમણાં જ પાસવર્ડ બદલવાનો સુઝાવ આપે છે.</translation>
<translation id="7674213385180944843">સેટિંગ્સ &gt; ગોપનીયતા &gt; કૅમેરો &gt; Monyhar ખોલો અને કૅમેરો ચાલુ કરો.</translation>
<translation id="7746854981345936341">Monyhar ટિપ. પાછળ, ફૉર્વર્ડ અને શોધ જેવાં કેટલાક બટનો હવે તમારી સ્ક્રીનના તળિયે છે.</translation>
<translation id="7763454117143368771">જોખમકારક સાઇટથી સુરક્ષિત રહેવા અને તમારા પાસવર્ડ સલામત રાખવા માટે, તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે Monyharનો ઉપયોગ કરો</translation>
<translation id="786327964234957808">તમે <ph name="USER_EMAIL1" />થી <ph name="USER_EMAIL2" /> પર સિંક એકાઉન્ટને સ્વિચ કરી રહ્યાં છો. તમારો અસ્તિત્વમાંનો Monyhar ડેટા <ph name="DOMAIN" /> દ્વારા મેનેજ કરવામાં આવે છે. આ ડિવાઇસ પરથી આ તમારા ડેટાને ડિલીટ કરશે, પરંતુ તમારો ડેટા <ph name="USER_EMAIL1" /> માં રહેશે.</translation>
<translation id="7890287942691234100">Monyhar સ્કૅનરને ઉપયોગ કરવાનું શરૂ કરો</translation>
<translation id="7928628054454574139">કોઈપણ સમયે તમે અન્ય ઍપમાં લિંક પર ટૅપ કરો ત્યારે Monyhar ખૂલશે</translation>
<translation id="7931842119211730154">તમે Monyhar બંધ કરો, ત્યારે છૂપી ટૅબ લૉક કરો</translation>
<translation id="7980860476903281594">Monyhar તમે મંજૂરી આપો છો તે સાઇટ સાથે તમારા સ્થાનની માહિતી શેર કરે છે.</translation>
<translation id="8013573822802650211">તમે જ્યાંથી Monyharનો ઉપયોગ કરો ત્યાંથી તમારી ટૅબ જોવા માટે, તમારા બધાં ડિવાઇસ પર સાઇન ઇન કરો</translation>
<translation id="8073677936375100957">ડિવાઇસમાંથી તમારા Monyhar ડેટાને સાફ કરીએ?</translation>
<translation id="8175055321229419309">ટિપ: <ph name="BEGIN_LINK" />Monyhar ને તમારા ડૉક પર ખસેડો<ph name="END_LINK" /></translation>
<translation id="8240981428553046115">Monyhar અપડેટ ચેક કરી શક્યું નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="8586442755830160949">કોપિરાઇટ <ph name="YEAR" /> The Monyhar Authors. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="8663480472502753423">Monyhar અપ ટૂ ડેટ રાખો</translation>
<translation id="8776843108004031667">Monyharમાંથી આ એકાઉન્ટ અને સાચવવામાં ન આવ્યો હોય એવો કોઈપણ ડેટા કાઢી નાખવામાં આવશે.</translation>
<translation id="894437814105052438">તમે સાઇન આઉટ કરશો, ત્યારે Monyhar કોઈપણ નવા ડેટાને તમારા Google એકાઉન્ટ સાથે સિંક કરશે નહીં. અગાઉ સિંક કરેલો ડેટા એકાઉન્ટમાં રહે છે.</translation>
<translation id="9022552996538154597">Monyhar માં સાઇન ઇન કરો</translation>
<translation id="9089354809943900324">Monyhar જૂનું થઈ ગયું છે</translation>
<translation id="921174536258924340">Monyhar બધા પાસવર્ડ ચેક કરી શક્યું નથી. આવતી કાલે ફરી પ્રયાસ કરજો અથવા <ph name="BEGIN_LINK" />તમારા Google એકાઉન્ટમાં પાસવર્ડ ચેક કરો.<ph name="END_LINK" /></translation>
<translation id="985602178874221306">Monyhar લેખકો</translation>
</translationbundle>