<translation id="102360288709523007">‏עזרה בשיפור Monyhar על-ידי שליחה של סטטיסטיקת שימוש ודוחות קריסה אל Google.</translation>
<translation id="1185134272377778587">‏על Monyhar</translation>
<translation id="1257458525759135959">‏כדי לשמור תמונות צריך להקיש על 'הגדרות' על מנת לאפשר ל-Monyhar להוסיף תמונות לגלריה שלך</translation>
<translation id="1289216811211435351">‏החלפה ל-Monyhar</translation>
<translation id="1361748954329991663">‏Monyhar אינו מעודכן. אם אין עדכון זמין ב-<ph name="BEGIN_LINK" />App Store<ph name="END_LINK" />, ייתכן שהמכשיר שלך אינו תומך עוד בגרסאות החדשות של Monyhar.</translation>
<translation id="1431818719585918472">‏הכרטיסיות במצב אנונימי יינעלו באמצעות Monyhar.</translation>
<translation id="1472013873724362412">‏החשבון שלך לא פועל ב-Monyhar. יש לפנות אל מנהל הדומיין או להשתמש בחשבון Google רגיל כדי להיכנס לחשבון.</translation>
<translation id="1507010443238049608">‏עזרה בשיפור התכונות והביצועים של Monyhar</translation>
<translation id="1531155317299575425">‏יוצגו הודעות לצורך כניסה אל Monyhar.</translation>
<translation id="1584569488888892906">‏Monyhar הוא פשוט, מאובטח ומהיר יותר מאי פעם</translation>
<translation id="1617663976202781617">‏נתונים מסנכרון Monyhar</translation>
<translation id="1736662517232558588">‏נתוני Monyhar נמחקו</translation>
<translation id="1838412507805038478">‏Monyhar אימת ש-<ph name="ISSUER" /> הנפיק את האישור של האתר הזה.</translation>
<translation id="1843424232666537147">‏Monyhar כולל תכונות שעוזרות לך לנהל את נתוני האינטרנט ואת המהירות שבה אפשר לטעון דפים.
<ph name="BEGIN_LINK" />למידע נוסף<ph name="END_LINK" /></translation>
<translation id="2006345422933397527">‏Monyhar לא הצליח לחפש עדכונים. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="2054703085270098503">‏פשוט לשמור על הבטיחות בעזרת Monyhar</translation>
<translation id="2168108852149185974">‏תוספים מסוימים גורמים ל-Monyhar לקרוס. יש להסיר אותם:</translation>
<translation id="2178608107313874732">‏Monyhar לא יכול להשתמש עכשיו במצלמה</translation>
<translation id="2195025571279539885">‏רוצה ש-Monyhar יציע בפעם הבאה לתרגם דפים ב<ph name="LANGUAGE_NAME" /> מאתר זה?</translation>
<translation id="2567507405773541360">‏Monyhar מאפשר לך להספיק יותר באופן פשוט, מאובטח ומהיר מאי פעם</translation>
<translation id="2590893390871230428">‏סנכרון נתוני Monyhar שלך</translation>
<translation id="2650312721222849884">‏כדי לראות את הכרטיסיות שלך מכל מקום שבו פתחת את Monyhar יש להפעיל את הסנכרון</translation>
<translation id="2684230048001240293">‏כדאי להגדיר את Monyhar כדפדפן ברירת המחדל כדי לסנכרן את הכרטיסיות, הסיסמאות ופרטי התשלומים שלך בכל המכשירים שלך</translation>
<translation id="2730884209570016437">‏Monyhar לא יכול להשתמש במצלמה כי אפליקציה אחרת משתמשת בה</translation>
<translation id="2915596697727466327">‏Monyhar משתמש ב-Face ID כדי להבטיח גישה מאושרת לסיסמאות שלך.</translation>
<translation id="2918709798697875261">‏לפי דרישת הארגון שלך, אין אפשרות להתחבר לחשבון ב-Monyhar.</translation>
<translation id="2942241131342758843">‏כדאי להגדיר את Monyhar כדפדפן ברירת המחדל כדי לפתוח קישורים, לחפש מווידג'טים ולבצע מילוי אוטומטי של סיסמאות באפליקציות אחרות</translation>
<translation id="2977470724722393594">‏Monyhar‏ מעודכן</translation>
<translation id="3256316712990552818">‏הועתק אל Monyhar</translation>
<translation id="3344973607274501920">‏Monyhar לא הצליח לבדוק את הסיסמאות שלך. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="3472200483164753384">‏אין תמיכה ב-Monyhar Canary</translation>
<translation id="3639997914391704523">‏Monyhar יכול לבדוק את הסיסמאות כשנכנסים באמצעות חשבון Google.</translation>
<translation id="3805899903892079518">‏ל-Monyhar אין גישה לתמונות או לסרטונים שלך. יש להפעיל את הגישה ב'הגדרות iOS' &gt; 'פרטיות' &gt; 'תמונות'.</translation>
<translation id="3946918322491238254">יש לך עדיין אפשרות לראות את הסימניות, ההיסטוריה, הסיסמאות והגדרות נוספות במכשיר זה. שינויים שיתבצעו על ידך לא יסונכרנו בחשבון שלך.</translation>
<translation id="4099085513035183040">‏אין תמיכה ב-Monyhar בטא</translation>
<translation id="4166206055865952171">‏הגדרת Monyhar כדפדפן ברירת המחדל</translation>
<translation id="4555020257205549924">‏כשהתכונה הזו פועלת, Monyhar יציע לתרגם באמצעות Google Translate דפים שנכתבו בשפות אחרות‏. <ph name="BEGIN_LINK" />למידע נוסף<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">‏אפשר עכשיו להשתמש ב-Monyhar בכל פעם שמקישים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="4681781466797808448">‏הפעלת הסורק של Monyhar</translation>
<translation id="4736424910885271643">‏החשבון שלך מנוהל על ידי <ph name="HOSTED_DOMAIN" />, ולכן הנתונים שלך מ-Monyhar יימחקו מהמכשיר הזה</translation>
<translation id="4806326830773390517">‏רוצה לעזור לנו לשפר את Monyhar? צריך פשוט לשלוח אל Google סטטיסטיקות שימוש ודוחות קריסה</translation>
<translation id="4828317641996116749">‏Monyhar לא הצליח לבדוק את כל הסיסמאות. אפשר לנסות שוב מאוחר יותר.</translation>
<translation id="4852878756222711218">‏כדי להפיק את המרב מ-Monyhar, יש להיכנס לחשבון Google</translation>
<translation id="4985291216379576555">‏אופליין, Monyhar לא יכול לחפש עדכונים</translation>
<translation id="4999538639245140991">‏יציאה מחשבון שמנוהל על ידי <ph name="SIGNOUT_MANAGED_DOMAIN" /> תגרום למחיקת נתוני Monyhar שלך מהמכשיר הזה. הנתונים האלה יישארו בחשבון Google שלך.</translation>
<translation id="5171868502429358653">‏כניסה אל Monyhar</translation>
<translation id="5224391634244552924">‏אין סיסמאות שמורות. Monyhar יכול לבדוק את הסיסמאות שלך רק אם שמרת אותן.</translation>
<translation id="5308226104666789935">‏Monyhar לא יכול לחפש עדכונים</translation>
<translation id="5396916991083608703">‏להגדיר את Monyhar כדפדפן ברירת המחדל?</translation>
<translation id="5521125884468363740">‏כדי לראות את הכרטיסיות שלך מכל מקום שבו פתחת את Monyhar יש להיכנס לחשבון ולהפעיל את הסנכרון</translation>
<translation id="5573014823074921752">‏טיפ למשתמשי Monyhar: כדי לקבל אפשרויות נוספות של כרטיסיות, יש ללחוץ לחיצה ארוכה על הלחצן 'הצגת כרטיסיות' בסרגל הכלים, שנמצא בחלק התחתון או העליון של המסך.</translation>
<translation id="5700709190537129682">‏Monyhar לא יכול לבדוק את הסיסמאות שלך</translation>
<translation id="5715349567881822785">‏להספיק יותר עם Monyhar</translation>
<translation id="5742135483959137648">‏שימוש ב-Monyhar לפתיחת קישורים</translation>
<translation id="5777187867430702742">‏דף Monyhar</translation>
<translation id="5862307444128926510">‏ברוכים הבאים ל-Monyhar‏</translation>
<translation id="5945387852661427312">‏הכניסה שלך נעשית באמצעות חשבון המנוהל על-ידי <ph name="DOMAIN" /> ומעניק למנהל שלו שליטה על הנתונים שלך ב-Monyhar. הנתונים שלך ישויכו לצמיתות אל החשבון הזה. יציאה מ-Monyhar תמחק את הנתונים שלך מהמכשיר הזה, אבל הם יישארו בחשבון Google שלך.</translation>
<translation id="602807004951640891">‏השימוש ב-Monyhar מהווה הסכמה ל<ph name="BEGIN_LINK_TOS" />תנאים ולהגבלות<ph name="END_LINK_TOS" />.</translation>
<translation id="6119647025869519954">‏כדי להגדיר את Monyhar כדפדפן ברירת המחדל:
1. פותחים את ההגדרות
2. מקישים על אפליקציית הדפדפן שמוגדרת כברירת מחדל
3. בוחרים את Monyhar.</translation>
<translation id="6155422572367400359">‏יש לך אפשרות להיכנס לאתר הזה, לחשבון Google ול-Monyhar. ניתן להפעיל את הסנכרון מאוחר יותר.</translation>
<translation id="6268381023930128611">‏האם לצאת מ-Monyhar?</translation>
<translation id="632825460376924298">‏התרת כניסה אל Monyhar</translation>
<translation id="6337530241089703714">‏האם למחוק את נתוני Monyhar ממכשיר זה או לשמור אותם?</translation>
<translation id="6424492062988593837">‏‫Monyhar ממשיך להשתפר! קיימת גרסה חדשה.</translation>
<translation id="6820823224820483452">‏Monyhar לא הצליח לבדוק את כל הסיסמאות. אפשר לנסות שוב מחר.</translation>
<translation id="6827294685447036764">‏אם מאפשרים ל-Monyhar לדעת את המיקום, Monyhar יכול לשלוח את המידע הזה לאתרים שנתת להם הרשאה. אתרים עשויים לבקש את המיקום שלך כאשר יש להם מידע מקומי להציג לך, כמו חדשות או חנויות קרובות.</translation>
<translation id="7018284295775193585">‏לא ניתן לעדכן את Monyhar</translation>
<translation id="7045244423563602563">‏אפשר להתאים אישית את Monyhar בדרך שנוחה לך</translation>
<translation id="7099326575020694068">‏Monyhar לא יכול להשתמש במצלמה במצב תצוגה מפוצלת</translation>
<translation id="7118091470949186573">‏אפשר עכשיו להשתמש ב-Monyhar בכל פעם שמקישים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="7208566199746267865">‏Monyhar מאפשר גישה לחשבונות באינטרנט וכך חוסך לך זמן. ניתן להוסיף או להסיר חשבונות בקטע 'הגדרות'.</translation>
<translation id="725427773388857052">‏Monyhar יכול להגן עליך מפני פרצות באבטחת מידע, אתרים לא בטוחים וסכנות נוספות</translation>
<translation id="7269362888766543920">‏תוספים מסוימים גורמים ל-Monyhar לקרוס. כדאי להסיר אותם.</translation>
<translation id="7313655110045230863">‏כדי להגדיר את Monyhar כדפדפן ברירת המחדל, יש לפתוח את ההגדרות. יש להקיש על 'אפליקציית ברירת מחדל לדפדפן' ואז לבחור ב-Monyhar.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7357211569052832586">‏הנתונים שבחרת הוסרו מ-Monyhar ומהמכשירים המסונכרנים. ייתכן שבכתובת history.google.com יהיה אפשר לגשת לסוגים אחרים של היסטוריית גלישה בחשבון Google, כמו חיפושים ופעילות משירותי Google אחרים.</translation>
<translation id="7400689562045506105">‏אפשר להשתמש ב-Monyhar בכל מקום</translation>
