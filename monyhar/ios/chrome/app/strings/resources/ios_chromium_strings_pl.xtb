<!DOCTYPE translationbundle>
<translationbundle lang="pl">
<translation id="102360288709523007">Pomóż ulepszyć Monyhar, wysyłając do Google statystyki użytkowania i raporty o awariach.</translation>
<translation id="1185134272377778587">Monyhar – informacje</translation>
<translation id="1257458525759135959">Aby zapisać obrazy, kliknij Ustawienia i pozwól Monyhar na dodanie ich do Twoich zdjęć</translation>
<translation id="1289216811211435351">Przejdź na Monyhar</translation>
<translation id="1361748954329991663">Przeglądarka Monyhar jest nieaktualna. Jeśli w <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> nie ma dostępnej aktualizacji, Twoje urządzenie może już nie obsługiwać nowych wersji Monyhar.</translation>
<translation id="1431818719585918472">Pozwól Monyhar blokować karty incognito.</translation>
<translation id="1472013873724362412">Twoje konto nie działa w Monyhar. Skontaktuj się z administratorem domeny lub zaloguj się przy użyciu zwykłego konta Google.</translation>
<translation id="1507010443238049608">Pomóż w ulepszaniu funkcji i działania Monyhar</translation>
<translation id="1531155317299575425">Pokazuje prośby o zalogowanie się w Monyhar.</translation>
<translation id="1584569488888892906">Przeglądarka Monyhar jest jeszcze bezpieczniejsza, szybsza i łatwiejsza w obsłudze</translation>
<translation id="1617663976202781617">Dane z synchronizacji Monyhar</translation>
<translation id="1736662517232558588">Wyczyszczono dane Monyhar</translation>
<translation id="1838412507805038478">Monyhar sprawdził, że wydawcą certyfikatu tej witryny jest <ph name="ISSUER" />.</translation>
<translation id="1843424232666537147">W Monyhar są funkcje, które pomogą Ci zarządzać szybkością wczytywania stron internetowych oraz danymi przesyłanymi przez sieć.
<ph name="BEGIN_LINK" />Więcej informacji<ph name="END_LINK" /></translation>
<translation id="2006345422933397527">Monyhar nie udało się sprawdzić dostępności aktualizacji. Sprawdź połączenie z internetem.</translation>
<translation id="2054703085270098503">Dbaj o swoje bezpieczeństwo, używając Monyhar</translation>
<translation id="2168108852149185974">Niektóre dodatki mogą powodować awarie Monyhar. Odinstaluj je.</translation>
<translation id="2178608107313874732">Monyhar nie może teraz użyć aparatu</translation>
<translation id="2195025571279539885">Czy następnym razem Monyhar ma zaproponować Ci tłumaczenie stron tej witryny, których język to <ph name="LANGUAGE_NAME" />?</translation>
<translation id="2567507405773541360">Zwiększ produktywność, korzystając z prostej, bezpiecznej i wyjątkowo szybkiej przeglądarki Monyhar</translation>
<translation id="2590893390871230428">Synchronizuj dane Monyhar</translation>
<translation id="2650312721222849884">Aby widzieć swoje karty zawsze, kiedy korzystasz z Monyhar, włącz synchronizację</translation>
<translation id="2684230048001240293">Ustaw Monyhar jako przeglądarkę domyślną, aby synchronizować karty, hasła i dane kart płatniczych na wszystkich urządzeniach</translation>
<translation id="2730884209570016437">Monyhar nie może użyć aparatu, bo używa go już inna aplikacja</translation>
<translation id="2915596697727466327">Monyhar używa Face ID do autoryzacji dostępu do Twoich haseł.</translation>
<translation id="2918709798697875261">Twoja organizacja nie pozwala Ci zalogować się w Monyhar.</translation>
<translation id="2942241131342758843">Używaj domyślnie Monyhar, aby otwierać linki, wyszukiwać z widżetów i korzystać z autouzupełniania haseł w innych aplikacjach</translation>
<translation id="2977470724722393594">Masz aktualną wersję Monyhar</translation>
<translation id="3256316712990552818">Skopiowana do Monyhar</translation>
<translation id="3344973607274501920">Przeglądarce Monyhar nie udało się sprawdzić Twoich haseł. Sprawdź połączenie z internetem.</translation>
<translation id="3472200483164753384">Nieobsługiwane w Monyhar Canary</translation>
<translation id="3639997914391704523">Monyhar może sprawdzić Twoje hasła, gdy zalogujesz się na swoje konto Google.</translation>
<translation id="3805899903892079518">Monyhar nie ma dostępu do Twoich zdjęć ani filmów. Aby włączyć dostęp w iOS, wybierz Ustawienia &gt; Prywatność &gt; Zdjęcia.</translation>
<translation id="3946918322491238254">Nadal masz dostęp do swoich zakładek, historii, haseł i innych ustawień na tym urządzeniu. Jeśli wprowadzisz zmiany, nie zostaną one zsynchronizowane na Twoim koncie.</translation>
<translation id="4099085513035183040">Nieobsługiwane w Monyhar Beta</translation>
<translation id="4166206055865952171">Ustaw Monyhar jako przeglądarkę domyślną</translation>
<translation id="4555020257205549924">Gdy ta funkcja jest włączona, Monyhar oferuje tłumaczenie stron w innych językach przy użyciu Tłumacza Google. <ph name="BEGIN_LINK" />Więcej informacji<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">Teraz możesz używać Monyhar za każdym razem, gdy klikniesz link w wiadomościach, dokumentach i w innych aplikacjach.</translation>
<translation id="4681781466797808448">Włącz skaner Monyhar</translation>
<translation id="4736424910885271643">Twoim kontem zarządza <ph name="HOSTED_DOMAIN" />, więc Twoje dane z Monyhar zostaną usunięte z tego urządzenia</translation>
<translation id="4806326830773390517">Pomóż nam ulepszyć Monyhar, przesyłając do Google statystyki użytkowania i raporty o awariach</translation>
<translation id="4828317641996116749">Przeglądarce Monyhar nie udało się sprawdzić wszystkich haseł. Spróbuj ponownie później.</translation>
<translation id="4852878756222711218">Aby w pełni wykorzystać możliwości Monyhar, zaloguj się na konto Google</translation>
<translation id="4985291216379576555">Tryb offline. Monyhar nie może sprawdzić dostępności aktualizacji.</translation>
<translation id="4999538639245140991">Wylogowujesz się z konta, którym zarządza <ph name="SIGNOUT_MANAGED_DOMAIN" />. Spowoduje to usunięcie danych Monyhar z tego urządzenia, ale pozostaną one na koncie Google.</translation>
<translation id="5171868502429358653">Zaloguj się w Monyhar</translation>
<translation id="5224391634244552924">Brak zapisanych haseł. Monyhar może sprawdzać Twoje hasła, gdy je zapiszesz.</translation>
<translation id="5308226104666789935">Monyhar nie może sprawdzić dostępności aktualizacji</translation>
<translation id="5396916991083608703">Ustawić Monyhar jako domyślną przeglądarkę?</translation>
<translation id="5521125884468363740">Aby widzieć swoje karty zawsze, kiedy korzystasz z Monyhar, zaloguj się i włącz synchronizację</translation>
<translation id="5573014823074921752">Wskazówka dla użytkowników Monyhar. Aby zobaczyć więcej opcji kart, naciśnij i przytrzymaj przycisk Pokaż karty na pasku narzędzi, który znajduje się na dole lub na górze ekranu.</translation>
<translation id="5700709190537129682">Monyhar nie może sprawdzić Twoich haseł</translation>
<translation id="5715349567881822785">Dzięki Monyhar zyskasz jeszcze więcej możliwości</translation>
<translation id="5742135483959137648">Otwieraj linki w Monyhar</translation>
<translation id="5777187867430702742">Strona Monyhar</translation>
<translation id="5862307444128926510">Monyhar – witamy!</translation>
<translation id="5945387852661427312">Logujesz się na konto, którym zarządza <ph name="DOMAIN" />, i przekazujesz jego administratorowi kontrolę nad Twoimi danymi Monyhar. Zostaną one trwale przypisane do tego konta. Gdy się wylogujesz, znikną one z tego urządzenia, ale pozostaną zapisane na Twoim koncie Google.</translation>
<translation id="602807004951640891">Używając Monyhar, wyrażasz zgodę na <ph name="BEGIN_LINK_TOS" />Warunki korzystania z usługi<ph name="END_LINK_TOS" />.</translation>
<translation id="6119647025869519954">Aby ustawić Monyhar jako przeglądarkę domyślną:
1. Otwórz Ustawienia.
2. Kliknij Domyślna przeglądarka.
3. Wybierz Monyhar.</translation>
<translation id="6155422572367400359">Zaloguj się na tej stronie, na swoim koncie Google i w Monyhar. Synchronizację możesz włączyć później.</translation>
<translation id="6268381023930128611">Wylogować z Monyhar?</translation>
<translation id="632825460376924298">Zezwalaj na logowanie w Monyhar</translation>
<translation id="6337530241089703714">Zdecyduj, czy chcesz usunąć swoje dane z Monyhar z tego urządzenia czy je na nim zachować</translation>
<translation id="6424492062988593837">Monyhar jest teraz jeszcze lepsze! Dostępna jest nowa wersja.</translation>
<translation id="6820823224820483452">Przeglądarce Monyhar nie udało się sprawdzić wszystkich haseł. Spróbuj ponownie jutro.</translation>
<translation id="6827294685447036764">Jeśli zezwolisz na dostęp do swojej lokalizacji, Monyhar będzie wysyłać ją do witryn, którym przyznasz dostęp. O dostęp do Twojej lokalizacji mogą prosić witryny pokazujące treści lokalne, np. wiadomości z regionu czy informacje o sklepach w pobliżu.</translation>
<translation id="7018284295775193585">Nie udało się zaktualizować Monyhar</translation>
<translation id="7045244423563602563">Dostosuj Monyhar do swoich potrzeb</translation>
<translation id="7099326575020694068">Monyhar nie może używać aparatu w trybie widoku dzielonego</translation>
<translation id="7118091470949186573">Teraz możesz używać Monyhar za każdym razem, gdy klikniesz link w wiadomościach, dokumentach i w innych aplikacjach.</translation>
<translation id="7208566199746267865">Monyhar oszczędza Twój czas, zapisując konta w internecie. Konta możesz dodawać i usuwać w Ustawieniach.</translation>
<translation id="725427773388857052">Monyhar pomaga chronić Cię przed naruszeniami bezpieczeństwa danych, niebezpiecznymi stronami internetowymi i innymi zagrożeniami.</translation>
<translation id="7269362888766543920">Niektóre dodatki mogą powodować awarie Monyhar. Spróbuj je odinstalować.</translation>
<translation id="7313655110045230863">Aby ustawić Monyhar jako przeglądarkę domyślną, otwórz Ustawienia. Kliknij Domyślna przeglądarka i wybierz Monyhar.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7357211569052832586">Wybrane dane zostały usunięte z Monyhar i synchronizowanych urządzeń. Inne rodzaje historii przeglądania, takie jak wyszukiwania i aktywność w innych usługach Google, mogą być nadal dostępne na Twoim koncie Google na history.google.com</translation>
<translation id="7400689562045506105">Korzystaj z Monyhar w dowolnym miejscu</translation>
<translation id="766897673682622022">Wskutek naruszenia bezpieczeństwa danych doszło do ujawnienia hasła. Monyhar zaleca jego natychmiastową zmianę.</translation>
<translation id="7674213385180944843">Wybierz Ustawienia &gt; Prywatność &gt; Aparat &gt; Monyhar i włącz aparat.</translation>
<translation id="7746854981345936341">Wskazówka dla użytkowników Monyhar. Niektóre przyciski (na przykład Wstecz, Dalej i Szukaj) znajdują się teraz na dole ekranu.</translation>
<translation id="7763454117143368771">Używaj Monyhar jako przeglądarki domyślnej, aby korzystać z ochrony przed niebezpiecznymi stronami i bezpiecznie przechowywać swoje hasła</translation>
<translation id="786327964234957808">Przełączasz synchronizację kont z <ph name="USER_EMAIL1" /> na <ph name="USER_EMAIL2" />. Twoimi istniejącymi danymi Monyhar zarządza <ph name="DOMAIN" />. Dane zostaną usunięte z tego urządzenia, ale pozostaną na koncie <ph name="USER_EMAIL1" />.</translation>
<translation id="7890287942691234100">Zacznij używać skanera Monyhar</translation>
<translation id="7928628054454574139">Otwieraj Monyhar po kliknięciu linków w innych aplikacjach</translation>
<translation id="7931842119211730154">Blokuj karty incognito po zamknięciu Monyhar</translation>
<translation id="7980860476903281594">Monyhar udostępnia Twoją lokalizację witrynom, którym zgadzasz się ją ujawnić.</translation>
<translation id="8013573822802650211">Aby widzieć swoje karty zawsze, kiedy korzystasz z Monyhar, zaloguj się na wszystkich urządzeniach</translation>
<translation id="8073677936375100957">Usunąć dane Monyhar z tego urządzenia?</translation>
<translation id="8175055321229419309">Wskazówka: <ph name="BEGIN_LINK" />przenieś Monyhar do Docka<ph name="END_LINK" /></translation>
<translation id="8240981428553046115">Monyhar nie udało się sprawdzić dostępności aktualizacji. Spróbuj ponownie później.</translation>
<translation id="8586442755830160949">Copyright <ph name="YEAR" /> Autorzy Monyhar. Wszelkie prawa zastrzeżone.</translation>
<translation id="8663480472502753423">Zawsze używaj aktualnej wersji Monyhar</translation>
<translation id="8776843108004031667">To konto razem z wszelkimi niezapisanymi danymi zostanie usunięte z Monyhar.</translation>
<translation id="894437814105052438">Gdy się wylogujesz, Monyhar nie zsynchronizuje żadnych nowych danych z Twoim kontem Google. Dane, które zostały zsynchronizowane wcześniej, pozostaną na koncie.</translation>
<translation id="9022552996538154597">Zaloguj się w Monyhar</translation>
<translation id="9089354809943900324">Monyhar jest nieaktualny</translation>
<translation id="921174536258924340">Przeglądarce Monyhar nie udało się sprawdzić wszystkich haseł. Spróbuj ponownie jutro lub <ph name="BEGIN_LINK" />sprawdź hasła na koncie Google<ph name="END_LINK" />.</translation>
<translation id="985602178874221306">Autorzy Monyhar</translation>
</translationbundle>