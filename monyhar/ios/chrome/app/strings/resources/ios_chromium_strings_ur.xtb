<translation id="8240981428553046115">‏Monyhar اپ ڈیٹس چیک نہیں کر سکا۔ بعد میں دوبارہ کوشش کریں۔</translation>
<translation id="8586442755830160949">‏کاپی رائٹ ‎<ph name="YEAR" /> The Monyhar Authors۔ جملہ حقوق محفوظ۔</translation>
<translation id="8663480472502753423">‏Monyhar کو اپ ٹو ڈیٹ رکھیں</translation>
<translation id="8776843108004031667">‏اس اکاؤنٹ اور کسی بھی غیر محفوظ ڈیٹا کو Monyhar سے ہٹا دیا جائے گا۔</translation>
<translation id="894437814105052438">‏آپ کے سائن آؤٹ کرنے پر، Monyhar کوئی بھی نیا ڈیٹا آپ کے Google اکاؤنٹ کے ساتھ سِنک نہیں کرے گا۔ پہلے کا سِنک کردہ ڈیٹا اکاؤنٹ میں باقی رہے گا۔</translation>
<translation id="9022552996538154597">‏Monyhar میں سائن ان کریں</translation>
<translation id="9089354809943900324">‏Monyhar پرانا ہے</translation>
<translation id="921174536258924340">‏Monyhar سبھی پاس ورڈز چیک نہیں کر سکا۔ آئندہ کل دوبارہ کوشش کریں یا <ph name="BEGIN_LINK" />اپنے Google اکاؤنٹ میں پاس ورڈز چیک کریں۔<ph name="END_LINK" /></translation>
<translation id="985602178874221306">‏Monyhar مصنّفین</translation>
