<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="102360288709523007">‏‫با ارسال آمار کاربرد و گزارش‌های خرابی به Google، به بهبود Monyhar کمک کنید.</translation>
<translation id="1185134272377778587">‏درباره Monyhar</translation>
<translation id="1257458525759135959">‏برای ذخیره کردن تصاویر، روی «تنظیمات» ضربه بزنید و به Monyhar اجازه دهید آن‌ها را به عکس‌ها اضافه کند</translation>
<translation id="1289216811211435351">‏رفتن به Monyhar</translation>
<translation id="1361748954329991663">‏نسخه Monyhar قدیمی است. اگر به‌روزرسانی‌ای در <ph name="BEGIN_LINK" />فروشگاه برنامه<ph name="END_LINK" /> دردسترس نیست، احتمالاً دستگاهتان نسخه‌های جدید Monyhar را دیگر پشتیبانی نمی‌کند.</translation>
<translation id="1431818719585918472">‏اجازه دهید Monyhar «برگه‌های ناشناس» را قفل کند.</translation>
<translation id="1472013873724362412">‏حساب شما در Monyhar کار نمی‌کند. لطفاً با سرپرست دامنه‌تان تماس بگیرید یا از یک حساب Google معمولی برای ثبت ورود استفاده کنید.</translation>
<translation id="1507010443238049608">‏کمک به بهبود ویژگی‌ها و عملکرد Monyhar</translation>
<translation id="1531155317299575425">‏برای ورود به سیستم Monyhar درخواست نشان می‌دهد.</translation>
<translation id="1584569488888892906">‏Monyhar ساده، ایمن، و سریع‌تر از همیشه است</translation>
<translation id="1617663976202781617">‏داده‌های مربوط به همگام‌سازی Monyhar</translation>
<translation id="1736662517232558588">‏داده‌های Monyhar پاک شد</translation>
<translation id="1838412507805038478">‏Monyhar تأیید کرد که <ph name="ISSUER" /> گواهینامه این وب‌سایت را صادر کرده است.</translation>
<translation id="1843424232666537147">‏Monyhar دارای قابلیت‌هایی است که به شما کمک می‌کند داده‌های اینترنت و سرعت بارگیری صفحه‌های‌ وبتان را مدیریت کنید.
<ph name="BEGIN_LINK" />بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="2006345422933397527">‏Monyhar موفق نشد به‌روزرسانی‌ها را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="2054703085270098503">‏با Monyhar ایمن بمانید</translation>
<translation id="2168108852149185974">‏برخی از افزونه‌ها باعث خرابی Monyhar می‌شود. لطفاً آن‌ها را حذف نصب کنید:</translation>
<translation id="2178608107313874732">‏Monyhar اکنون نمی‌تواند از دوربین استفاده کند</translation>
<translation id="2195025571279539885">‏می‌خواهید دفعه دیگر Monyhar پیشنهاد ترجمه صفحات <ph name="LANGUAGE_NAME" /> را از این سایت بدهد؟</translation>
<translation id="2567507405773541360">‏با Monyhar که ساده، امن، و سریع‌تر از همیشه است، کارهای بیشتری انجام دهید</translation>
<translation id="2590893390871230428">‏همگام‌سازی داده‌های Monyhar</translation>
<translation id="2650312721222849884">‏در همه دستگاه‌هایی که در آن‌ها از Monyhar استفاده می‌کنید، همگام‌سازی را روشن کنید تا بتوانید برگه‌هایتان را ببینید</translation>
<translation id="2684230048001240293">‏برای همگام‌سازی برگه‌ها، گذرواژه‌ها، و اطلاعات پرداخت در همه دستگاه‌ها، Monyhar را به‌عنوان پیش‌فرض تنظیم کنید</translation>
<translation id="2730884209570016437">‏Monyhar نمی‌تواند از دوربین استفاده کند زیرا برنامه دیگری از آن استفاده می‌کند</translation>
<translation id="2915596697727466327">‏Monyhar برای اطمینان از دسترسی مجاز به گذرواژه‌هایتان، از «شناسه تشخیص چهره» استفاده می‌کند.</translation>
<translation id="2918709798697875261">‏سازمانتان از شما می‌خواهد خارج از سیستم Monyhar باقی بمانید.</translation>
<translation id="2942241131342758843">‏برای باز کردن پیوندها، جستجوی ابزارک‌ها، و تکمیل خودکار گذرواژه‌ها در دیگر برنامه‌ها، به‌طور پیش‌فرض از Monyhar استفاده کنید</translation>
<translation id="2977470724722393594">‏Monyhar به‌روز است</translation>
<translation id="3256316712990552818">‏به Monyhar کپی شد</translation>
<translation id="3344973607274501920">‏Monyhar نمی‌تواند گذرواژه‌هایتان را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="3472200483164753384">‏در Monyhar Canary پشتیبانی نمی‌شود</translation>
<translation id="3639997914391704523">‏Monyhar زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که با «حساب Google» خود به سیستم وارد شوید.</translation>
<translation id="3805899903892079518">‏Monyhar به عکس‌ها یا ویدیوهای شما دسترسی ندارد. با رفتن به تنظیمات iOS &gt; حریم‌خصوصی &gt; عکس‌ها دسترسی را فعال کنید.</translation>
<translation id="3946918322491238254">همچنان می‌توانید همه نشانک‌ها، سابقه، گذرواژه‌ها، و دیگر تنظیماتتان را در این دستگاه ببینید. اگر تغییری ایجاد کنید، با حسابتان همگام‌سازی نخواهد شد.</translation>
<translation id="4099085513035183040">‏در «Monyhar بتا» پشتیبانی نمی‌شود</translation>
<translation id="4166206055865952171">‏Monyhar را مرورگر پیش‌فرض کنید</translation>
<translation id="4555020257205549924">‏وقتی این قابلیت روشن است، Monyhar ترجمه صفحات نوشته‌شده به سایر زبان‌ها را با استفاده از ترجمه Google پیشنهاد می‌دهد. <ph name="BEGIN_LINK" />بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">‏اکنون می‌توانید با ضربه زدن روی پیوندهای موجود در پیام‌ها، اسناد، و دیگر برنامه‌ها، از Monyhar استفاده کنید.</translation>
<translation id="4681781466797808448">‏روشن کردن اسکنر Monyhar</translation>
<translation id="4736424910885271643">‏<ph name="HOSTED_DOMAIN" /> حسابتان را مدیریت می‌کند، درنتیجه داده‌های Monyhar شما از این دستگاه پاک خواهد شد</translation>
<translation id="4806326830773390517">‏با ارسال آمار کاربرد و گزارش‌های خرابی برای Google، به بهبود Monyhar کمک کنید</translation>
<translation id="4828317641996116749">‏Monyhar نتوانست همه گذرواژه‌ها را بررسی کند. بعداً دوباره امتحان کنید.</translation>
<translation id="4852878756222711218">‏برای استفاده بهتر از Monyhar، با «حساب Google» خودتان به سیستم وارد شوید</translation>
<translation id="4985291216379576555">‏آفلاین هستید، Monyhar نمی‌تواند به‌روزرسانی‌ها را بررسی کند</translation>
<translation id="4999538639245140991">‏ازآنجایی‌که درحال خارج شدن از حسابی هستید که <ph name="SIGNOUT_MANAGED_DOMAIN" /> آن را مدیریت می‌کند، داده‌های Monyhar شما از این دستگاه حذف خواهد شد. داده‌هایتان در حساب Google شما باقی می‌ماند.</translation>
<translation id="5171868502429358653">‏ورود به سیستم Monyhar</translation>
<translation id="5224391634244552924">‏گذرواژه ذخیره‌شده‌ای وجود ندارد. Monyhar زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید.</translation>
<translation id="5308226104666789935">‏Monyhar نمی‌تواند به‌روزرسانی‌ها را بررسی کند</translation>
<translation id="5396916991083608703">‏Monyhar به‌عنوان پیش‌فرض تنظیم شود؟</translation>
<translation id="5521125884468363740">‏در همه دستگاه‌هایی که در آن‌ها از Monyhar استفاده می‌کنید، به سیستم وارد شوید و همگام‌سازی را روشن کنید تا بتوانید برگه‌هایتان را ببینید</translation>
<translation id="5573014823074921752">‏نکته Monyhar. برای دیدن گزینه‌های بیشتر برگه، دکمه «نمایش برگه‌ها» را در نوارابزار (واقع در پایین یا بالای صفحه) لمس کنید و نگه دارید.</translation>
<translation id="5700709190537129682">‏Monyhar نمی‌تواند گذرواژه‌هایتان را بررسی کند</translation>
<translation id="5715349567881822785">‏با Monyhar کارهای بیشتری انجام دهید</translation>
<translation id="5742135483959137648">‏استفاده از Monyhar برای باز کردن پیوندها</translation>
<translation id="5777187867430702742">‏صفحه Monyhar</translation>
<translation id="5862307444128926510">‏به Monyhar خوش آمدید</translation>
<translation id="5945387852661427312">‏هم‌اکنون درحال ورود به سیستم با حسابی مدیریت‌شده توسط <ph name="DOMAIN" /> و دادن کنترل داده‌های Monyhar خود به سرپرست این حساب هستید. داده‌هایتان به‌طور دائم به این حساب مرتبط می‌شوند. با خروج از Chrome، داده‌هایتان از این دستگاه حذف می‌شوند اما همچنان در حساب Google شما باقی می‌ماند.</translation>
<translation id="602807004951640891">‏بااستفاده از Monyhar، موافقت خود را با <ph name="BEGIN_LINK_TOS" />شرایط خدمات<ph name="END_LINK_TOS" /> اعلام می‌کنید.</translation>
<translation id="6119647025869519954">‏برای تنظیم Monyhar به‌عنوان مرورگر پیش‌فرض:
۱. «تنظیمات» را باز کنید
۲. روی «برنامه مرورگر پیش‌فرض» ضربه بزنید
۳. Monyhar را انتخاب کنید.</translation>
<translation id="6155422572367400359">‏به سیستم این سایت، «حساب Google» خودتان، و Monyhar وارد شوید. می‌توانید بعداً همگام‌سازی را روشن کنید.</translation>
<translation id="6268381023930128611">‏از Monyhar خارج می‌شوید؟</translation>
<translation id="632825460376924298">‏مجاز کردن ورود به سیستم Monyhar</translation>
<translation id="6337530241089703714">‏انتخاب کنید داده‌های Monyhar شما از این دستگاه پاک شود یا نگه داشته شود</translation>
<translation id="6424492062988593837">‏Monyhar بهتر شده است! نسخه جدید آن در دسترس است.</translation>
<translation id="6820823224820483452">‏Monyhar نمی‌تواند همه گذرواژه‌هایتان را بررسی کند. فردا دوباره امتحان کنید.</translation>
<translation id="6827294685447036764">‏اگر به Monyhar اجازه دهید به مکانتان دسترسی داشته باشد، آن را برای هر سایتی که شما مجاز بدانید ارسال خواهد کرد. وقتی سایت‌ها اطلاعاتی محلی (مثل اخبار یا فروشگاه‌های اطراف) برای نمایش به شما داشته باشند، ممکن است برای دسترسی به مکانتان درخواست دهند.</translation>
<translation id="7018284295775193585">‏Monyhar به‌روزرسانی نمی‌شود</translation>
<translation id="7045244423563602563">‏Monyhar را برای خود اختصاصی کنید</translation>
<translation id="7099326575020694068">‏Monyhar نمی‌تواند از دوربین درحالت «نمای تقسیم» استفاده کند</translation>
<translation id="7118091470949186573">‏اکنون می‌توانید با ضربه زدن روی پیوندهای موجود در پیام‌ها، اسناد و دیگر برنامه‌ها، از Monyhar استفاده کنید.</translation>
<translation id="7208566199746267865">‏Monyhar با آوردن حساب‌هایتان به وب، در وقت شما صرفه‌جویی می‌کند. در «تنظیمات» می‌توانید حساب‌ها را اضافه یا حذف کنید.</translation>
<translation id="725427773388857052">‏Monyhar می‌تواند به محافظت از شما دربرابر نقض داده، وب‌سایت‌های ناامن، و موارد دیگر کمک کند.</translation>
<translation id="7269362888766543920">‏برخی از افزونه‌ها باعث خرابی Monyhar می‌شوند. لطفاً آن‌ها را حذف نصب کنید.</translation>
<translation id="7313655110045230863">‏برای تنظیم کردن Monyhar به‌عنوان مرورگر پیش‌فرض، «تنظیمات» را باز کنید. روی «برنامه مرورگر پیش‌فرض» ضربه بزنید، سپس Monyhar را انتخاب کنید.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7357211569052832586">‏داده‌های انتخاب‌‌شده از Monyhar و دستگاه‌های همگام‌سازی‌شده حذف شده‌اند. ممکن است اشکال دیگری از سابقه مرورتان (مانند جستجو‌ها و فعالیت دیگر سرویس‌های Google در history.google.com) در حساب Google شما وجود داشته باشد.</translation>
<translation id="7400689562045506105">‏استفاده از Monyhar در همه‌جا</translation>
<translation id="766897673682622022">‏گذرواژه‌تان به‌دلیل نقض داده لو رفته است. Monyhar توصیه می‌کند همین‌حالا گذرواژه را تغییر دهید.</translation>
<translation id="7674213385180944843">‏Settings (تنظیمات) &gt; Privacy (حریم‌خصوصی) &gt; Camera (دوربین) &gt; Monyhar را باز کنید و دوربین را روشن کنید.</translation>
<translation id="7746854981345936341">‏نکته Monyhar. بعضی از دکمه‌ها مثل Back (برگشت)، Forward (به جلو) و Search (جستجو) اکنون در پایین صفحه هستند.</translation>
<translation id="7763454117143368771">‏از Monyhar به‌عنوان مرورگر پیش‌فرض استفاده کنید تا دربرابر سایت‌های خطرناک از شما محافظت شود و امنیت گذرواژه‌هایتان حفظ شود</translation>
<translation id="786327964234957808">‏هم‌اکنون درحال تغییر حساب‌های همگام‌سازی از <ph name="USER_EMAIL1" /> به <ph name="USER_EMAIL2" /> هستید. داده‌های موجود Monyhar شما توسط <ph name="DOMAIN" /> مدیریت می‌شوند. با این کار، داده‌هایتان از این دستگاه حذف می‌شود اما همچنان در <ph name="USER_EMAIL1" /> باقی می‌ماند.</translation>
<translation id="7890287942691234100">‏شروع استفاده از اسکنر Monyhar</translation>
<translation id="7928628054454574139">‏هرزمان در برنامه‌های دیگر روی پیوندها ضربه بزنید، Monyhar باز می‌شود</translation>
<translation id="7931842119211730154">‏قفل کردن «برگه‌های ناشناس» وقتی Monyhar را می‌بندید</translation>
<translation id="7980860476903281594">‏Monyhar مکانتان را با سایت‌هایی که مجاز کرده‌اید هم‌رسانی می‌کند.</translation>
<translation id="8013573822802650211">‏در همه دستگاه‌هایی که در آن‌ها از Monyhar استفاده می‌کنید، به سیستم وارد شوید تا بتوانید برگه‌هایتان را ببینید</translation>
<translation id="8073677936375100957">‏داده‌های Monyhar شما از این دستگاه پاک شود؟</translation>
<translation id="8175055321229419309">‏نکته: <ph name="BEGIN_LINK" />Monyhar را به لنگرگاهتان انتقال دهید<ph name="END_LINK" /></translation>
<translation id="8240981428553046115">‏Monyhar موفق نشد به‌روزرسانی‌ها را بررسی کند. بعداً دوباره امتحان کنید.</translation>
<translation id="8586442755830160949">‏حق نشر <ph name="YEAR" /> نویسندگان Monyhar. کلیه حقوق محفوظ است.</translation>
<translation id="8663480472502753423">‏به‌روز نگه داشتن Monyhar</translation>
<translation id="8776843108004031667">‏این حساب و همه داده‌های ذخیره‌نشده از Monyhar برداشته می‌شود.</translation>
<translation id="894437814105052438">‏وقتی از سیستم خارج شوید، Monyhar هیچ‌کدام از داده‌های جدید را با «حساب Google» شما همگام‌سازی نخواهد کرد. داده‌هایی که قبلاً همگام‌سازی شده‌اند در حساب می‌مانند.</translation>
<translation id="9022552996538154597">‏ورود به سیستم Monyhar</translation>
<translation id="9089354809943900324">‏نسخه Monyhar قدیمی است</translation>
<translation id="921174536258924340">‏Monyhar نمی‌تواند همه گذرواژه‌هایتان را بررسی کند. فردا دوباره امتحان کنید یا <ph name="BEGIN_LINK" />گذرواژه‌ها را در «حساب Google» خود بررسی کنید<ph name="END_LINK" />.</translation>
<translation id="985602178874221306">Monyhar Authors</translation>
</translationbundle>