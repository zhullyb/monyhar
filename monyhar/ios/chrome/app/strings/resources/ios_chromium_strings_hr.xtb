<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="102360288709523007">Pomognite nam da poboljšamo Monyhar slanjem statistike o upotrebi i izvješća o padu programa Googleu.</translation>
<translation id="1185134272377778587">O pregledniku Monyhar</translation>
<translation id="1257458525759135959">Da bi se slike spremale, dodirnite Postavke kako biste dopustili Monyharu da dodaje vašim fotografijama</translation>
<translation id="1289216811211435351">Prelazak na Monyhar</translation>
<translation id="1361748954329991663">Monyhar je zastario. Ako u <ph name="BEGIN_LINK" />trgovini aplikacija<ph name="END_LINK" /> nema dostupnih ažuriranja, postoji mogućnost da vaš uređaj više ne podržava nove verzije Monyhara.</translation>
<translation id="1431818719585918472">Dopustite Monyharu da zaključa vaše anonimne kartice.</translation>
<translation id="1472013873724362412">Vaš račun ne funkcionira na Monyharu. Obratite se administratoru domene ili se prijavite običnim Google računom.</translation>
<translation id="1507010443238049608">Pomozite poboljšati Monyharove značajke i izvedbu</translation>
<translation id="1531155317299575425">Prikazuje obavijesti za prijavu u Monyhar.</translation>
<translation id="1584569488888892906">Monyhar je jednostavniji, sigurniji i brži nego ikad</translation>
<translation id="1617663976202781617">Podaci sinkronizacije Monyhara</translation>
<translation id="1736662517232558588">Podaci Monyhara izbrisani su</translation>
<translation id="1838412507805038478">Monyhar je potvrdio da je <ph name="ISSUER" /> izdao certifikat web-lokacije.</translation>
<translation id="1843424232666537147">Monyhar ima značajke koje vam pomažu u upravljanju internetskim podacima i brzinom kojom se učitavaju web-stranice.
<ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="2006345422933397527">Monyhar nije uspio provjeriti ima li ažuriranja. Provjerite internetsku vezu.</translation>
<translation id="2054703085270098503">Ostanite sigurni uz Monyhar</translation>
<translation id="2168108852149185974">Neki programski dodaci uzrokuju rušenje Monyhara. Deinstalirajte:</translation>
<translation id="2178608107313874732">Monyhar trenutačno ne može upotrebljavati vaš fotoaparat</translation>
<translation id="2195025571279539885">Želite li da Monyhar sljedeći put ponudi prijevod stranica s te web-lokacije za <ph name="LANGUAGE_NAME" />?</translation>
<translation id="2567507405773541360">Veća učinkovitost uz Monyhar, jednostavniji, sigurniji i brži nego ikad</translation>
<translation id="2590893390871230428">Sinkroniziraj podatke iz Monyhara</translation>
<translation id="2650312721222849884">Da biste vidjeli svoje kartice bez obzira na to gdje koristite Monyhar, uključite sinkronizaciju</translation>
<translation id="2684230048001240293">Postavite Monyhar kao zadani preglednik da biste sinkronizirali kartice, zaporke i podatke o plaćanju na svim svojim uređajima</translation>
<translation id="2730884209570016437">Monyhar ne može upotrebljavati vaš fotoaparat jer ga upotrebljava neka druga aplikacija</translation>
<translation id="2915596697727466327">Monyhar upotrebljava Face ID radi sprječavanja neovlaštenog pristupa vašim zaporkama.</translation>
<translation id="2918709798697875261">Vaša organizacija zahtijeva da ostanete odjavljeni s Monyhara.</translation>
<translation id="2942241131342758843">Koristite Monyhar prema zadanim postavkama da biste otvarali veze, pretraživali putem widgeta i automatski popunjavali zaporke u drugim aplikacijama</translation>
<translation id="2977470724722393594">Monyhar je ažuran</translation>
<translation id="3256316712990552818">Kopirano na Monyhar</translation>
<translation id="3344973607274501920">Monyhar nije uspio provjeriti vaše zaporke. Provjerite internetsku vezu.</translation>
<translation id="3472200483164753384">Nije podržano u Monyhar Canaryju</translation>
<translation id="3639997914391704523">Monyhar može provjeriti vaše zaporke kad se prijavite Google računom.</translation>
<translation id="3805899903892079518">Monyhar nema pristup fotografijama ni videozapisima. Omogućite pristup u Postavkama iOS-a &gt; Privatnost &gt; Fotografije.</translation>
<translation id="3946918322491238254">Sve vaše oznake, povijest, zaporke i druge postavke i dalje su vam vidljive na ovom uređaju. Ako nešto promijenite, te se promjene neće sinkronizirati s vašim računom.</translation>
<translation id="4099085513035183040">Nije podržano u beta verziji Monyhara</translation>
<translation id="4166206055865952171">Postavljanje Monyhara kao zadanog preglednika</translation>
<translation id="4555020257205549924">Kada je ta značajka uključena, Monyhar će ponuditi prijevod stranica napisanih na drugim jezicima pomoću Google prevoditelja. <ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">Sad možete koristiti Monyhar svaki put kad dodirnete veze u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="4681781466797808448">Uključite Monyharov skener</translation>
<translation id="4736424910885271643">Vašim računom upravlja <ph name="HOSTED_DOMAIN" />, pa će se vaši podaci iz Monyhara izbrisati s ovog uređaja</translation>
<translation id="4806326830773390517">Pomozite poboljšati Monyhar slanjem statistike upotrebe i izvješća o padu programa Googleu</translation>
<translation id="4828317641996116749">Monyhar nije uspio provjeriti sve zaporke. Pokušajte ponovo kasnije.</translation>
<translation id="4852878756222711218">Da biste iskoristili sve prednosti koje vam pruža Monyhar, prijavite se Google računom</translation>
<translation id="4985291216379576555">Monyhar ne može provjeriti ima li ažuriranja jer ste offline</translation>
<translation id="4999538639245140991">Budući da se odjavljujete s računa kojim upravlja <ph name="SIGNOUT_MANAGED_DOMAIN" />, vaši podaci iz Monyhara izbrisat će se s ovog uređaja, no ostat će na vašem Google računu.</translation>
<translation id="5171868502429358653">Prijava na Monyhar</translation>
<translation id="5224391634244552924">Nema nijedne spremljene zaporke. Monyhar može provjeriti vaše zaporke kad ih spremite.</translation>
<translation id="5308226104666789935">Monyhar ne može provjeriti ima li ažuriranja</translation>
<translation id="5396916991083608703">Želite li postaviti Monyhar kao zadani preglednik?</translation>
<translation id="5521125884468363740">Da biste vidjeli svoje kartice bez obzira na to gdje koristite Monyhar, prijavite se i uključite sinkronizaciju</translation>
<translation id="5573014823074921752">Savjet za Monyhar. Za više opcija za kartice dodirnite i držite gumb Prikaži kartice na alatnoj traci pri dnu ili vrhu zaslona.</translation>
<translation id="5700709190537129682">Monyhar ne može provjeriti vaše zaporke</translation>
<translation id="5715349567881822785">Budite produktivniji uz Monyhar</translation>
<translation id="5742135483959137648">Otvaranje veza pomoću Monyhara</translation>
<translation id="5777187867430702742">Monyharova stranica</translation>
<translation id="5862307444128926510">Dobro došli u Monyhar</translation>
<translation id="5945387852661427312">Prijavljujete se računom kojim upravlja <ph name="DOMAIN" /> i njegovom administratoru dajete kontrolu nad svojim podacima u Monyharu. Vaši će se podaci trajno povezati s tim računom. Ako se odjavite s Monyhara, vaši će se podaci izbrisati s ovog uređaja, no ostat će pohranjeni na vašem Google računu.</translation>
<translation id="602807004951640891">Upotrebom Monyhara pristajete na <ph name="BEGIN_LINK_TOS" />Uvjete pružanja usluge<ph name="END_LINK_TOS" />.</translation>
<translation id="6119647025869519954">Da biste postavili Monyhar kao zadani preglednik:
1. Otvorite postavke.
2. Dodirnite opciju Zadana aplikacija preglednika.
3. Odaberite Monyhar.</translation>
<translation id="6155422572367400359">Prijavite se na ovu web-lokaciju, Google račun i Monyhar. Sinkronizaciju možete uključiti kasnije.</translation>
<translation id="6268381023930128611">Želite li se odjaviti iz Monyhara?</translation>
<translation id="632825460376924298">Dopusti prijavu u Monyhar</translation>
<translation id="6337530241089703714">Odaberite želite li podatke iz Monyhara izbrisati s ovog uređaja ili ih zadržati</translation>
<translation id="6424492062988593837">Monyhar je postao još bolji! Dostupna je nova verzija.</translation>
<translation id="6820823224820483452">Monyhar nije uspio provjeriti sve zaporke. Pokušajte ponovo sutra.</translation>
<translation id="6827294685447036764">Ako dopustite Monyharu da sazna vašu lokaciju, Monyhar će je poslati svim web-lokacijama koje dopustite. Web-lokacije mogu tražiti dopuštenje za vašu lokaciju kad vam žele prikazati lokalne informacije, primjerice trgovine u blizini ili vijesti.</translation>
<translation id="7018284295775193585">Monyhar se ne može ažurirati</translation>
<translation id="7045244423563602563">Prilagodite Monyhar sebi</translation>
<translation id="7099326575020694068">Monyhar ne može upotrebljavati vaš fotoaparat u načinu podijeljenog prikaza</translation>
<translation id="7118091470949186573">Sad možete koristiti Monyhar svaki put kad dodirnete veze u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="7208566199746267865">Monyhar vam štedi vrijeme sinkronizacijom vaših računa na webu. Račune možete dodavati i uklanjati u postavkama.</translation>
<translation id="725427773388857052">Monyhar vam može pomoći da se bolje zaštitite od povrede podataka, nesigurnih web-lokacija i još mnogo toga.</translation>
<translation id="7269362888766543920">Neki programski dodaci uzrokuju rušenje Monyhara. Pokušajte ih deinstalirati.</translation>
<translation id="7313655110045230863">Da biste postavili Monyhar kao svoj zadani preglednik, otvorite postavke. Dodirnite opciju Zadana aplikacija preglednika i odaberite Monyhar.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7357211569052832586">Odabrani podaci uklonjeni su iz Monyhara i sa sinkroniziranih uređaja. Na Google računu možda postoje drugi oblici povijesti pregledavanja, primjerice pretraživanja i aktivnosti s drugih Googleovih usluga, na stranici history.google.com.</translation>
<translation id="7400689562045506105">Upotrebljavajte Monyhar svugdje</translation>
<translation id="766897673682622022">Vaša je zaporka ugrožena zbog povrede podataka. Monyhar preporučuje da je odmah promijenite.</translation>
<translation id="7674213385180944843">Otvorite Postavke &gt; Privatnost &gt; Fotoaparat &gt; Monyhar i uključite fotoaparat.</translation>
<translation id="7746854981345936341">Savjet za Monyhar. Neki se gumbi sada nalaze pri dnu zaslona, primjerice za natrag, naprijed i pretraživanje.</translation>
<translation id="7763454117143368771">Koristite Monyhar kao zadani preglednik da biste se zaštitili od opasnih web-lokacija i očuvali sigurnost svojih zaporki</translation>
<translation id="786327964234957808">Prebacujete sinkronizirane račune s korisnika <ph name="USER_EMAIL1" /> na korisnika <ph name="USER_EMAIL2" />. Vašim postojećim podacima na Monyharu upravlja <ph name="DOMAIN" />. Ovime će se izbrisati vaši podaci s vašeg uređaja, no oni će ostati na računu <ph name="USER_EMAIL1" />.</translation>
<translation id="7890287942691234100">Počnite koristiti Monyharov skener</translation>
<translation id="7928628054454574139">Otvorite Monyhar svaki put kada dodirnite veze u drugim aplikacijama</translation>
<translation id="7931842119211730154">Zaključavanje anonimnih kartica pri zatvaranju Chromea</translation>
<translation id="7980860476903281594">Monyhar dijeli vašu lokaciju s web-lokacijama za koje dopustite dijeljenje.</translation>
<translation id="8013573822802650211">Da biste vidjeli svoje kartice bez obzira na to gdje koristite Monyhar, prijavite se na svim svojim uređajima</translation>
<translation id="8073677936375100957">Želite li izbrisati svoje podatke iz Monyhara s ovog uređaja?</translation>
<translation id="8175055321229419309">Savjet: <ph name="BEGIN_LINK" />premjestite Monyhar na priključnu stanicu<ph name="END_LINK" /></translation>
<translation id="8240981428553046115">Monyhar nije uspio provjeriti ima li ažuriranja. Pokušajte ponovo kasnije.</translation>
<translation id="8586442755830160949">Autorska prava <ph name="YEAR" />. Autori Monyhara. Sva prava pridržana.</translation>
<translation id="8663480472502753423">Ažuriranje Monyhara</translation>
<translation id="8776843108004031667">Taj račun i svi nespremljeni podaci uklonit će se iz Monyhara.</translation>
<translation id="894437814105052438">Kad se odjavite, Monyhar neće sinkronizirati nove podatke s vašim Google računom. Ranije sinkronizirani podaci ostat će na računu.</translation>
<translation id="9022552996538154597">Prijava na Monyhar</translation>
<translation id="9089354809943900324">Monyhar je zastario</translation>
<translation id="921174536258924340">Monyhar nije uspio provjeriti sve zaporke. Pokušajte ponovno sutra ili <ph name="BEGIN_LINK" />provjerite zaporke na svojem Google računu<ph name="END_LINK" />.</translation>
<translation id="985602178874221306">Autori Monyhara</translation>
</translationbundle>