<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="102360288709523007">Pomagajte izboljšati Monyhar s pošiljanjem statističnih podatkov o uporabi in poročil o zrušitvah Googlu.</translation>
<translation id="1185134272377778587">O Monyharu</translation>
<translation id="1257458525759135959">Če želite shraniti slike, se dotaknite aplikacije Settings in dovolite, da Monyhar dodaja fotografijam</translation>
<translation id="1289216811211435351">Preklop na Monyhar</translation>
<translation id="1361748954329991663">Monyhar je zastarel. Če v trgovini <ph name="BEGIN_LINK" />App Store<ph name="END_LINK" /> ni na voljo nobene posodobitve, vaša naprava morda ne podpira več novih različic Monyhara.</translation>
<translation id="1431818719585918472">Naj Monyhar zaklene anonimne zavihke.</translation>
<translation id="1472013873724362412">Vaš račun ne deluje v Monyharu. Obrnite se na skrbnika domene ali za prijavo uporabite običajen Google Račun.</translation>
<translation id="1507010443238049608">Pomagajte izboljšati funkcije in delovanje Monyhara</translation>
<translation id="1531155317299575425">Pokaže pozive za prijavo v Monyhar.</translation>
<translation id="1584569488888892906">Monyhar je preprost, varen in hitrejši kot kdaj prej.</translation>
<translation id="1617663976202781617">Podatki iz sinhronizacije za Monyhar</translation>
<translation id="1736662517232558588">Podatki Monyhara so izbrisani</translation>
<translation id="1838412507805038478">Monyhar je preveril, ali je izdajatelj <ph name="ISSUER" /> izdal potrdilo tega spletnega mesta.</translation>
<translation id="1843424232666537147">Monyhar ima funkcije, s katerimi lažje upravljate internetne podatke in hitrost nalaganja spletnih strani.
<ph name="BEGIN_LINK" />Več o tem<ph name="END_LINK" /></translation>
<translation id="2006345422933397527">Monyhar ni mogel preveriti, ali so na voljo posodobitve. Poskusite preveriti internetno povezavo.</translation>
<translation id="2054703085270098503">Ostanite varni s Monyharom</translation>
<translation id="2168108852149185974">Nekateri dodatki povzročajo zrušitve Monyhara. Odstranite jih:</translation>
<translation id="2178608107313874732">Monyhar trenutno ne more uporabljati fotoaparata</translation>
<translation id="2195025571279539885">Želite, da Monyhar naslednjič ponudi prevod strani v jeziku <ph name="LANGUAGE_NAME" /> s tega spletnega mesta?</translation>
<translation id="2567507405773541360">Opravite več s preprostim in varnim Monyharom, ki je hitrejši kot kdaj prej.</translation>
<translation id="2590893390871230428">Sinhroniziranje podatkov v Monyharu</translation>
<translation id="2650312721222849884">Če si želite ogledati zavihke iz naprav, v katerih uporabljate Monyhar, vklopite sinhronizacijo</translation>
<translation id="2684230048001240293">Nastavite Monyhar kot privzeto možnost sinhroniziranja zavihkov, gesel in podatkov za plačilo v vseh napravah.</translation>
<translation id="2730884209570016437">Monyhar ne more uporabljati fotoaparata, ker ga uporablja druga aplikacija</translation>
<translation id="2915596697727466327">Monyhar uporablja funkcijo Face ID za zagotavljanje pooblaščenega dostopa do vaših gesel.</translation>
<translation id="2918709798697875261">Vaša organizacija zahteva, da niste prijavljeni v Monyhar.</translation>
<translation id="2942241131342758843">Uporabljajte Monyhar kot privzeto možnost odpiranja povezav, iskanja v pripomočkih in samodejnega izpolnjevanja gesel v drugih aplikacijah.</translation>
<translation id="2977470724722393594">Monyhar je posodobljen</translation>
<translation id="3256316712990552818">Kopirano v Monyhar</translation>
<translation id="3344973607274501920">Monyharu ni uspelo preveriti vaših gesel. Poskusite preveriti internetno povezavo.</translation>
<translation id="3472200483164753384">Ni podprto v Monyharu Canary</translation>
<translation id="3639997914391704523">Monyhar lahko preveri vaša gesla, ko se prijavite z računom Google.</translation>
<translation id="3805899903892079518">Monyhar nima dostopa do fotografij ali videoposnetkov. Omogočite dostop v sistemu iOS: Settings &gt; Privacy &gt; Photos.</translation>
<translation id="3946918322491238254">Še vedno si lahko ogledate zaznamke, zgodovino, gesla in druge nastavitve v tej napravi. Če naredite spremembe, ne bodo sinhronizirane z računom.</translation>
<translation id="4099085513035183040">Ni podprto v Monyharu Beta</translation>
<translation id="4166206055865952171">Nastavite Monyhar kot privzeti brskalnik</translation>
<translation id="4555020257205549924">Kadar je vklopljena ta funkcija, bo Monyhar ponudil, da z uporabo Google Prevajalnika prevede strani v drugih jezikih. <ph name="BEGIN_LINK" />Več o tem<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">Zdaj lahko uporabljate Monyhar, kadar koli se dotaknete povezav v sporočilih, dokumentih in drugih aplikacijah.</translation>
<translation id="4681781466797808448">Vklopite optični bralnik Monyhar</translation>
<translation id="4736424910885271643">Vaš račun upravlja domena <ph name="HOSTED_DOMAIN" />, zato bodo podatki v Monyharu izbrisani iz te naprave.</translation>
<translation id="4806326830773390517">Pomagajte izboljšati Monyhar, tako da Googlu pošiljate statistične podatke uporabe in poročila o zrušitvah.</translation>
<translation id="4828317641996116749">Monyharu ni uspelo preveriti vseh gesel. Poskusite znova pozneje.</translation>
<translation id="4852878756222711218">Če želite kar najbolje izkoristiti Monyhar, se prijavite z računom Google.</translation>
<translation id="4985291216379576555">Monyhar brez povezave ne more preveriti, ali so na voljo posodobitve</translation>
<translation id="4999538639245140991">Ker se boste odjavili iz računa, ki ga upravlja <ph name="SIGNOUT_MANAGED_DOMAIN" />, boste iz te naprave izbrisali podatke v Monyharu. Vaši podatki bodo še vedno na voljo v Google Računu.</translation>
<translation id="5171868502429358653">Prijavite se v Monyhar</translation>
<translation id="5224391634244552924">Ni shranjenih gesel. Monyhar lahko preveri gesla, če jih shranite.</translation>
<translation id="5308226104666789935">Monyhar ne more preveriti, ali so na voljo posodobitve</translation>
<translation id="5396916991083608703">Želite nastaviti Monyhar kot privzeto možnost?</translation>
<translation id="5521125884468363740">Če si želite ogledati zavihke iz naprav, v katerih uporabljate Monyhar, se prijavite in vklopite sinhronizacijo</translation>
<translation id="5573014823074921752">Nasvet za Monyhar. Če želite več možnosti za zavihke, pridržite gumb za prikaz zavihkov v orodni vrstici na dnu ali vrhu zaslona.</translation>
<translation id="5700709190537129682">Monyhar ne more preveriti vaših gesel</translation>
<translation id="5715349567881822785">Opravite več s Monyharom</translation>
<translation id="5742135483959137648">Uporaba Monyhara za odpiranje povezav</translation>
<translation id="5777187867430702742">Stran Monyhara</translation>
<translation id="5862307444128926510">Pozdravljeni v Monyharu</translation>
<translation id="5945387852661427312">Prijavljate se z računom, ki ga upravlja <ph name="DOMAIN" />, in nadzor nad podatki v Monyharu predajate skrbniku. Vaši podatki bodo trajno povezani s tem računom. Če se odjavite iz Monyhara, boste izbrisali podatke iz te naprave, vendar bodo še naprej shranjeni v Google Računu.</translation>
<translation id="602807004951640891">Če uporabljate Monyhar, se strinjate s <ph name="BEGIN_LINK_TOS" />pogoji storitve<ph name="END_LINK_TOS" />.</translation>
<translation id="6119647025869519954">Monyhar nastavite kot privzeti iskalnik tako:
1. Odprite nastavitve.
2. Dotaknite se možnosti za privzeto aplikacijo za brskanje.
3. Izberite Monyhar.</translation>
<translation id="6155422572367400359">Prijavite se na tem spletnem mestu, v svoj račun Google in Monyhar. Sinhronizacijo lahko vklopite pozneje.</translation>
<translation id="6268381023930128611">Se želite odjaviti iz Monyhara?</translation>
<translation id="632825460376924298">Omogočanje prijave v Monyhar</translation>
<translation id="6337530241089703714">Izberite, ali želite izbrisati podatke v Monyharu iz te naprave ali jih obdržati.</translation>
<translation id="6424492062988593837">Monyhar je izboljšan! Na voljo je nova različica.</translation>
<translation id="6820823224820483452">Monyharu ni uspelo preveriti vseh gesel. Poskusite znova jutri.</translation>
<translation id="6827294685447036764">Če Monyharu omogočite dostop do podatkov o lokaciji, jih Monyhar pošlje na spletna mesta, ki jim podelite dovoljenje. Spletna mesta morda zahtevajo podatke o lokaciji, ko želijo prikazati lokalne informacije, na primer trgovine v bližini ali novice.</translation>
<translation id="7018284295775193585">Monyhara ni mogoče posodobiti</translation>
<translation id="7045244423563602563">Prilagodite si Monyhar</translation>
<translation id="7099326575020694068">Monyhar ne more uporabljati fotoaparata v načinu razdeljenega pogleda</translation>
<translation id="7118091470949186573">Zdaj lahko uporabljate Monyhar, kadar koli se dotaknete povezav v sporočilih, dokumentih in drugih aplikacijah.</translation>
<translation id="7208566199746267865">Monyhar poskrbi, da so vaši računi v spletu, in vam tako prihrani čas. Račune lahko dodajate ali odstranjujete v nastavitvah.</translation>
<translation id="725427773388857052">Monyhar vas lahko varuje pred podatkovnimi kršitvami, spletnimi mesti, ki niso varna, in drugim.</translation>
<translation id="7269362888766543920">Nekateri dodatki povzročajo zrušitve Monyhara. Poskusite jih odstraniti.</translation>
<translation id="7313655110045230863">Če želite Monyhar nastaviti kot privzeti brskalnik, odprite nastavitve. Dotaknite se »Privzeti brskalnik« in izberite Monyhar.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7357211569052832586">Izbrani podatki so bili odstranjeni iz Monyhara in sinhroniziranih naprav. V Google Računu so morda druge vrste zgodovine brskanja, kot so iskanja in dejavnosti iz drugih Googlovih storitev, na history.google.com.</translation>
<translation id="7400689562045506105">Uporaba Monyhara povsod</translation>
<translation id="766897673682622022">Geslo je bilo razkrito zaradi podatkovne kršitve. Monyhar priporoča, da takoj spremenite geslo.</translation>
<translation id="7674213385180944843">Odprite Settings &gt; Privacy &gt; Camera &gt; Monyhar in vklopite fotoaparat.</translation>
<translation id="7746854981345936341">Nasvet za Monyhar. Nekateri gumbi, na primer gumbi za nazaj, naprej in iskanje, so zdaj na dnu zaslona.</translation>
<translation id="7763454117143368771">Uporabljajte Monyhar kot privzeti brskalnik, če se želite zaščititi pred nevarnimi spletnimi mesti in poskrbeti za varnost gesel.</translation>
<translation id="786327964234957808">Z računa za sinhronizacijo <ph name="USER_EMAIL1" /> boste preklopili na račun <ph name="USER_EMAIL2" />. Obstoječe podatke v Monyharu upravlja <ph name="DOMAIN" />. S tem boste izbrisali podatke iz te naprave, vendar bodo vaši podatki še vedno na voljo v računu <ph name="USER_EMAIL1" />.</translation>
<translation id="7890287942691234100">Začnite uporabljati optični bralnik Monyhar</translation>
<translation id="7928628054454574139">Odpiranje Monyhara ob vsakem dotiku povezav v drugih aplikacijah.</translation>
<translation id="7931842119211730154">Zaklepanje anonimnih zavihkov po zaprtju Chroma</translation>
<translation id="7980860476903281594">Monyhar vašo lokacijo deli s spletnimi mesti, ki jih dovolite.</translation>
<translation id="8013573822802650211">Če si želite ogledati zavihke iz naprav, v katerih uporabljate Monyhar, se prijavite v vseh napravah</translation>
<translation id="8073677936375100957">Ali želite izbrisati podatke v Monyharu iz te naprave?</translation>
<translation id="8175055321229419309">Nasvet: <ph name="BEGIN_LINK" />premaknite Monyhar v vrstico z aplikacijami<ph name="END_LINK" /></translation>
<translation id="8240981428553046115">Monyhar ni mogel preveriti, ali so na voljo posodobitve. Poskusite pozneje.</translation>
<translation id="8586442755830160949">Copyright <ph name="YEAR" /> Ustvarjalci Monyhara. Vse pravice pridržane.</translation>
<translation id="8663480472502753423">Posodobitev Monyhara</translation>
<translation id="8776843108004031667">Ta račun in neshranjeni podatki bodo odstranjeni iz Monyhara.</translation>
<translation id="894437814105052438">Če se odjavite, Monyhar ne bo več sinhroniziral novih podatkov v račun Google. Predhodno sinhronizirani podatki ostanejo v računu.</translation>
<translation id="9022552996538154597">Prijava v Monyhar</translation>
<translation id="9089354809943900324">Monyhar je zastarel</translation>
<translation id="921174536258924340">Monyharu ni uspelo preveriti vseh gesel. Poskusite znova jutri ali <ph name="BEGIN_LINK" />preverite gesla v računu Google.<ph name="END_LINK" /></translation>
<translation id="985602178874221306">Ustvarjalci Monyhara</translation>
</translationbundle>