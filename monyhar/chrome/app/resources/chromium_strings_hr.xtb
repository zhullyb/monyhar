<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="1065672644894730302">Vaše postavke nije moguće čitati. Neke značajke možda nisu dostupne i promjene postavki neće biti spremljene.</translation>
<translation id="1098170124587656448">Monyhar vam može pomoći da se bolje zaštitite od povrede podataka, zlonamjernih proširenja i još mnogo toga</translation>
<translation id="1104942323762546749">Monyhar želi izvesti vaše zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="113122355610423240">Monyhar je vaš zadani preglednik</translation>
<translation id="1131805035311359397">Da biste provjerili jesu li vaše zaporke sigurne od povrede podataka i drugih poteškoća sa sigurnošću, <ph name="BEGIN_LINK" />prijavite se na Monyhar<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">O pregledniku Monyhar</translation>
<translation id="1315551408014407711">Postavite novi profil u Monyharu</translation>
<translation id="1396446129537741364">Monyhar pokušava prikazati zaporke.</translation>
<translation id="1414495520565016063">Prijavljeni ste na Monyhar!</translation>
<translation id="151962892725702025">OS Monyhar nije mogao sinkronizirati vaše podatke jer sinkronizacija nije dostupna za vašu domenu.</translation>
<translation id="1524282610922162960">Dijeljenje kartice Monyhar</translation>
<translation id="1553461853655228091">Monyhar treba dopuštenje za pristup kameri radi izrade 3D karte vašeg okruženja</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Vaš administrator zahtijeva da ponovno pokrenete Monyhar radi primjene ažuriranja}=1{Vaš administrator zahtijeva da ponovno pokrenete Monyhar radi primjene ažuriranja. Anonimni se prozor neće ponovno otvoriti.}one{Vaš administrator zahtijeva da ponovno pokrenete Monyhar radi primjene ažuriranja. Vaš # anonimni prozor neće se ponovno otvoriti.}few{Vaš administrator zahtijeva da ponovno pokrenete Monyhar radi primjene ažuriranja. Vaša # anonimna prozora neće se ponovno otvoriti.}other{Vaš administrator zahtijeva da ponovno pokrenete Monyhar radi primjene ažuriranja. Vaših # anonimnih prozora neće se ponovno otvoriti.}}</translation>
<translation id="1708666629004767631">Dostupna je nova, sigurnija verzija preglednika Monyhar.</translation>
<translation id="1774152462503052664">Neka Monyhar radi u pozadini</translation>
<translation id="1779356040007214683">Kako bismo Monyhar učinili sigurnijim, onemogućili smo neka proširenja koja nisu navedena u trgovini <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> i možda su dodana bez vašeg znanja.</translation>
<translation id="1808667845054772817">Ponovo instaliraj Monyhar</translation>
<translation id="1881322772814446296">Prijavljujete se upravljanim računom i dajete administratoru kontrolu nad svojim profilom u sustavu Monyhar. Vaši podaci u sustavu Monyhar, primjerice, aplikacije, oznake, povijest, zaporke i ostale postavke, trajno će se povezati s korisnikom <ph name="USER_NAME" />. Moći ćete izbrisati te podatke putem Nadzorne ploče Google računa, ali ih nećete moći povezati s nekim drugim računom. Ako želite, možete izraditi novi profil kako biste zadržali postojeće podatke u sustavu Monyhar zasebno. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">Ako isključite tu opciju, možete se prijaviti na Googleove web-lokacije kao što je Gmail bez prijavljivanja u Monyhar</translation>
<translation id="1929939181775079593">Monyhar ne reagira. Ponovo pokrenuti sada?</translation>
<translation id="1966382378801805537">Monyhar ne može utvrditi niti postaviti zadani preglednik</translation>
<translation id="1981611865800294956">Ponovo pokrenite da biste ažurirali OS &amp;Monyhar</translation>
<translation id="2008474315282236005">Time će se izbrisati jedna stavka s uređaja. Da biste kasnije dohvatili svoje podatke, prijavite se na Monyhar kao <ph name="USER_EMAIL" />.</translation>
<translation id="2020032459870799438">Da biste provjerili jesu li vaše druge zaporke sigurne od povrede podataka i drugih poteškoća sa sigurnošću, <ph name="BEGIN_LINK" />prijavite se na Monyhar<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">Prilagodi Monyhar</translation>
<translation id="2185166961232948079">Monyhar – Prijava na mrežu – <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">Ako dijelite računalo, prijatelji i članovi obitelji mogu zasebno pregledavati i postaviti Monyhar prema svojim željama.</translation>
<translation id="2294245788148774212">Nije obavezno: pomozite poboljšati značajke i izvedbu OS-a Monyhar automatskim slanjem podataka o upotrebi i dijagnostici Googleu.</translation>
<translation id="2343156876103232566">Da biste poslali broj s ovog uređaja na svoj Android telefon, prijavite se na Monyhar na oba uređaja.</translation>
<translation id="2347108572062610441">Ovo proširenje promijenilo je stranicu koja se prikazuje prilikom pokretanja Monyhara.</translation>
<translation id="2396765026452590966">Proširenje "<ph name="EXTENSION_NAME" />" promijenilo je stranicu koja se prikazuje prilikom pokretanja Monyhara.</translation>
<translation id="2483889755041906834">U Monyharu</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2535480412977113886">OS Monyhar nije mogao sinkronizirati podatke vašeg računa jer su pojedinosti prijave na račun zastarjele.</translation>
<translation id="2560420686485554789">Monyhar treba pristup pohrani radi preuzimanja datoteka</translation>
<translation id="2572494885440352020">Monyhar Helper</translation>
<translation id="2577788541081224677">Da biste pristupili svojim sadržajima u Monyharu na svim svojim uređajima, prijavite se kako biste mogli uključiti sinkronizaciju.</translation>
<translation id="2580426763510374355">Instalirajte OS Monyhar</translation>
<translation id="2583187216237139145">Sve podatke iz Monyhara koji se generiraju tijekom upotrebe ovog profila (primjerice izradom oznaka, povijesti, zaporki i drugih postavki) može ukloniti administrator poslovnog profila. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">Potrebno je ponovo pokrenuti Monyhar OS kako bi se ažuriranje primijenilo.</translation>
<translation id="2648074677641340862">Došlo je do pogreške operativnog sustava tijekom instalacije. Ponovo preuzmite Monyhar.</translation>
<translation id="2661879430930417727">Ako dijelite uređaj, prijatelji i članovi obitelji mogu zasebno pregledavati i postaviti Monyhar prema svojim željama</translation>
<translation id="2711502716910134313">Monyharova kartica</translation>
<translation id="2718390899429598676">Radi dodatne sigurnosti Monyhar će šifrirati vaše podatke.</translation>
<translation id="2770231113462710648">Promijeni zadani preglednik na:</translation>
<translation id="2799223571221894425">Pokreni ponovo</translation>
<translation id="2816712596130903444">Želite li razdvojiti profil u Monyharu?</translation>
<translation id="2837693172913560447">Izradit će se novi profil u Monyharu za <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="2847479871509788944">Ukloni iz Monyhara...</translation>
<translation id="2885378588091291677">Upravitelj zadataka</translation>
<translation id="2910007522516064972">O pregledniku &amp;Monyhar</translation>
<translation id="2977470724722393594">Monyhar je ažuran</translation>
<translation id="2983934633046890458">Monyhar pokušava urediti zaporke.</translation>
<translation id="3032706164202344641">Monyhar ne može provjeriti vaše zaporke. Pokušajte ponovno kasnije.</translation>
<translation id="3032787606318309379">Dodavanje u preglednik Monyhar...</translation>
<translation id="3068515742935458733">Pomognite nam poboljšati Monyhar šaljući izvješća o rušenju programa i <ph name="UMA_LINK" /> Googleu</translation>
<translation id="3103660991484857065">Program za instalaciju nije dekomprimirao arhivu. Ponovo preuzmite Monyhar.</translation>
<translation id="3130323860337406239">Monyhar upotrebljava vaš mikrofon.</translation>
<translation id="3155163173539279776">Ponovo pokreni Monyhar</translation>
<translation id="3179665906251668410">Otvori vezu u ano&amp;nimnom prozoru Monyhara</translation>
<translation id="3185330573522821672">Prilagodba novog profila u Monyharu</translation>
<translation id="3190315855212034486">Hopa! Monyhar je pao. Pokrenuti ponovo sada?</translation>
<translation id="3229526316128325841">Monyhar želi izvesti vaše zaporke.</translation>
<translation id="3258596308407688501">Monyhar ne može čitati iz svojeg podatkovnog direktorija niti u njega pisati:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">Instalirana je Monyharova verzija <ph name="PRODUCT_VERSION" /></translation>
<translation id="328888136576916638">Nedostaju ključevi Google API-ja. Neke funkcije Monyhara bit će onemogućene.</translation>
<translation id="3296368748942286671">Nastavi izvršavati ​​pozadinske aplikacije po zatvaranju preglednika Monyhar</translation>
<translation id="331951419404882060">OS Monyhar nije mogao sinkronizirati vaše podatke zbog pogreške prilikom prijave.</translation>
<translation id="3350761136195634146">Već postoji profil u Monyharu s tim računom</translation>
<translation id="3406848076815591792">Želite li prijeći na postojeći profil u Monyharu?</translation>
<translation id="3430503420100763906">Pomoću Monyharovih profila možete razdvojiti sve svoje sadržaje u Monyharu. Izradite profile za prijatelje i obitelj ili odvojite posao i zabavu.</translation>
<translation id="3433271666494956603">Instalacija OS-a Monyhar u tijeku</translation>
<translation id="347328004046849135">Chrome će vas obavijestiti kada se prijavite ugroženom zaporkom</translation>
<translation id="3474745554856756813">Time će se izbrisati sljedeći broj stavki s uređaja: <ph name="ITEMS_COUNT" />. TDa biste kasnije dohvatili svoje podatke, prijavite se na Monyhar kao <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Pomoću prečaca <ph name="SHORTCUT" /> možete se prebacivati između profila u Monyharu</translation>
<translation id="3509308970982693815">Zatvorite sve prozore preglednika Monyhar i pokušajte ponovo.</translation>
<translation id="3575459661164320785">Na računalu imate štetni softver. Monyhar ga može ukloniti, vratiti vaše postavke i onemogućiti proširenja kako bi vaš preglednik ponovo funkcionirao normalno.</translation>
<translation id="3610776674893128619">Izbriši tvrdi disk i instaliraj OS Monyhar</translation>
<translation id="3639635944603682591">Podaci o pregledavanju za tu osobu izbrisat će se s ovog uređaja. Da biste vratili te podatke, prijavite se na Monyhar kao <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Dostupno je novo ažuriranje za Monyhar koje će se primijeniti nakon ponovnog pokretanja.}=1{Dostupno je novo ažuriranje za Monyhar koje će se primijeniti nakon ponovnog pokretanja. Anonimni se prozor neće ponovno otvoriti.}one{Dostupno je novo ažuriranje za Monyhar koje će se primijeniti nakon ponovnog pokretanja. Vaš # anonimni prozor neće se ponovno otvoriti.}few{Dostupno je novo ažuriranje za Monyhar koje će se primijeniti nakon ponovnog pokretanja. Vaša # anonimna prozora neće se ponovno otvoriti.}other{Dostupno je novo ažuriranje za Monyhar koje će se primijeniti nakon ponovnog pokretanja. Vaših # anonimnih prozora neće se ponovno otvoriti.}}</translation>
<translation id="3651803019964686660">Da biste poslali broj s uređaja <ph name="ORIGIN" /> na svoj Android telefon, prijavite se na Monyhar na oba uređaja.</translation>
<translation id="3685209450716071127">Monyhar ne može provjeriti vaše zaporke. Provjerite internetsku vezu.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Vaš administrator traži da ponovno pokrenete Monyhar radi primjene tog ažuriranja}=1{Vaš administrator traži da ponovno pokrenete Monyhar radi primjene tog ažuriranja. Anonimni se prozor neće ponovno otvoriti.}one{Vaš administrator traži da ponovno pokrenete Monyhar radi primjene tog ažuriranja. Vaš # anonimni prozor neće se ponovno otvoriti.}few{Vaš administrator traži da ponovno pokrenete Monyhar radi primjene tog ažuriranja. Vaša # anonimna prozora neće se ponovno otvoriti.}other{Vaš administrator traži da ponovno pokrenete Monyhar radi primjene tog ažuriranja. Vaših # anonimnih prozora neće se ponovno otvoriti.}}</translation>
<translation id="371088601698879021">OS Monyhar može vratiti vaše aplikacije i stranice nakon ponovnog pokretanja bez postavljanja upita svaki put.</translation>
<translation id="3713809861844741608">Otvori vezu na novoj &amp;kartici Monyhara</translation>
<translation id="3728336900324680424">Monyhar će pristupati vašem Disku radi prikazivanja prijedloga u adresnoj traci</translation>
<translation id="378917192836375108">Monyhar omogućuje da kliknete telefonski broj na webu i nazovete ga koristeći se Skypeom!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> – Monyhar</translation>
<translation id="388648406173476553">Prilagodite Monyhar i upravljajte njime. Trebate obratiti pozornost na nešto – kliknite za pojedinosti.</translation>
<translation id="3889543394854987837">Kliknite svoje ime da biste otvorili Monyhar i počeli s pregledavanjem.</translation>
<translation id="390528597099634151">Korisnik <ph name="EXISTING_USER" /> već je prijavljen na taj profil u Monyharu. Da bi vaše pregledavanje ostalo odvojeno, Monyhar vam može izraditi vlastiti profil.</translation>
<translation id="3945058413678539331">Monyhar pokušava kopirati zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="4036079820698952681">Pomognite poboljšati Monyhar tako što ćete prijaviti <ph name="BEGIN_LINK" />trenutačne postavke<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Najnovija verzija sadrži važna sigurnosna poboljšanja i nove značajke.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> – Prijava na mrežu – Monyhar</translation>
<translation id="421369550622382712">Otkrijte sjajne aplikacije, igre, proširenja i teme za Monyhar.</translation>
<translation id="4216212958613226427">Taj se jezik koristi za prikaz korisničkog sučelja Monyhara</translation>
<translation id="4230135487732243613">Želite li povezati svoje podatke sustava Monyhar s tim računom?</translation>
<translation id="4264410486868823224"><ph name="MANAGER" /> zahtijeva da pročitate i prihvatite sljedeće Uvjete pružanja usluge prije upotrebe ovog uređaja. Ti uvjeti ne predstavljaju proširenje, izmjenu ili ograničenje Uvjeta OS-a Monyhar.</translation>
<translation id="4271805377592243930">Potraži pomoć za upotrebu Monyhara</translation>
<translation id="4285930937574705105">Instalacija nije uspjela zbog nepoznate pogreške. Ako je Monyhar trenutačno otvoren, zatvorite ga i pokušajte ponovo.</translation>
<translation id="4407044323746248786">Želite li ipak zatvoriti Monyhar?</translation>
<translation id="4415566066719264597">Neka Monyhar radi u pozadini</translation>
<translation id="4423735387467980091">Prilagodite Monyhar i upravljajte njime</translation>
<translation id="4491398312037323794">Na ovoj stranici možete upravljati Google računima na koje ste prijavljeni. Ti će računi biti dostupni u aplikacijama preglednika Monyhar i Trgovine Play te na uslugama kao što su Gmail, Disk i YouTube. <ph name="LINK_BEGIN" />Saznajte više<ph name="LINK_END" /></translation>
<translation id="452711251841752011">Dobro došli u Monyhar; otvorio se novi prozor preglednika</translation>
<translation id="4544142686420020088">Monyhar se nije ažurirao zbog pogreške. <ph name="BEGIN_LINK" />Riješite probleme s ažuriranjem i neuspjela ažuriranja Monyhara.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Želite li nastaviti na novom profilu u Monyharu?</translation>
<translation id="4567424176335768812">Prijavljeni ste kao <ph name="USER_EMAIL_ADDRESS" />. Sada možete pristupiti svojim oznakama, povijesti i drugim postavkama na svim uređajima na kojima se prijavljujete.</translation>
<translation id="459535195905078186">Aplikacije sustava Monyhar</translation>
<translation id="4665829708273112819">Upozorenje: Monyhar ne može onemogućiti proširenjima da bilježe vašu povijest pregledavanja. Da biste onemogućili to proširenje u anonimnom načinu, poništite odabir te opcije.</translation>
<translation id="4677944499843243528">Izgleda da neki drugi proces Monyhara (<ph name="PROCESS_ID" />) na nekom drugom računalu (<ph name="HOST_NAME" />) upotrebljava taj profil. Monyhar je zaključao profil da se profil ne bi promijenio. Ako ste sigurni da nijedan drugi proces ne upotrebljava taj profil, možete ga otključati i ponovo pokrenuti Monyhar.</translation>
<translation id="469338717132742108">Potraži pomoć za upotrebu OS-a Monyhar</translation>
<translation id="4708774505295300557">Netko se prethodno prijavio na Monyhar na ovom računalu kao <ph name="ACCOUNT_EMAIL_LAST" />. Izradite novog korisnika Monyhara kako bi vaši podaci bili odvojeni.</translation>
<translation id="4746050847053251315">Želite li ipak zatvoriti Monyhar?</translation>
<translation id="4748217263233248895">Upravo je primijenjeno posebno sigurnosno ažuriranje za Monyhar. Ponovo pokrenite sustav i vratit ćemo vaše kartice.</translation>
<translation id="4750035648288509542">Ažuriranje je skoro gotovo! Ponovo pokrenite Monyhar da biste završili ažuriranje. Anonimni prozori neće se ponovno otvoriti.</translation>
<translation id="4788777615168560705">Monyhar ne može provjeriti vaše zaporke. Pokušajte ponovno nakon 24 sata ili <ph name="BEGIN_LINK" />provjerite zaporke na svojem Google računu<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Upotrebljava istu provjeru pravopisa koja se upotrebljava na Google pretraživanju. Tekst koji unesete u preglednik šalje se Googleu. To ponašanje možete promijeniti u postavkama kad god želite.</translation>
<translation id="4888717733111232871">Ulazno pravilo kako bi Monyhar dopustio mDNS promet.</translation>
<translation id="4893347770495441059">Ponovno pokretanje radi ažuriranja &amp;Monyhara</translation>
<translation id="4943838377383847465">Monyhar radi u pozadini.</translation>
<translation id="4987820182225656817">Gosti mogu upotrebljavati Monyhar bez ostavljanja tragova o upotrebi.</translation>
<translation id="4994636714258228724">Dodajte sebe kao korisnika Monyhara</translation>
<translation id="5224391634244552924">Nema nijedne spremljene zaporke. Monyhar može provjeriti vaše zaporke kad ih spremite.</translation>
<translation id="5252179775517634216">Korisnik <ph name="EXISTING_USER" /> već je prijavljen na taj profil u Monyharu. Izradit će se novi profil u Monyharu za <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="5277894862589591112">Da bi se vaše promjene primijenile, ponovo pokrenite Monyhar</translation>
<translation id="5358375970380395591">Prijavljujete se upravljanim računom i dajete administratoru kontrolu nad svojim profilom u sustavu Monyhar. Vaši podaci u sustavu Monyhar, primjerice, aplikacije, oznake, povijest, zaporke i ostale postavke, trajno će se povezati s korisnikom <ph name="USER_NAME" />. Moći ćete izbrisati te podatke putem Nadzorne ploče Google računa, ali ih nećete moći povezati s nekim drugim računom. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Ažuriranje Monyhara (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Dopusti prijavu u Monyhar</translation>
<translation id="5398878173008909840">Dostupna je nova verzija preglednika Monyhar.</translation>
<translation id="5416696090975899932">Monyhar ne može prikazati pregled ispisa kad nedostaje ugrađeni PDF preglednik.</translation>
<translation id="5427571867875391349">Postavite Chrome kao zadani preglednik</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> – Monyhar Beta</translation>
<translation id="5479196819031988440">OS Monyhar ne može otvoriti ovu stranicu.</translation>
<translation id="5480860683791598150">Monyhar treba dopuštenje za pristup vašoj lokaciji da bi je podijelio s ovom web-lokacijom</translation>
<translation id="5481338274774984070">Monyhar preporučuje da ne preuzimate i ne otvarate tu datoteku.</translation>
<translation id="549669000822060376">Pričekajte da Monyhar instalira najnovija ažuriranja sustava.</translation>
<translation id="5496810170689441661">Monyhar pokušava urediti zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="5527463683072221100">Otvori PDF-ove u Monyharu</translation>
<translation id="5623402015214259806">{0,plural, =0{Dostupno je ažuriranje Monyhara}=1{Dostupno je ažuriranje Monyhara}one{Ažuriranje Monyhara dostupno je već # dan}few{Ažuriranje Monyhara dostupno je već # dana}other{Ažuriranje Monyhara dostupno je već # dana}}</translation>
<translation id="5634636535844844681">Monyhar zahtijeva Windows 7 ili noviju verziju.</translation>
<translation id="5653831366781983928">Sada ponovo pokrenite Monyhar</translation>
<translation id="5698481217667032250">Prikaži Monyhar na tom jeziku</translation>
<translation id="5820394555380036790">OS Monyhar</translation>
<translation id="5854740544000584380">OS Monyhar omogućuje dodatni <ph name="BEGIN_LINK_CROS_OSS" />softver otvorenog koda<ph name="END_LINK_CROS_OSS" />, isto kao i <ph name="BEGIN_LINK_LINUX_OSS" />razvojno okruženje Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="5862307444128926510">Dobro došli u Monyhar</translation>
<translation id="5895138241574237353">Ponovno pokreni</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Prijava na mrežu</translation>
<translation id="5987687638152509985">Ažurirajte Monyhar da bi se pokrenula sinkronizacija</translation>
<translation id="6039377483953237732">Verzija OS-a Monyhar</translation>
<translation id="6055895534982063517">Dostupna je nova verzija preglednika Monyhar, brža no ikad.</translation>
<translation id="6063093106622310249">&amp;Otvori u Monyharu</translation>
<translation id="6072279588547424923">Proširenje <ph name="EXTENSION_NAME" /> dodano je u Monyhar</translation>
<translation id="608006075545470555">Dodavanje poslovnog profila u ovaj preglednik</translation>
<translation id="608189560609172163">Monyhar nije mogao sinkronizirati vaše podatke zbog pogreške prilikom prijave.</translation>
<translation id="6096348254544841612">Prilagodite i kontrolirajte Monyhar. Dostupno je ažuriranje.</translation>
<translation id="6120345080069858279">Monyhar će spremiti tu zaporku na vaš Google račun. Ne morate je pamtiti.</translation>
<translation id="6129621093834146363">Datoteka <ph name="FILE_NAME" /> opasna je, pa ju je Monyhar blokirao.</translation>
<translation id="6134968993075716475">Sigurno je pregledavanje isključeno. Monyhar preporučuje da ga uključite.</translation>
<translation id="6145820983052037069">Ovdje se možete prebacivati između profila u Monyharu</translation>
<translation id="61577490437262925"><ph name="BEGIN_PARAGRAPH1" />Spremni smo za instaliranje OS-a Monyhar! Kad nastavite:
          <ph name="BEGIN_LIST" />
          <ph name="LIST_ITEM" />Izbrisat će se datoteke, podaci i vaš trenutačni operativni sustav.
          <ph name="LIST_ITEM" />Instalirat će se OS Monyhar.
          <ph name="LIST_ITEM" />Vaš će se uređaj isključiti nakon dovršetka instalacije.
          <ph name="END_LIST" />
          <ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />Još jednom podsjećamo: instalacijom se briše cijeli tvrdi disk. Provjerite imate li sigurnosnu kopiju svih važnih podataka.<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />Nakon što započne, instalacija se ne može otkazati.<ph name="END_PARAGRAPH3" /></translation>
<translation id="6183079672144801177">Obavezno se prijavite na Monyhar na uređaju <ph name="TARGET_DEVICE_NAME" /> i nakon toga ponovno pokušajte sa slanjem.</translation>
<translation id="6212496753309875659">Ovo računalo već ima noviju verziju Monyhara. Ako softver ne funkcionira, deinstalirajte Monyhar i pokušajte ponovo.</translation>
<translation id="6219195342503754812">{0,plural, =0{Monyhar će se sada ponovo pokrenuti}=1{Monyhar će se ponovo pokrenuti za jednu sekundu}one{Monyhar će se ponovo pokrenuti za # sekundu}few{Monyhar će se ponovo pokrenuti za # sekunde}other{Monyhar će se ponovo pokrenuti za # sekundi}}</translation>
<translation id="6248213926982192922">Neka Monyhar bude zadani preglednik</translation>
<translation id="6266342355635466082">Monyhar ne može provjeriti ažuriranja. Provjerite internetsku vezu.</translation>
<translation id="6268381023930128611">Želite li se odjaviti iz Monyhara?</translation>
<translation id="6281746429495226318">Prilagodite profil u Monyharu</translation>
<translation id="6290827346642914212">Odaberite naziv profila za Monyhar</translation>
<translation id="6295779123002464101">Datoteka <ph name="FILE_NAME" /> mogla bi biti opasna, pa ju je Monyhar blokirao.</translation>
<translation id="6309712487085796862">Monyhar upotrebljava vašu kameru.</translation>
<translation id="6333502561965082103">U tijeku je neka druga operacija na Monyharu. Pokušajte ponovo kasnije.</translation>
<translation id="6334986366598267305">Upotreba Monyhara s vašim Google računom te na dijeljenim računalima sada je još jednostavnija.</translation>
<translation id="6373523479360886564">Jeste li sigurni da želite deinstalirati Monyhar?</translation>
<translation id="6403826409255603130">Monyhar je web-preglednik koji munjevitom brzinom prikazuje web-stranice i aplikacije. Brz je, stabilan i jednostavan za upotrebu. Pregledavajte web sigurnije jer je zaštita od zlonamjernog softvera i krađe identiteta ugrađena u Monyhar.</translation>
<translation id="6434250628340475518">OS Monyhar</translation>
<translation id="6455857529632101747">Dobro došli u Monyharove profile</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Monyhar će se ponovo pokrenuti za 1 sekundu}one{Monyhar će se ponovo pokrenuti za # sekundu}few{Monyhar će se ponovo pokrenuti za # sekunde}other{Monyhar će se ponovo pokrenuti za # sekundi}}</translation>
<translation id="646620589868199210">Spremno za instaliranje OS-a Monyhar</translation>
<translation id="6475912303565314141">Upravlja i time koja se stranica prikazuje prilikom pokretanja Monyhara.</translation>
<translation id="6510925080656968729">Deinstaliranje Monyhara</translation>
<translation id="6542839706527980775">Svaki profil ima vlastite podatke u Monyharu kao što su oznake, povijest, zaporke i slično</translation>
<translation id="6570579332384693436">Monyhar Googleu šalje tekst koji utipkate u tekstualna polja kako bi ispravio pravopisne pogreške</translation>
<translation id="6598877126913850652">Otvori postavke obavijesti za Monyhar</translation>
<translation id="6613594504749178791">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete Monyhar.</translation>
<translation id="6676384891291319759">Pristup Internetu</translation>
<translation id="6717134281241384636">Vaš se profil ne može upotrebljavati jer je iz novije verzije Monyhara.

Neke su značajke možda nedostupne. Navedite neki drugi direktorij profila ili upotrijebite noviju verziju Monyhara.</translation>
<translation id="6734080038664603509">Ažuriranje &amp;Monyhara</translation>
<translation id="6734291798041940871">Monyhar je već instaliran za sve korisnike na računalu.</translation>
<translation id="673636774878526923">Da biste mogli pristupiti svojim sadržajima u Monyharu na svim svojim uređajima, prijavite se i zatim uključite sinkronizaciju.</translation>
<translation id="6774082503108938489">Tvoj je roditelj isključio "Dopuštenja za web-lokacije, aplikacije i proširenja" za Monyhar. Nije dopušteno omogućiti <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="6827182711503025204">Instaliranjem OS-a Monyhar prebrisat će se svi podaci na tvrdom disku.</translation>
<translation id="6847869444787758381">Monyhar će vas obavijestiti ako vaše zaporke budu ugrožene</translation>
<translation id="6857782730669500492">Monyhar – <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (kopirano na Monyhar)</translation>
<translation id="6893813176749746474">Monyhar je ažuriran, ali vi ga niste upotrebljavali najmanje 30 dana.</translation>
<translation id="691026815377248078">Monyhar treba pristup Bluetoothu za nastavak 
 uparivanja. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">Otvori vezu u ano&amp;nimnom prozoru Monyhara</translation>
<translation id="6978145336957848883">Slabe zaporke lako je pogoditi. Neka Monyhar <ph name="BEGIN_LINK" />izradi i zapamti snažne zaporke za vas<ph name="END_LINK" />.</translation>
<translation id="6990124437352146030">Monyhar treba dopuštenje za pristup mikrofonu za ovu web-lokaciju</translation>
<translation id="705851970750939768">Ažuriraj Monyhar</translation>
<translation id="7067091210845072982">Ako slika nema koristan opis, Monyhar će ga pokušati pružiti. Da bi se izradili opisi, slike se šalju Googleu.</translation>
<translation id="7196312274710523067">Pokretanje Monyhara nije uspjelo. Pokušajte ponovo.</translation>
<translation id="7197677400338048821">Monyhar ne može provjeriti vaše zaporke. Pokušajte ponovno nakon 24 sata.</translation>
<translation id="7223968959479464213">Upravitelj zadataka – Monyhar</translation>
<translation id="731644333568559921">Ažuriranje OS-a &amp;Monyhar</translation>
<translation id="731795002583552498">Ažuriranje Monyhara</translation>
<translation id="7318036098707714271">Datoteka vaših postavki oštećena je ili nevažeća.

Monyhar ne može oporaviti vaše postavke.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7339898014177206373">Novi prozor</translation>
<translation id="734373864078049451">Ovdje se nalaze vaš web, oznake i ostali sadržaji u Monyharu.</translation>
<translation id="7349591376906416160">Vaš administrator sustava konfigurirao je Monyhar da otvara <ph name="ALTERNATIVE_BROWSER_NAME" /> za pristup URL-u <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7448255348454382571">Ponovo pokrenite OS Monyhar</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> – Monyhar Dev</translation>
<translation id="7451052299415159299">Monyhar treba dopuštenje za pristup kameri za ovu web-lokaciju</translation>
<translation id="7483335560992089831">Ne možete instalirati istu verziju Monyhara koja se trenutačno izvršava. Zatvorite Monyhar i pokušajte ponovo.</translation>
<translation id="753534427205733210">{0,plural, =1{Monyhar će se ponovo pokrenuti za jednu minutu}one{Monyhar će se ponovo pokrenuti za # min}few{Monyhar će se ponovo pokrenuti za # min}other{Monyhar će se ponovo pokrenuti za # min}}</translation>
<translation id="7549178288319965365">O OS-u Monyhar</translation>
<translation id="7561906087460245826">Izbriši i podatke s Monyhara (<ph name="URL" />)</translation>
<translation id="7585853947355360626">Ako se postavka ne prikazuje na ovoj stranici, pogledajte <ph name="LINK_BEGIN" />
      postavke OS-a Monyhar<ph name="LINK_END" /></translation>
<translation id="761356813943268536">Monyhar upotrebljava vašu kameru i mikrofon.</translation>
<translation id="7617377681829253106">Monyhar je upravo postao bolji</translation>
<translation id="7627575518938382525"><ph name="BEGIN_PARAGRAPH1" />Prije nego što započnemo, provjerite imate li ažuriranu sigurnosnu kopiju podataka. Instaliranjem OS-a Monyhar prebrisat će se svi podaci na tvrdom disku.<ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />Google ne odgovara ni za kakav gubitak podataka te ne jamči da će OS Monyhar funkcionirati na necertificiranim modelima. Posjetite [TBD] i saznajte više o certificiranim modelima.<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />Saznajte više o instaliranju OS-a Monyhar i brisanju podataka: [TBD URL]<ph name="END_PARAGRAPH3" />
          <ph name="BEGIN_PARAGRAPH4" />Ako ste spremni nastaviti, kliknite Instaliraj OS Monyhar i vodit ćemo vas kroz instalaciju u samo nekoliko jednostavnih koraka. Moći ćete još jednom potvrditi prije nego što na bilo koji način izmijenimo vaše računalo.<ph name="END_PARAGRAPH4" /></translation>
<translation id="7686590090926151193">Monyhar nije vaš zadani preglednik</translation>
<translation id="7689606757190482937">Sinkronizirajte Monyhar kako bi bio prilagođen vama na svim vašim uređajima</translation>
<translation id="7729447699958282447">Monyhar nije mogao sinkronizirati vaše podatke jer sinkronizacija nije dostupna za vašu domenu.</translation>
<translation id="7745317241717453663">Time će se izbrisati podaci o pregledavanju s uređaja. Da biste kasnije dohvatili svoje podatke, prijavite se na Monyhar kao <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Program za instalaciju nije izradio privremeni direktorij. Provjerite ima li slobodnog prostora na disku i postoji li dopuštenje za instalaciju softvera.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> – Monyhar Canary</translation>
<translation id="7828947555739565424">Profil u Monyharu s tim računom već postoji na ovom uređaju</translation>
<translation id="7857220146454061152">Da biste primali buduća Monyharova ažuriranja, trebat će vam OS X 10.11 ili novija verzija. Na ovom se računalu upotrebljava OS X 10.10.</translation>
<translation id="7867198900892795913">Monyhar se nije mogao ažurirati na najnoviju verziju, tako da nemate nove značajke i sigurnosne popravke.</translation>
<translation id="7898472181347242998">Ažurnost uređaja možete provjeriti u <ph name="LINK_BEGIN" />postavkama OS-a Monyhar<ph name="LINK_END" /></translation>
<translation id="7907774600618164274">OS Monyhar nije se ispravno zatvorio.</translation>
<translation id="7937630085815544518">Bili ste prijavljeni na Monyhar kao <ph name="USER_EMAIL_ADDRESS" />. Prijavite se ponovo istim računom.</translation>
<translation id="7975919845073681630">Ovo je sekundarna instalacija Monyhara, pa on ne može biti vaš zadani preglednik.</translation>
<translation id="8013436988911883588">Kada Monyhar dobije pristup, web-lokacije će vas moći tražiti pristup.</translation>
<translation id="81770708095080097">Datoteka je opasna i Monyhar ju je blokirao.</translation>
<translation id="8248265253516264921">Ako slika nema koristan opis, Monyhar će ga pokušati pružiti. Da bi se izradili opisi, slike se šalju Googleu. To možete isključiti u bilo kojem trenutku u postavkama.</translation>
<translation id="8266560134891435528">Monyhar ne može provjeriti vaše zaporke jer niste prijavljeni</translation>
<translation id="8276522524898344151">Monyhar pokušava kopirati zaporke.</translation>
<translation id="8290862415967981663">Datoteka je možda opasna i Monyhar ju je blokirao.</translation>
<translation id="8330519371938183845">Prijavite se da biste sinkronizirali i prilagodili Monyhar na svim svojim uređajima</translation>
<translation id="8340674089072921962">E-adresa <ph name="USER_EMAIL_ADDRESS" /> prethodno je upotrebljavala Monyhar</translation>
<translation id="8417404458978023919">{0,plural, =1{Ponovo pokrenite Monyhar u roku od jednog dana}one{Ponovo pokrenite Monyhar u roku od # dana}few{Ponovo pokrenite Monyhar u roku od # dana}other{Ponovo pokrenite Monyhar u roku od # dana}}</translation>
<translation id="8453117565092476964">Arhiva programa za instalaciju oštećena je ili nevažeća. Ponovo preuzmite Monyhar.</translation>
<translation id="8493179195440786826">Monyhar je zastario</translation>
<translation id="8550334526674375523">Ovaj poslovni profil potpuno je zaseban od vašeg osobnog profila.</translation>
<translation id="8558383651099478961">Tvoj je roditelj isključio "Dopuštenja za web-lokacije, aplikacije i proširenja" za Monyhar. Nije dopušteno dodati <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="8568283329061645092">Monyhar može provjeriti vaše zaporke kad se prijavite Google računom</translation>
<translation id="8586442755830160949">Autorska prava <ph name="YEAR" />. Autori Monyhara. Sva prava pridržana.</translation>
<translation id="8619360774459241877">Pokretanje Monyhara...</translation>
<translation id="8621669128220841554">Instalacija nije uspjela zbog nepoznate pogreške. Ponovo preuzmite Monyhar.</translation>
<translation id="8697124171261953979">Upravlja i time koja se stranica prikazuje prilikom pokretanja Monyhara ili pretraživanja putem višenamjenskog okvira.</translation>
<translation id="8704119203788522458">To je vaš Monyhar</translation>
<translation id="8796602469536043152">Monyhar treba dopuštenje za pristup kameri i mikrofonu za ovu web-lokaciju</translation>
<translation id="8803635938069941624">Uvjeti OS-a Monyhar</translation>
<translation id="8821041990367117597">Monyhar nije mogao sinkronizirati podatke vašeg računa jer su pojedinosti prijave na račun zastarjele.</translation>
<translation id="8862326446509486874">Nemate odgovarajuća prava za instaliranje na razini sustava. Pokušajte ponovno pokrenuti program za instalaciju kao administrator.</translation>
<translation id="8880203542552872219">Ako jeste, uredite zaporku spremljenu u Monyharu kako bi odgovarala vašoj novoj zaporki.</translation>
<translation id="8897323336392112261">Upravlja i time koja se stranica prikazuje prilikom pokretanja Monyhara ili kada se klikne gumb Početna.</translation>
<translation id="8907580949721785412">Monyhar pokušava prikazati zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="8941642502866065432">Nije moguće ažurirati Monyhar</translation>
<translation id="8974095189086268230">OS Monyhar omogućuje dodatni <ph name="BEGIN_LINK_CROS_OSS" />softver utemeljen na otvorenom kôdu<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="8986207147630327271">Dodat ćete poslovni profil u ovaj preglednik i dati administratoru kontrolu samo nad poslovnim profilom.</translation>
<translation id="9019929317751753759">Kako bismo Monyhar učinili sigurnijim, onemogućili smo sljedeće proširenje koje nije navedeno na stranici <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> i možda je dodano bez vašeg znanja.</translation>
<translation id="9047197236183657400">Želite li premjestiti račun na novi profil u Monyharu?</translation>
<translation id="9089354809943900324">Monyhar je zastario</translation>
<translation id="9093206154853821181">{0,plural, =1{Monyhar će se ponovo pokrenuti za sat vremena}one{Monyhar će se ponovo pokrenuti za # h}few{Monyhar će se ponovo pokrenuti za # h}other{Monyhar će se ponovo pokrenuti za # h}}</translation>
<translation id="91086099826398415">Otvori vezu na novoj &amp;kartici Monyhara</translation>
<translation id="911206726377975832">Izbrisati i podatke o pregledavanju?</translation>
<translation id="9158494823179993217">Vaš administrator sustava konfigurirao je Monyhar tako da otvara zamjenski preglednik radi pristupa URL-u<ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="9185526690718004400">Ponovo pokrenite da biste ažurirali &amp;Monyhar</translation>
<translation id="9190841055450128916">Monyhar (mDNS-In)</translation>
<translation id="9214764063801632699">OS Monyhar</translation>
<translation id="93478295209880648">Monyhar možda neće ispravno raditi jer više nije podržan na sustavima Windows XP i Windows Vista</translation>
<translation id="965162752251293939">Tko upotrebljava Monyhar?</translation>
