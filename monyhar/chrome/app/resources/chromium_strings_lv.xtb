<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="1065672644894730302">Jūsu preferences nevar nolasīt. Dažas funkcijas var nebūt pieejamas, un preferenču izmaiņas netiks saglabātas</translation>
<translation id="1098170124587656448">Monyhar var palīdzēt aizsargāt jūs pret datu noplūdi, ļaunprātīgiem paplašinājumiem un citiem apdraudējumiem.</translation>
<translation id="1104942323762546749">Pārlūkā Monyhar tiek mēģināts eksportēt jūsu paroles. Lai to atļautu, ievadiet savu Windows paroli.</translation>
<translation id="113122355610423240">Jūsu noklusējuma pārlūks ir Monyhar.</translation>
<translation id="1131805035311359397">Lai pārbaudītu, vai jūsu paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Monyhar<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">Par Monyhar</translation>
<translation id="1315551408014407711">Jaunā Monyhar profila iestatīšana</translation>
<translation id="1396446129537741364">Monyhar mēģina rādīt paroles.</translation>
<translation id="1414495520565016063">Esat pierakstījies operētājsistēmā Monyhar!</translation>
<translation id="151962892725702025">Monyhar OS nevarēja sinhronizēt jūsu datus, jo jūsu domēnā nav pieejama sinhronizācija.</translation>
<translation id="1524282610922162960">Monyhar cilnes kopīgošana</translation>
<translation id="1553461853655228091">Pārlūkam Monyhar ir nepieciešama atļauja piekļūt jūsu kamerai, lai varētu izveidot jūsu apkārtnes 3D karti</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Monyhar.}=1{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Monyhar. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Monyhar. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Monyhar. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu atjauninājumu, administrators pieprasa restartēt pārlūku Monyhar. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="1708666629004767631">Ir pieejama jauna un drošāka Monyhar versija.</translation>
<translation id="1774152462503052664">Ļaut Monyhar darboties fonā</translation>
<translation id="1779356040007214683">Lai uzlabotu Monyhar drošību, mēs atspējojām dažus paplašinājumus, kas nav norādīti vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienoti, jums nezinot.</translation>
<translation id="1808667845054772817">Pārinstalēt Monyhar</translation>
<translation id="1881322772814446296">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Monyhar dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. Ja vēlaties, varat izveidot jaunu profilu, lai atsevišķi glabātu Monyhar datus. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">Ja izslēgsiet šo iestatījumu, varēsiet pierakstīties Google vietnēs, piemēram, pakalpojumā Gmail, nepierakstoties pārlūkā Monyhar.</translation>
<translation id="1929939181775079593">Monyhar nereaģē. Vai restartēt to tūlīt?</translation>
<translation id="1966382378801805537">Monyhar nevar noteikt vai iestatīt noklusējuma pārlūku.</translation>
<translation id="1981611865800294956">Atkārtoti palaist, lai atjauninātu &amp;Monyhar OS</translation>
<translation id="2008474315282236005">Veicot šo darbību, no šīs ierīces tiks dzēsts 1 vienums. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Monyhar kā <ph name="USER_EMAIL" />.</translation>
<translation id="2020032459870799438">Lai pārbaudītu, vai jūsu pārējās paroles ir aizsargātas pret datu pārkāpumiem un citām drošības problēmām, <ph name="BEGIN_LINK" />pierakstieties pārlūkā Monyhar<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">Pielāgot pārlūkprogrammu Monyhar</translation>
<translation id="2185166961232948079">Monyhar — pierakstīšanās tīklā — <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">Ja jūsu datoru izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Monyhar atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos kontos.</translation>
<translation id="2294245788148774212">Neobligāti: palīdziet uzlabot Monyhar OS funkcijas un veiktspēju, automātiski nosūtot Google serveriem diagnostikas un lietojuma datus.</translation>
<translation id="2343156876103232566">Lai nosūtītu numuru no šejienes uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Monyhar.</translation>
<translation id="2347108572062610441">Šis paplašinājums mainīja iestatījumu, kura lapa tiek parādīta, palaižot pārlūku Monyhar.</translation>
<translation id="2396765026452590966">Paplašinājums “<ph name="EXTENSION_NAME" />” mainīja iestatījumu, kura lapa tiek parādīta, palaižot pārlūku Monyhar.</translation>
<translation id="2483889755041906834">Pārlūkā Monyhar</translation>
<translation id="2485422356828889247">Atinstalēt</translation>
<translation id="2535480412977113886">Monyhar OS nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="2560420686485554789">Pārlūkam Monyhar ir nepieciešama piekļuve krātuvei, lai varētu lejupielādēt failus.</translation>
<translation id="2572494885440352020">Monyhar palīgs</translation>
<translation id="2577788541081224677">Lai piekļūtu savam Monyhar saturam visās jūsu ierīcēs, pierakstieties un ieslēdziet sinhronizāciju.</translation>
<translation id="2580426763510374355">Instalēt Monyhar OS</translation>
<translation id="2583187216237139145">Darba profila administrators var noņemt šī profila lietošanas laikā ģenerētos Monyhar datus (piemēram, grāmatzīmes, vēsturi, paroles un citus iestatījumus). <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">Lai lietotu atjauninājumu, operētājsistēma Monyhar ir jārestartē.</translation>
<translation id="2648074677641340862">Instalācijas laikā radās operētājsistēmas kļūda. Lejupielādējiet Monyhar vēlreiz.</translation>
<translation id="2661879430930417727">Ja ierīci izmanto arī jūsu draugi un ģimenes locekļi, viņi var iestatīt pārlūku Monyhar atbilstoši savām vēlmēm un pārlūkot saturu atsevišķos profilos.</translation>
<translation id="2711502716910134313">Monyhar cilne</translation>
<translation id="2718390899429598676">Papildu drošības nolūkos Monyhar šifrēs jūsu datus.</translation>
<translation id="2770231113462710648">Mainīt noklusējuma pārlūkprogrammu uz:</translation>
<translation id="2799223571221894425">Restartēt</translation>
<translation id="2816712596130903444">Vai izveidot atsevišķu Monyhar profilu?</translation>
<translation id="2837693172913560447">Tādējādi tiks izveidots jauns Monyhar profils lietotājam <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="2847479871509788944">Noņemšana no pārlūka Monyhar...</translation>
<translation id="2885378588091291677">Uzdevumu pārvaldnieks</translation>
<translation id="2910007522516064972">Par &amp;Monyhar</translation>
<translation id="2977470724722393594">Monyhar ir atjaunināts</translation>
<translation id="2983934633046890458">Monyhar mēģina rediģēt paroles.</translation>
<translation id="3032706164202344641">Pārlūkprogrammā Monyhar nevar pārbaudīt jūsu paroles. Vēlāk mēģiniet vēlreiz.</translation>
<translation id="3032787606318309379">Notiek pievienošana pārlūkam Monyhar...</translation>
<translation id="3068515742935458733">Palīdzēt uzlabot Monyhar, nosūtot Google serveriem avāriju pārskatus un <ph name="UMA_LINK" /></translation>
<translation id="3103660991484857065">Instalēšanas programmai neizdevās atarhivēt arhīvu. Lejupielādējiet Monyhar vēlreiz.</translation>
<translation id="3130323860337406239">Pārlūkā Monyhar tiek izmantots jūsu mikrofons.</translation>
<translation id="3155163173539279776">Restartēt Monyhar</translation>
<translation id="3179665906251668410">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="3185330573522821672">Pielāgojiet savu jauno Monyhar profilu.</translation>
<translation id="3190315855212034486">Eh! Monyhar ir avarējis. Vai restartēt to tūlīt?</translation>
<translation id="3229526316128325841">Pārlūkā Monyhar tiek mēģināts eksportēt jūsu paroles.</translation>
<translation id="3258596308407688501">Monyhar nevar nolasīt savu datu direktoriju un ierakstīt tajā:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">Ir instalēta Monyhar versija <ph name="PRODUCT_VERSION" /></translation>
<translation id="328888136576916638">Trūkst Google API atslēgu. Tiks atspējotas dažas Monyhar funkcijas.</translation>
<translation id="3296368748942286671">Turpināt lietotņu izpildi fonā, kad Monyhar ir aizvērts</translation>
<translation id="331951419404882060">Monyhar OS nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="3350761136195634146">Monyhar profils ar šādu kontu jau pastāv</translation>
<translation id="3406848076815591792">Vai pāriet uz esošo Monyhar profilu?</translation>
<translation id="3430503420100763906">Izmantojot Monyhar profilus, varat nodalīt visu savu Monyhar saturu. Izveidojiet profilus draugiem un ģimenes locekļiem vai nodaliet darba un izklaides saturu.</translation>
<translation id="3433271666494956603">Notiek operētājsistēmas Monyhar OS instalēšana</translation>
<translation id="347328004046849135">Ja pierakstīsieties ar uzlauztu paroli, pārlūkprogrammā Monyhar tiks parādīts paziņojums</translation>
<translation id="3474745554856756813">Veicot šo darbību, no šīs ierīces tiks dzēsts(-i) <ph name="ITEMS_COUNT" /> vienums(-i). Lai vēlāk izgūtu datus, pierakstieties pārlūkā Monyhar kā <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931">Lai pārslēgtos starp Monyhar profiliem, izmantojiet īsinājumtaustiņu <ph name="SHORTCUT" />.</translation>
<translation id="3509308970982693815">Aizveriet visus Monyhar logus un mēģiniet vēlreiz.</translation>
<translation id="3575459661164320785">Jūsu datorā ir kaitīga programmatūra. Pārlūkprogramma Monyhar var to noņemt, atjaunot jūsu iestatījumus un atspējot paplašinājumus, lai atkal pareizi darbotos.</translation>
<translation id="3610776674893128619">Dzēst datus cietajā diskā un instalēt Monyhar OS</translation>
<translation id="3639635944603682591">Šī lietotāja pārlūkošanas dati tiks dzēsti no šīs ierīces. Lai atkoptu datus, pierakstieties pārlūkprogrammā Monyhar kā lietotājs <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Pieejams Monyhar atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku.}=1{Pieejams Monyhar atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Pieejams Monyhar atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Pieejams Monyhar atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Pieejams Monyhar atjauninājums, un tas tiks lietots, tiklīdz restartēsiet pārlūku. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="3651803019964686660">Lai nosūtītu numuru no vietnes <ph name="ORIGIN" /> uz savu Android tālruni, abās ierīcēs pierakstieties pārlūkā Monyhar.</translation>
<translation id="3685209450716071127">Pārlūkprogrammā Monyhar nevar pārbaudīt jūsu paroles. Pārbaudiet interneta savienojumu.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Monyhar.}=1{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Monyhar. Jūsu inkognito režīma logs netiks atkārtoti atvērts.}zero{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Monyhar. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}one{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Monyhar. # jūsu inkognito režīma logs netiks atkārtoti atvērts.}other{Lai lietotu šo atjauninājumu, administrators lūdz restartēt pārlūku Monyhar. # jūsu inkognito režīma logi netiks atkārtoti atvērti.}}</translation>
<translation id="371088601698879021">Monyhar OS var automātiski atjaunot jūsu lietotnes un lapas pēc atkārtotas palaišanas (bez nepieciešamības jautāt katru reizi).</translation>
<translation id="3713809861844741608">Atvērt saiti jaunā Monyhar &amp;cilnē</translation>
<translation id="3728336900324680424">Pārlūkā Monyhar tiks izmantota Diskā pieejamā informācija, lai adrešu joslā piedāvātu ieteikumus</translation>
<translation id="378917192836375108">Monyhar ļauj jums noklikšķināt uz tālruņa numura un zvanīt uz to pakalpojumā Skype!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> — Monyhar</translation>
<translation id="388648406173476553">Pielāgojiet un kontrolējiet pārlūkprogrammu Monyhar. Ir nepieciešama jūsu uzmanība. Noklikšķiniet, lai skatītu plašāku informāciju.</translation>
<translation id="3889543394854987837">Noklikšķiniet uz sava vārda, lai atvērtu Monyhar un sāktu pārlūkošanu.</translation>
<translation id="390528597099634151">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Monyhar profilā. Lai atdalītu pārlūkošanu, pārlūkā Monyhar varat sev izveidot atsevišķu profilu.</translation>
<translation id="3945058413678539331">Monyhar mēģina nokopēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="4036079820698952681">Palīdziet uzlabot pārlūku Monyhar, ziņojot par <ph name="BEGIN_LINK" />pašreizējiem iestatījumiem<ph name="END_LINK" />.</translation>
<translation id="4050175100176540509">Jaunākajā versijā ir pieejami svarīgi drošības uzlabojumi un jaunas funkcijas.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā — Monyhar</translation>
<translation id="421369550622382712">Atklājiet lieliskas lietotnes, spēles, paplašinājumus un motīvus, ko varat izmantot pārlūkā Monyhar.</translation>
<translation id="4216212958613226427">Šī valoda tiek izmantota, lai attēlotu Monyhar lietotāja saskarni</translation>
<translation id="4230135487732243613">Vai saistīt Monyhar datus ar šo kontu?</translation>
<translation id="4264410486868823224"><ph name="MANAGER" /> pieprasa, lai pirms šīs ierīces lietošanas jūs izlasītu tālāk sniegtos pakalpojumu sniegšanas noteikumus un piekristu tiem. Šie noteikumi nepaplašina, nepārveido un neierobežo operētājsistēmas Monyhar OS noteikumus.</translation>
<translation id="4271805377592243930">Saņemt palīdzību par Monyhar</translation>
<translation id="4285930937574705105">Instalācija neizdevās nenoteiktas kļūdas dēļ. Ja Monyhar šobrīd darbojas, aizveriet to un mēģiniet vēlreiz.</translation>
<translation id="4407044323746248786">Vai tik un tā aizvērt pārlūku Monyhar?</translation>
<translation id="4415566066719264597">Ļaut pārlūkam Monyhar darboties fonā</translation>
<translation id="4423735387467980091">Pielāgot un kontrolēt Monyhar</translation>
<translation id="4491398312037323794">Šajā lapā varat pārvaldīt Google kontus, kuros esat pierakstījies. Šie konti būs pieejami pārlūkā Monyhar un Play veikala lietotnēs, kā arī tādos pakalpojumos kā Gmail, Disks un YouTube. <ph name="LINK_BEGIN" />Uzziniet vairāk<ph name="LINK_END" />.</translation>
<translation id="452711251841752011">Laipni lūdzam pārlūkā Monyhar (tika atvērts jauns pārlūka logs)!</translation>
<translation id="4544142686420020088">Pārlūkprogramma Monyhar netika atjaunināta. Radās problēma. <ph name="BEGIN_LINK" />Novērsiet Monyhar atjaunināšanas problēmas.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Vai turpināt jaunā Monyhar profilā?</translation>
<translation id="4567424176335768812">Jūs esat pierakstījies kā <ph name="USER_EMAIL_ADDRESS" />. Tagad varat piekļūt savām grāmatzīmēm, vēsturei un citiem iestatījumiem visās ierīcēs, kurās esat pierakstījies.</translation>
<translation id="459535195905078186">Monyhar lietotnes</translation>
<translation id="4665829708273112819">Brīdinājums! Monyhar nevar novērst to, ka paplašinājumi ieraksta jūsu pārlūkošanas vēsturi. Lai atspējotu šo paplašinājumu inkognito režīmā, noņemiet šīs opcijas atlasi.</translation>
<translation id="4677944499843243528">Šķiet, ka profils tiek izmantots citā Monyhar procesā (<ph name="PROCESS_ID" />) citā datorā (<ph name="HOST_NAME" />). Lai profils netiktu bojāts, pārlūkā Monyhar tas ir bloķēts. Ja esat pārliecināts, ka šis profils netiek izmantots citos procesos, varat to atbloķēt un restartēt pārlūku Monyhar.</translation>
<translation id="469338717132742108">Saņemt palīdzību par Monyhar OS</translation>
<translation id="4708774505295300557">Kāds iepriekš pierakstījās pārlūkā Monyhar šajā datorā, izmantojot e-pasta adresi <ph name="ACCOUNT_EMAIL_LAST" />. Lūdzu, izveidojiet jaunu Monyhar lietotāju, lai nošķirtu savu informāciju.</translation>
<translation id="4746050847053251315">Vai tik un tā aizvērt pārlūku Monyhar?</translation>
<translation id="4748217263233248895">Tikko tika piemērots īpašs Monyhar drošības atjauninājums. Restartējiet tūlīt, un mēs atjaunosim jūsu cilnes.</translation>
<translation id="4750035648288509542">Gandrīz atjaunināts! Lai pabeigtu atjaunināšanu, atkārtoti palaidiet pārlūkprogrammu Monyhar. Inkognito režīma logi netiks atkārtoti atvērti.</translation>
<translation id="4788777615168560705">Pārlūkprogrammā Monyhar nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām vai <ph name="BEGIN_LINK" />pārbaudiet paroles savā Google kontā<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Šeit tiek izmantota tāds pats pareizrakstības pārbaudītājs, kāds tiek izmantots Google meklēšanā. Pārlūkprogrammā ievadītais teksts tiek nosūtīts Google serveriem. Jebkurā brīdī varat mainīt šo darbību iestatījumos.</translation>
<translation id="4888717733111232871">Ienākošo savienojumu kārtula pārlūkam Monyhar, lai atļautu mDNS datplūsmu.</translation>
<translation id="4893347770495441059">Atkārtoti palaist, lai atjauninātu &amp;Monyhar</translation>
<translation id="4943838377383847465">Monyhar darbojas fona režīmā.</translation>
<translation id="4987820182225656817">Viesi var izmantot Monyhar, neatstājot nekādas pēdas.</translation>
<translation id="4994636714258228724">Pievienot savu kontu pārlūkā Monyhar</translation>
<translation id="5224391634244552924">Nav saglabātu paroļu. Pārlūkprogrammā Monyhar var pārbaudīt jūsu paroles, ja jūs tās saglabājat.</translation>
<translation id="5252179775517634216">Lietotājs <ph name="EXISTING_USER" /> jau ir pierakstījies šajā Monyhar profilā. Tādējādi tiks izveidots jauns Monyhar profils lietotājam <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="5277894862589591112">Lai ieviestu veiktās izmaiņas, atkārtoti palaidiet pārlūku Monyhar.</translation>
<translation id="5358375970380395591">Jūs pierakstāties ar pārvaldītu kontu, kura administrators var kontrolēt jūsu profilu. Jūsu Monyhar dati, piemēram, lietotnes, grāmatzīmes, vēsture, paroles un citi iestatījumi, tiks neatgriezeniski saistīti ar lietotāju <ph name="USER_NAME" />. Varēsiet dzēst šos datus, izmantojot Google kontu informācijas paneli, taču nevarēsiet šos datus saistīt ar citu kontu. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Notiek Monyhar atjaunināšana (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Atļaut pierakstīties pārlūkā Monyhar</translation>
<translation id="5398878173008909840">Pieejama jauna Monyhar versija.</translation>
<translation id="5416696090975899932">Monyhar nevar parādīt drukas priekšskatījumu, ja nav pieejams iebūvētais PDF skatītājs.</translation>
<translation id="5427571867875391349">Iestatīt Monyhar kā noklusējuma pārlūku</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> — Monyhar beta versija</translation>
<translation id="5479196819031988440">Monyhar OS nevar atvērt šo lapu.</translation>
<translation id="5480860683791598150">Pārlūkam Monyhar ir nepieciešama piekļuve jūsu atrašanās vietas datiem, lai varētu tos kopīgot ar šo vietni.</translation>
<translation id="5481338274774984070">Monyhar norāda, ka nav ieteicams lejupielādēt vai atvērt šo failu.</translation>
<translation id="549669000822060376">Lūdzu, uzgaidiet, kamēr Monyhar instalē jaunākos sistēmas atjauninājumus.</translation>
<translation id="5496810170689441661">Monyhar mēģina rediģēt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="5527463683072221100">Atvērt PDF failus pārlūkā Monyhar</translation>
<translation id="5623402015214259806">{0,plural, =0{Ir pieejams Monyhar atjauninājums}=1{Ir pieejams Monyhar atjauninājums}zero{Monyhar atjauninājums ir pieejams jau # dienu}one{Monyhar atjauninājums ir pieejams jau # dienu}other{Monyhar atjauninājums ir pieejams jau # dienas}}</translation>
<translation id="5634636535844844681">Pārlūka Monyhar izmantošanai nepieciešama operētājsistēma Windows 7 vai jaunāka versija.</translation>
<translation id="5653831366781983928">Lūdzu, nekavējoties restartējiet pārlūku Monyhar</translation>
<translation id="5698481217667032250">Rādīt Monyhar šajā valodā</translation>
<translation id="5820394555380036790">Monyhar OS</translation>
<translation id="5854740544000584380">Monyhar OS, kā arī <ph name="BEGIN_LINK_LINUX_OSS" />Linux izstrādes vides<ph name="END_LINK_LINUX_OSS" /> darbību nodrošina <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūra<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="5862307444128926510">Laipni lūdzam pārlūkā Monyhar!</translation>
<translation id="5895138241574237353">Restartēt</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> — pierakstīšanās tīklā</translation>
<translation id="5987687638152509985">Lai sāktu sinhronizēšanu, atjauniniet Monyhar.</translation>
<translation id="6039377483953237732">Monyhar OS versija</translation>
<translation id="6055895534982063517">Ir pieejama jauna Monyhar versija, un tā ir ātrāka nekā jebkad agrāk.</translation>
<translation id="6063093106622310249">&amp;Atvērt pārlūkā Monyhar</translation>
<translation id="6072279588547424923">Paplašinājums <ph name="EXTENSION_NAME" /> ir pievienots pārlūkam Monyhar</translation>
<translation id="608006075545470555">Darba profila pievienošana šai pārlūkprogrammai</translation>
<translation id="608189560609172163">Monyhar nevarēja sinhronizēt jūsu datus pierakstīšanās kļūdas dēļ.</translation>
<translation id="6096348254544841612">Pielāgojiet un pārvaldiet pārlūku Monyhar. Ir pieejams atjauninājums.</translation>
<translation id="6120345080069858279">Pārlūks Monyhar saglabās šo paroli jūsu Google kontā. To nav nepieciešams iegaumēt.</translation>
<translation id="6129621093834146363">Fails <ph name="FILE_NAME" /> ir bīstams, tādēļ Monyhar to bloķēja.</translation>
<translation id="6134968993075716475">Droša pārlūkošana ir izslēgta. Pārlūkā Monyhar tiek ieteikts to ieslēgt.</translation>
<translation id="6145820983052037069">Šeit varat pārslēgties starp Monyhar profiliem.</translation>
<translation id="61577490437262925"><ph name="BEGIN_PARAGRAPH1" />Viss ir sagatavots Monyhar OS instalēšanai! Paveicot nākamas darbības, sagaidāmas tālāk norādītās izmaiņas.
          <ph name="BEGIN_LIST" />
          <ph name="LIST_ITEM" />Faili, dati un pašreizējā operētājsistēma tiks dzēsta.
          <ph name="LIST_ITEM" />Tiks instalēta operētājsistēma Monyhar OS.
          <ph name="LIST_ITEM" />Kad instalēšana būs pabeigta, ierīce tiks izslēgta.
          <ph name="END_LIST" />
          <ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />Atgādinām, ka instalēšanas laikā tiks izdzēsti visi dati cietajā diskā. Pārliecinieties, ka esat dublējis visus jums vajadzīgos datus.<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />Kad instalēšana būs sākta, to nevarēs atcelt.<ph name="END_PARAGRAPH3" /></translation>
<translation id="6183079672144801177">Ierīcē <ph name="TARGET_DEVICE_NAME" /> pierakstieties pārlūkā Monyhar un pēc tam vēlreiz mēģiniet veikt sūtīšanu.</translation>
<translation id="6212496753309875659">Šim datoram jau ir jaunākā Monyhar versija. Ja programmatūra nedarbojas, atinstalējiet pārlūku Monyhar un mēģiniet vēlreiz.</translation>
<translation id="6219195342503754812">{0,plural, =0{Pārlūks Monyhar tūlīt tiks restartēts}=1{Pārlūks Monyhar pēc 1 sekundes tiks restartēts}zero{Pārlūks Monyhar pēc # sekundēm tiks restartēts}one{Pārlūks Monyhar pēc # sekundes tiks restartēts}other{Pārlūks Monyhar pēc # sekundēm tiks restartēts}}</translation>
<translation id="6248213926982192922">Padarīt Monyhar par noklusējuma pārlūku</translation>
<translation id="6266342355635466082">Pārlūkprogrammā Monyhar nevar pārbaudīt atjauninājumu pieejamību. Pārbaudiet interneta savienojumu.</translation>
<translation id="6268381023930128611">Vai izrakstīties no Monyhar?</translation>
<translation id="6281746429495226318">Pielāgot Monyhar profilu</translation>
<translation id="6290827346642914212">Monyhar profila nosaukšana</translation>
<translation id="6295779123002464101">Fails <ph name="FILE_NAME" /> var būt bīstams, tādēļ Monyhar to bloķēja.</translation>
<translation id="6309712487085796862">Chrome saitē tiek izmantota kamera.</translation>
<translation id="6333502561965082103">Tiek veikta cita darbība pārlūkā Monyhar. Lūdzu, vēlāk mēģiniet vēlreiz.</translation>
<translation id="6334986366598267305">Tagad pārlūkā Monyhar ir vieglāk izmantot Google kontu, kā arī ir atvieglota lietošana datoros, ko izmanto vairākas personas.</translation>
<translation id="6373523479360886564">Vai tiešām vēlaties atinstalēt pārlūku Monyhar?</translation>
<translation id="6403826409255603130">Monyhar ir tīmekļa pārlūks, kas darbina tīmekļa lapas un lietojumprogrammas zibenīgā ātrumā. Tas ir ātrs, stabils un ērti lietojams. Pārlūkojiet tīmekli vēl drošāk ar aizsardzību pret ļaunprātīgu programmatūru un pikšķerēšanu, kas iebūvēta pārlūkā Monyhar.</translation>
<translation id="6434250628340475518">Monyhar OS sistēma</translation>
<translation id="6455857529632101747">Laipni lūdzam Monyhar profilos!</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Pārlūks Monyhar tiks restartēts pēc 1 sekundes.}zero{Pārlūks Monyhar tiks restartēts pēc # sekundēm.}one{Pārlūks Monyhar tiks restartēts pēc # sekundes.}other{Pārlūks Monyhar tiks restartēts pēc # sekundēm.}}</translation>
<translation id="646620589868199210">Sagatavotība Monyhar OS instalēšanai</translation>
<translation id="6475912303565314141">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Monyhar.</translation>
<translation id="6510925080656968729">Atinstalēt Monyhar</translation>
<translation id="6542839706527980775">Katrā profilā tiek glabāta attiecīgā Monyhar profila informācija, piemēram, grāmatzīmes, vēsture, paroles un citi dati.</translation>
<translation id="6570579332384693436">Lai izlabotu pareizrakstības kļūdas, Monyhar nosūta teksta laukos ievadīto tekstu Google serveriem.</translation>
<translation id="6598877126913850652">Pāriet uz Monyhar paziņojumu iestatījumiem</translation>
<translation id="6613594504749178791">Izmaiņas stāsies spēkā, kad restartēsiet Monyhar.</translation>
<translation id="6676384891291319759">Piekļūt internetam</translation>
<translation id="6717134281241384636">Jūsu profilu nevar izmantot, jo tas ir no jaunākas Monyhar versijas.

Dažas funkcijas var nebūt pieejamas. Norādiet citu profila direktoriju vai izmantojiet jaunāku Monyhar versiju.</translation>
<translation id="6734080038664603509">Atjaunināt &amp;Monyhar</translation>
<translation id="6734291798041940871">Pārlūks Monyhar jau ir instalēts visiem lietotājiem jūsu datorā.</translation>
<translation id="673636774878526923">Lai piekļūtu savam Monyhar saturam visās jūsu ierīcēs, pierakstieties un pēc tam ieslēdziet sinhronizāciju.</translation>
<translation id="6774082503108938489">Viens no jūsu vecākiem ir izslēdzis “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Monyhar. Nav atļauts iespējot šo: <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="6827182711503025204">Instalējot operētājsistēmu Monyhar OS, tiks pārrakstīti visi jūsu ierīcē esošie dati.</translation>
<translation id="6847869444787758381">Ja jūsu paroles kādreiz tiks apdraudētas, pārlūkā Monyhar saņemsiet paziņojumu</translation>
<translation id="6857782730669500492">Monyhar — <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (kopēts pārlūkā Monyhar)</translation>
<translation id="6893813176749746474">Pārlūks Monyhar ir atjaunināts, bet jūs neesat to izmantojis vismaz 30 dienas.</translation>
<translation id="691026815377248078">Pārlūkam Monyhar ir nepieciešama Bluetooth piekļuve, lai turpinātu savienošanu pārī. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">Atvērt saiti inko&amp;gnito režīma logā</translation>
<translation id="6978145336957848883">Nedrošas paroles ir viegli uzminēt. Pārlūkā Monyhar <ph name="BEGIN_LINK" />var automātiski veidot un iegaumēt drošas paroles jūsu kontiem<ph name="END_LINK" />.</translation>
<translation id="6990124437352146030">Pārlūkam Monyhar ir nepieciešama atļauja piekļūt jūsu mikrofonam šajā vietnē.</translation>
<translation id="705851970750939768">Atjaunināt Monyhar</translation>
<translation id="7067091210845072982">Ja attēlam nav vērtīga apraksta, pārlūks Monyhar mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google.</translation>
<translation id="7196312274710523067">Neizdevās palaist Monyhar. Mēģiniet vēlreiz.</translation>
<translation id="7197677400338048821">Pārlūkprogrammā Monyhar nevar pārbaudīt jūsu paroles. Mēģiniet vēlreiz pēc 24 stundām.</translation>
<translation id="7223968959479464213">Uzdevumu pārvaldnieks — Monyhar</translation>
<translation id="731644333568559921">Atjaunināt &amp;Monyhar OS</translation>
<translation id="731795002583552498">Notiek Monyhar atjaunināšana</translation>
<translation id="7318036098707714271">Jūsu preferenču fails ir bojāts vai nederīgs. Monyhar nespēj atkopt jūsu iestatījumus.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7339898014177206373">Jauns logs</translation>
<translation id="734373864078049451">Šeit atrodas jūsu tīmekļa saturs, grāmatzīmes un cits Monyhar saturs.</translation>
<translation id="7349591376906416160">Jūsu sistēmas administrators ir konfigurējis Monyhar atvērt <ph name="ALTERNATIVE_BROWSER_NAME" />, lai piekļūtu <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7448255348454382571">Monyhar OS restartēšana</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> — Monyhar izstrādātāju versija</translation>
<translation id="7451052299415159299">Pārlūkam Monyhar ir nepieciešama atļauja piekļūt jūsu kamerai šajā vietnē.</translation>
<translation id="7483335560992089831">Nevar instalēt to pašu Monyhar versiju, kas jau šobrīd darbojas. Aizveriet Monyhar un mēģiniet vēlreiz.</translation>
<translation id="753534427205733210">{0,plural, =1{Pārlūks Monyhar pēc 1 minūtes tiks restartēts}zero{Pārlūks Monyhar pēc # minūtēm tiks restartēts}one{Pārlūks Monyhar pēc # minūtes tiks restartēts}other{Pārlūks Monyhar pēc # minūtēm tiks restartēts}}</translation>
<translation id="7549178288319965365">Par Monyhar OS</translation>
<translation id="7561906087460245826">Notīrīt arī datus no Monyhar (<ph name="URL" />)</translation>
<translation id="7585853947355360626">Ja šajā lapā iestatījums nav pieejams, skatiet to sadaļā <ph name="LINK_BEGIN" />
      Monyhar OS iestatījumi<ph name="LINK_END" />.</translation>
<translation id="761356813943268536">Pārlūkā Monyhar tiek izmantota jūsu kamera un mikrofons.</translation>
<translation id="7617377681829253106">Pārlūkā Monyhar ir veikti uzlabojumi</translation>
<translation id="7627575518938382525"><ph name="BEGIN_PARAGRAPH1" />Pirms darba sākšanas pārliecinieties, ka jums ir atjaunināts jūsu datu dublējums. Instalējot operētājsistēmu Monyhar OS, tiks pārrakstīti visi cietajā diskā esošie dati.<ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />Google neuzņemas atbildību par datu zudumu un negarantē, ka operētājsistēma Monyhar OS darbosies nesertificētos modeļos. Lai uzzinātu vairāk par sertificētajiem modeļiem, apmeklējiet vietni [TBD].<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />Vairāk par Monyhar OS instalēšanu un datu dzēšanu varat uzzināt vietnē [TBD URL]<ph name="END_PARAGRAPH3" />
          <ph name="BEGIN_PARAGRAPH4" />Ja esat gatavs turpināt, noklikšķiniet uz vienuma ”Instalēt Monyhar OS” — pēc tam tiks parādīti norādījumi ar dažām vienkāršām instalēšanas darbībām. Pirms izmaiņu veikšanas datorā jums būs vēl viena iespēja apstiprināt savu izvēli.<ph name="END_PARAGRAPH4" /></translation>
<translation id="7686590090926151193">Monyhar nav jūsu noklusējuma pārlūks.</translation>
<translation id="7689606757190482937">Monyhar sinhronizēšana un personalizēšana visās savās ierīcēs</translation>
<translation id="7729447699958282447">Monyhar nevarēja sinhronizēt jūsu datus, jo jūsu domēnam nav pieejama sinhronizācija.</translation>
<translation id="7745317241717453663">Veicot šo darbību, no šīs ierīces tiks dzēsti pārlūkošanas dati. Lai vēlāk izgūtu datus, pierakstieties pārlūkā Monyhar kā <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">Instalētājam neizdevās izveidot pagaidu katalogu. Lūdzu, pārbaudiet, vai diskā pietiek vietas un vai ir atļauja instalēt programmatūru.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> — Monyhar Canary</translation>
<translation id="7828947555739565424">Šajā ierīcē jau pastāv Monyhar profils ar šādu kontu.</translation>
<translation id="7857220146454061152">Lai varētu saņemt nākamos Monyhar atjauninājumus, nepieciešama OS X 10.11 vai jaunāka versija. Šajā datorā tiek izmantota OS X 10.10 versija.</translation>
<translation id="7867198900892795913">Nevarēja atjaunināt uz jaunāko Monyhar versiju, tādēļ jūs nevarēsiet piekļūt jaunākajām funkcijām un drošības labojumiem.</translation>
<translation id="7898472181347242998">Lai pārbaudītu, vai ierīce ir atjaunināta, pārejiet uz sadaļu <ph name="LINK_BEGIN" />Monyhar OS iestatījumi<ph name="LINK_END" />.</translation>
<translation id="7907774600618164274">Monyhar OS netika pareizi izslēgta.</translation>
<translation id="7937630085815544518">Operētājsistēmā Monyhar iepriekš pierakstījāties kā lietotājs <ph name="USER_EMAIL_ADDRESS" />. Lai pierakstītos vēlreiz, lūdzu, izmantojiet to pašu kontu.</translation>
<translation id="7975919845073681630">Šī ir Monyhar papildu instalācija, un to nevar izmantot kā noklusējuma pārlūku.</translation>
<translation id="8013436988911883588">Tiklīdz pārlūkam Monyhar tiks sniegta piekļuve, vietnes varēs lūgt jums piekļuvi.</translation>
<translation id="81770708095080097">Šis fails ir bīstams, tāpēc Monyhar to bloķēja.</translation>
<translation id="8248265253516264921">Ja attēlam nav vērtīga apraksta, pārlūks Monyhar mēģinās jums tādu nodrošināt. Lai izveidotu aprakstus, attēli tiek nosūtīti uzņēmumam Google. Jebkurā brīdī iestatījumos varat izslēgt šo iespēju.</translation>
<translation id="8266560134891435528">Pārlūkprogrammā Monyhar nevar pārbaudīt jūsu paroles, jo jūs neesat pierakstījies.</translation>
<translation id="8276522524898344151">Monyhar mēģina nokopēt paroles.</translation>
<translation id="8290862415967981663">Šis fails var būt bīstams, tāpēc Monyhar to bloķēja.</translation>
<translation id="8330519371938183845">Pierakstieties, lai sinhronizētu un personalizētu pārlūku Monyhar visās savās ierīcēs.</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> iepriekš izmantoja Monyhar</translation>
<translation id="8417404458978023919">{0,plural, =1{Restartējiet pārlūku Monyhar vienas dienas laikā}zero{Restartējiet pārlūku Monyhar # dienu laikā}one{Restartējiet pārlūku Monyhar # dienas laikā}other{Restartējiet pārlūku Monyhar # dienu laikā}}</translation>
<translation id="8453117565092476964">Instalēšanas programmas arhīvs ir bojāts vai nav derīgs. Lejupielādējiet Monyhar vēlreiz.</translation>
<translation id="8493179195440786826">Monyhar versija ir novecojusi</translation>
<translation id="8550334526674375523">Šis darba profils ir pilnīgi nesaistīts ar jūsu personīgo profilu.</translation>
<translation id="8558383651099478961">Viens no jūsu vecākiem ir izslēdzis “Atļaujas vietnēm, lietotnēm un paplašinājumiem” pārlūkam Monyhar. Nav atļauts pievienot šo: <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="8568283329061645092">Pārlūkprogrammā Monyhar var pārbaudīt jūsu paroles, ja esat pierakstījies savā Google kontā.</translation>
<translation id="8586442755830160949">Autortiesības <ph name="YEAR" /> Monyhar autori. Visas tiesības paturētas.</translation>
<translation id="8619360774459241877">Notiek Monyhar palaišana...</translation>
<translation id="8621669128220841554">Instalēšana neizdevās nenoteiktas kļūdas dēļ. Lejupielādējiet pārlūku Monyhar vēlreiz.</translation>
<translation id="8697124171261953979">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Monyhar vai meklēsiet, izmantojot universālo lodziņu.</translation>
<translation id="8704119203788522458">Šis ir jūsu Monyhar</translation>
<translation id="8796602469536043152">Pārlūkam Monyhar ir nepieciešama atļauja piekļūt jūsu kamerai un mikrofonam šajā vietnē.</translation>
<translation id="8803635938069941624">Monyhar OS noteikumi</translation>
<translation id="8821041990367117597">Monyhar nevarēja sinhronizēt jūsu datus, jo jūsu konta pierakstīšanās informācija ir novecojusi.</translation>
<translation id="8862326446509486874">Jums nav vajadzīgo tiesību, lai instalētu sistēmas līmenī. Mēģiniet vēlreiz palaist instalēšanas programmu kā administrators.</translation>
<translation id="8880203542552872219">Ja tā ir, lūdzu, rediģējiet saglabāto paroli pārlūkprogrammā Monyhar, lai tā atbilstu jūsu jaunajai parolei.</translation>
<translation id="8897323336392112261">Tas nosaka arī to, kāda lapa tiks rādīta, kad atvērsiet pārlūku Monyhar vai noklikšķināsiet uz pogas “Sākums”.</translation>
<translation id="8907580949721785412">Monyhar mēģina rādīt paroles. Lai to atļautu, ierakstiet savu Windows paroli.</translation>
<translation id="8941642502866065432">Nevar atjaunināt Monyhar</translation>
<translation id="8974095189086268230">Chrome OS ir kļuvusi iespējama, pateicoties papildu <ph name="BEGIN_LINK_CROS_OSS" />atklātā pirmkoda programmatūrai<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="8986207147630327271">Jūs pievienosiet šai pārlūkprogrammai darba profilu un piešķirsiet administratoram kontroli tikai pār darba profilu.</translation>
<translation id="9019929317751753759">Lai uzlabotu Monyhar drošību, mēs atspējojām tālāk norādīto paplašinājumu, kas nav norādīts vietnē <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> un, iespējams, tika pievienots, jums nezinot.</translation>
<translation id="9047197236183657400">Vai pārvietot kontu uz jaunu Monyhar profilu?</translation>
<translation id="9089354809943900324">Monyhar versija ir novecojusi.</translation>
<translation id="9093206154853821181">{0,plural, =1{Pārlūks Monyhar pēc stundas tiks restartēts}zero{Pārlūks Monyhar pēc # stundām tiks restartēts}one{Pārlūks Monyhar pēc # stundas tiks restartēts}other{Pārlūks Monyhar pēc # stundām tiks restartēts}}</translation>
<translation id="91086099826398415">Atvērt saiti jaunā Monyhar &amp;cilnē</translation>
<translation id="911206726377975832">Vai dzēst arī pārlūkošanas datus?</translation>
<translation id="9158494823179993217">Sistēmas administrators ir konfigurējis Monyhar, lai vietne <ph name="TARGET_URL_HOSTNAME" /> tiktu atvērta papildu pārlūkā.</translation>
<translation id="9185526690718004400">Atkārtoti palaist, lai atjauninātu &amp;Monyhar</translation>
<translation id="9190841055450128916">Monyhar (mDNS ienākošie savienojumi)</translation>
<translation id="9214764063801632699">Monyhar OS sistēma</translation>
<translation id="93478295209880648">Iespējams, Monyhar nedarbosies pareizi, jo tas vairs netiek atbalstīts operētājsistēmās Windows XP un Windows Vista.</translation>
<translation id="965162752251293939">Kas izmanto pārlūku Monyhar?</translation>
<translation id="985602178874221306">Monyhar autori</translation>
</translationbundle>