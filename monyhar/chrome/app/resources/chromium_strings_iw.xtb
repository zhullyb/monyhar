<translation id="7585853947355360626">‏אם הגדרה מסוימת לא מופיעה בדף הזה, אפשר לחפש אותה <ph name="LINK_BEGIN" />
בהגדרות ה-OS של Monyhar<ph name="LINK_END" /></translation>
<translation id="761356813943268536">‏Monyhar משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="7617377681829253106">‏Monyhar השתפר</translation>
<translation id="7627575518938382525">‏<ph name="BEGIN_PARAGRAPH1" />לפני שנתחיל, חשוב לוודא שיש לך גיבוי עדכני של הנתונים שלך. התקנת מערכת ההפעלה Monyhar תוביל להחלפת כל הנתונים שבכונן הקשיח.<ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />‏Google לא נושאת באחריות לאובדן נתונים כלשהו. בנוסף, היא לא מבטיחה שמערכת ההפעלה Monyhar תפעל בדגמים שאינם מאושרים. מידע נוסף לגבי דגמים מאושרים זמין ב-[TBD].<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />פרטים נוספים על התקנת מערכת ההפעלה Monyhar ומחיקת נתונים: [TBD URL]<ph name="END_PARAGRAPH3" />
          <ph name="BEGIN_PARAGRAPH4" />אם ברצונך להמשיך, עליך ללחוץ על "התקנת מערכת ההפעלה Monyhar" ומשם נדריך אותך לאורך תהליך ההתקנה במספר שלבים פשוטים. תהיה לך אפשרות לאשר פעם נוספת לפני שנבצע שינויים במחשב.<ph name="END_PARAGRAPH4" /></translation>
<translation id="7686590090926151193">‏Monyhar אינו דפדפן ברירת המחדל שלך</translation>
<translation id="7689606757190482937">‏סנכרון והתאמה אישית של Monyhar בכל המכשירים שברשותך</translation>
<translation id="7729447699958282447">‏Monyhar לא הצליח לסנכרן את הנתונים שלך מפני שסנכרון אינו זמין עבור הדומיין שלך.</translation>
<translation id="7745317241717453663">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Monyhar עם <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="7790626492778995050">‏<ph name="PAGE_TITLE" /> – Monyhar בגרסת Canary</translation>
<translation id="7828947555739565424">‏כבר קיים במכשיר פרופיל Monyhar עם החשבון הזה.</translation>
<translation id="7857220146454061152">‏כדי לקבל עדכונים של Monyhar בעתיד, נדרשת מערכת הפעלה OS X 10.11 ואילך. במחשב הזה מותקנת מערכת ההפעלה OS X 10.10.</translation>
<translation id="7867198900892795913">‏עדכון Monyhar לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="7898472181347242998">‏כדי לראות אם המכשיר שלך מעודכן, יש לעבור אל <ph name="LINK_BEGIN" />הגדרות Monyhar OS<ph name="LINK_END" /></translation>
<translation id="7907774600618164274">‏כיבוי Monyhar OS לא בוצע כהלכה.</translation>
<translation id="7937630085815544518">‏נכנסת ל-Monyhar כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="7975919845073681630">‏זוהי התקנה משנית של Monyhar, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="8013436988911883588">‏אחרי מתן גישה ל-Monyhar, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="81770708095080097">‏Monyhar‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8248265253516264921">‏אם אין לתמונה תיאור מועיל, Monyhar ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Google. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="8266560134891435528">‏Monyhar לא יכול לבדוק את הסיסמאות שלך כי לא נכנסת לחשבון</translation>
<translation id="8276522524898344151">‏Monyhar מנסה להעתיק את הסיסמאות.</translation>
<translation id="8290862415967981663">‏Monyhar‏ חסם את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="8330519371938183845">‏כניסה לחשבון תסנכרן ותתאים אישית את Monyhar בכל המכשירים שברשותך</translation>
