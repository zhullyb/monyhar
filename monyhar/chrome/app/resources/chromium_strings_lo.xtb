<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="1065672644894730302">ບໍ່ສາມາດອ່ານຄວາມມັກຂອງທ່ານໄດ້.

ບາງຄຸນສົມບັດ​ອາດຈະບໍ່ມີໃຫ້ ແລະການປ່ຽນແປງຕໍ່ຄວາມມັກຈະບໍ່ຖືກບັນທຶກ.</translation>
<translation id="1098170124587656448">Monyhar ສາມາດຊ່ວຍຮັກສາໃຫ້ທ່ານປອດໄພຈາກການລະເມີດຂໍ້ມູນ, ສ່ວນຂະຫຍາຍທີ່ບໍ່ດີ ແລະ ອື່ນໆອີກໄດ້</translation>
<translation id="1104942323762546749">Monyhar ຕ້ອງການສົ່ງອອກລະຫັດຜ່ານຂອງທ່ານ. ກະລຸນາພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດສິ່ງນີ້.</translation>
<translation id="113122355610423240">Monyhar ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="1131805035311359397">ເພື່ອກວດເບິ່ງວ່າລະຫັດຜ່ານຂອງທ່ານປອດໄພຈາກການລະເມີດຂໍ້ມູນ ແລະ ບັນຫາຄວາມປອດໄພອື່ນຫຼືບໍ່, ກະລຸນາ <ph name="BEGIN_LINK" />ເຂົ້າສູ່ລະບົບ Monyhar<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">ກ່ຽວ​ກັບ Monyhar</translation>
<translation id="1315551408014407711">ຕັ້ງຄ່າໂປຣໄຟລ໌ Monyhar ໃໝ່ຂອງທ່ານ</translation>
<translation id="1396446129537741364">Monyhar ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ.</translation>
<translation id="1414495520565016063">ທ່ານ​ລົງຊື່ເຂົ້າ​ໃຊ້ Monyhar ແລ້ວ​!</translation>
<translation id="151962892725702025">Monyhar OS ບໍ່​ສາ​ມາດຊິງຄ໌ຂໍ້​ມູນ​ຂອງ​ທ່ານໄດ້ ເພາະວ່າບໍ່ມີການຊິງຄ໌ຢູ່ໃນໂດເມນຂອງທ່ານ.</translation>
<translation id="1524282610922162960">ແບ່ງປັນແຖບ Monyhar</translation>
<translation id="1553461853655228091">Monyhar ຕ້ອງການການອະນຸຍາດເພື່ອເຂົ້າເຖິງກ້ອງຂອງທ່ານເພື່ອສ້າງແຜນທີ່ 3 ມິຕິຂອງສະພາບແວດລ້ອມອ້ອມຂ້າງຂອງທ່ານ</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Monyhar ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Monyhar ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານກຳນົດໃຫ້ທ່ານເປີດ Monyhar ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="1708666629004767631">ມີ Monyhar ລຸ້ນໃໝ່ປອດໄພກ່ວາຢູ່.</translation>
<translation id="1774152462503052664">ປ່ອຍໃຫ້ Monyhar ແລ່ນຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="1779356040007214683">ເພື່ອເຮັດໃຫ້ Monyhar ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນຂະຫຍາຍທີ່ບໍ່ໄດ້ມີລາຍຊື່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະອາດຈະຖືກເພີ່ມເຂົ້າໂດຍທີ່ທ່ານບໍ່ຮູ້ຈັກ.</translation>
<translation id="1808667845054772817">ຕິດຕັ້ງ Monyhar ຄືນໃໝ່</translation>
<translation id="1881322772814446296">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ Monyhar ຂອງທ່ານ. ຂໍ້ມູນ Monyhar ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. ​ໂດຍ​ເລືອກ​ໄດ້ ທ່ານ​ສາມາດ​ສ້າງໂປຣໄຟລ໌​ໃໝ່​ເພື່ອ​ຮັກສາ​ຂໍ້ມູນ Monyhar ທີ່​ມີ​ຢູ່​ຂອງ​ທ່ານ​ແຍກ​ຕ່າງຫາກ. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">ໂດຍການປິດສິ່ງນີ້, ທ່ານສາມາດເຂົ້າສູ່ລະບົບເວັບໄຊຂອງ Google ເຊັ່ນ: Gmail ໄດ້ໂດຍບໍ່ຕ້ອງເຂົ້າສູ່ລະບົບ Monyhar</translation>
<translation id="1929939181775079593">Monyhar ບໍ່ຕອບຮັບ. ເລີ່ມເປີດໃຊ້ໃໝ່ດຽວນີ້ບໍ?</translation>
<translation id="1966382378801805537">Monyhar ບໍ່ສາມາດກຳນົດ ຫຼື ຕັ້ງໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້</translation>
<translation id="1981611865800294956">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Monyhar OS</translation>
<translation id="2008474315282236005">ນີ້ຈະລຶບ 1 ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Monyhar ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="2020032459870799438">ເພື່ອກວດເບິ່ງວ່າລະຫັດຜ່ານອື່ນຂອງທ່ານປອດໄພຈາກການລະເມີດຂໍ້ມູນ ແລະ ບັນຫາຄວາມປອດໄພອື່ນຫຼືບໍ່, ກະລຸນາ <ph name="BEGIN_LINK" />ເຂົ້າສູ່ລະບົບ Monyhar<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">ປັບແຕ່ງ Monyhar</translation>
<translation id="2185166961232948079">Monyhar - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">ຖ້າທ່ານແຊຣ໌ຄອມພິວເຕີ, ໝູ່​ເພື່ອນ ແລະຄອບຄົວຂອງທ່ານ ສາມາດທ່ອງເນັດໄດ້ແຍກຕ່າງຫາກ ແລະຕັ້ງ Monyhar ໄດ້ຕາມ​ແບບທີ່ພວກເຂົາຕ້ອງການ.</translation>
<translation id="2294245788148774212">ບໍ່ບັງຄັບ: ຊ່ວຍປັບປຸງຄຸນສົມບັດ ແລະ ປະສິດທິພາບຂອງ Monyhar OS ໂດຍການສົ່ງຂໍ້ມູນການວິເຄາະ ແລະ ການນຳໃຊ້ໃຫ້ Google ໂດຍອັດຕະໂນມັດ.</translation>
<translation id="2343156876103232566">ເພື່ອສົ່ງເບີຈາກບ່ອນນີ້ໃຫ້ໂທລະສັບ Android ຂອງທ່ານ, ກະລຸນາເຂົ້າສູ່ລະບົບ Monyhar ຢູ່ໃນທັງສອງອຸປະກອນ.</translation>
<translation id="2347108572062610441">ສ່ວນຂະຫຍາຍ​ນີ້​ໄດ້ປ່ຽນສິ່ງທີ່ໜ້າສະແດງຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນ Monyhar​.</translation>
<translation id="2396765026452590966">ສ່ວນຂະຫຍາຍ "<ph name="EXTENSION_NAME" />" ໄດ້ປ່ຽນສິ່ງທີ່ໜ້າສະແດງຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນ Monyhar​.</translation>
<translation id="2483889755041906834">ໃນ Monyhar</translation>
<translation id="2485422356828889247">ຖອນ​ຕິດ​ຕັ້ງ</translation>
<translation id="2535480412977113886">Monyhar OS ບໍ່​ສາ​ມາດຊິງຄ໌ຂໍ້​ມູນ​ຂອງ​ທ່ານໄດ້ ​ເພາະ​ວ່າ​ລາຍລະອຽດການລົງຊື່ເຂົ້າບັນ​ຊີຂອງທ່ານຫຼ້າສະໄໝແລ້ວ.</translation>
<translation id="2560420686485554789">Monyhar ຕ້ອງການເຂົ້າເຖິງບ່ອນເກັບຂໍ້ມູນເພື່ອດາວໂຫຼດໄຟລ໌</translation>
<translation id="2572494885440352020">ຜູ້​ຊ່ວຍ Monyhar</translation>
<translation id="2577788541081224677">ເພື່ອເຂົ້າເຖິງຂໍ້ມູນ Monyhar ຂອງທ່ານໃນອຸປະກອນທັງໝົດຂອງທ່ານ, ກະລຸນາເຂົ້າສູ່ລະບົບເພື່ອໃຫ້ທ່ານສາມາດເປີດການຊິ້ງຂໍ້ມູນໄດ້.</translation>
<translation id="2580426763510374355">ຕິດຕັ້ງ Monyhar OS</translation>
<translation id="2583187216237139145">ຜູ້ເບິ່ງແຍງລະບົບໂປຣໄຟລ໌ບ່ອນເຮັດວຽກສາມາດລຶບຂໍ້ມູນ Monyhar ໃດໆກໍຕາມທີ່ສ້າງຂຶ້ນໃນລະຫວ່າງການນຳໃຊ້ໂປຣໄຟລ໌ນີ້ (ເຊັ່ນ: ການສ້າງບຸກມາກ, ປະຫວັດ, ລະຫັດຜ່ານ ແລະ ການຕັ້ງຄ່າອື່ນໆ) ອອກໄດ້. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">ຈຳເປັນຕ້ອງປິດແລ້ວເປີດ Monyhar OS ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດ.</translation>
<translation id="2648074677641340862">ເກີດຄວາມຜິດພາດດ້ານລະບົບປະຕິບັດການໃນລະຫວ່າງການຕິດຕັ້ງ. ກະລຸນາດາວໂຫຼດ Monyhar ອີກ.</translation>
<translation id="2661879430930417727">ຖ້າທ່ານໃຊ້ອຸປະກອນຮ່ວມກັນ, ໝູ່ ແລະ ຄອບຄົວສາມາດທ່ອງເວັບແຍກຕ່າງຫາກ ແລະ ຕັ້ງຄ່າ Monyhar ໃນແບບທີ່ເຂົາເຈົ້າຕ້ອງການໄດ້</translation>
<translation id="2711502716910134313">ແຖບ Monyhar</translation>
<translation id="2718390899429598676">ເພື່ອຄວາມປອດໄພເພີ່ມເຕີມ, Monyhar ຈະເຂົ້າລະຫັດຂໍ້ມູນຂອງທ່ານ.</translation>
<translation id="2770231113462710648">ປ່ຽນບຣາວ​ເຊີມາດຕະຖານເປັນ:</translation>
<translation id="2799223571221894425">ເລີ່ມເປີດໃຊ້ໃໝ່</translation>
<translation id="2816712596130903444">ແຍກໂປຣໄຟລ໌ Monyhar ໄວ້ຕ່າງຫາກບໍ?</translation>
<translation id="2837693172913560447">ນີ້ຈະເປັນການສ້າງໂປຣໄຟລ໌ Monyhar ໃໝ່ສຳລັບ <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="2847479871509788944">ເອົາ​ອອກ​ຈາກ Monyhar...</translation>
<translation id="2885378588091291677">ຕົວຈັດການໜ້າວຽກ</translation>
<translation id="2910007522516064972">ກ່ຽວ​ກັບ​ Monyhar</translation>
<translation id="2977470724722393594">Monyhar ແມ່ນເວີຊັນໃໝ່ຫຼ້າສຸດແລ້ວ</translation>
<translation id="2983934633046890458">Monyhar ກຳລັງພະຍາຍາມແກ້ໄຂລະຫັດຜ່ານ.</translation>
<translation id="3032706164202344641">Monyhar ບໍ່ສາມາດກວດລະຫັດຜ່ານຂອງທ່ານໄດ້. ກະລຸນາລອງໃໝ່ໃນພາຍຫລັງ.</translation>
<translation id="3032787606318309379">ກໍາລັງເພີ່ມ Monyhar...</translation>
<translation id="3068515742935458733">ຊ່ວຍເຮັດໃຫ້ Monyhar ດີຂຶ້ນໂດຍການສົ່ງລາຍງານການ​ຂັດຂ້ອງ ແລະ  <ph name="UMA_LINK" />  ຫາ Google.</translation>
<translation id="3103660991484857065">ຕົວຕິດຕັ້ງບໍ່ສາມາດ​ຄາຍ​ການບີບອັດຄັງເກັບມ້ຽນ. ກະລຸນາດາວໂຫຼດ Monyhar ອີກ.</translation>
<translation id="3130323860337406239">Monyhar ກໍາລັງໃຊ້​ໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="3155163173539279776">ປິດແລ້ວເປີດ Monyhar ຄືນໃໝ່</translation>
<translation id="3179665906251668410">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Monyhar</translation>
<translation id="3185330573522821672">ປັບແຕ່ງໂປຣໄຟລ໌ Monyhar ໃໝ່ຂອງທ່ານ</translation>
<translation id="3190315855212034486">ໂຮ້! Monyhar ​ເກີດ​ຂັດຂ້ອງ. ເປີດໃຊ້ໃໝ່ດຽວນີ້ບໍ?</translation>
<translation id="3229526316128325841">Monyhar ຕ້ອງການສົ່ງອອກລະຫັດຜ່ານຂອງທ່ານ.</translation>
<translation id="3258596308407688501">Monyhar ບໍ່ສາມາດອ່ານ ແລະຂຽນໄປໃສ່ໄດເຣັກຕໍຣີຂໍ້ມູນຂອງມັນໄດ້:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">ຕິດຕັ້ງ Monyhar ເວີຊັນ <ph name="PRODUCT_VERSION" /> ແລ້ວ</translation>
<translation id="328888136576916638">ລະຫັດ Google API ຫາຍໄປ. ການເຮັດໜ້າທີ່ບາງອັນຂອງ Monyhar ຈະປິດໃຊ້ງານ.</translation>
<translation id="3296368748942286671">ສືບຕໍ່ແລ່ນແອັບພື້ນຫຼັງ ເມື່ອ Monyhar ປິດ</translation>
<translation id="331951419404882060">Monyhar OS ບໍ່ສາມາດຊິງຄ໌ຂໍ້ມູນຂອງທ່ານໄດ້ ເນື່ອງຈາກການລົງຊື່ເຂົ້າ​ໃຊ້ຜິດພາດ.</translation>
<translation id="3350761136195634146">ມີໂປຣໄຟລ໌ Monyhar ກັບບັນຊີນີ້ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="3406848076815591792">ສະຫຼັບເປັນໂປຣໄຟລ໌ Monyhar ທີ່ມີຢູ່ກ່ອນແລ້ວບໍ?</translation>
<translation id="3430503420100763906">ດ້ວຍໂປຣໄຟລ໌ Monyhar ທ່ານສາມາດແຍກເນື້ອຫາ Monyhar ຂອງທ່ານທັງໝົດໄດ້. ສ້າງໂປຣໄຟລ໌ສຳລັບໝູ່ ແລະ ຄອບຄົວ ຫຼື ແຍກຈາກກັນລະຫວ່າງວຽກ ແລະ ຄວາມມ່ວນ.</translation>
<translation id="3433271666494956603">ກຳລັງຕິດຕັ້ງ Monyhar OS ຢູ່</translation>
<translation id="347328004046849135">Monyhar ຈະແຈ້ງບອກທ່ານເມື່ອທ່ານເຂົ້າສູ່ລະບົບດ້ວຍລະຫັດຜ່ານທີ່ຖືກລະເມີດ</translation>
<translation id="3474745554856756813">ນີ້ຈະລຶບ <ph name="ITEMS_COUNT" /> ລາຍການອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Monyhar ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> ສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ Monyhar ໄດ້</translation>
<translation id="3509308970982693815">ກະລຸນາປິດທຸກໜ້າຕ່າງ Monyhar ແລະລອງໃໝ່ອີກ.</translation>
<translation id="3575459661164320785">ມີຊອບແວອັນຕະລາຍໃນຄອມພິວເຕີຂອງທ່ານ. Monyhar ສາມາດລຶບມັນອອກ, ກູ້ຄືນການຕັ້ງຄ່າຂອງທ່ານ ແລະ ປິດນໍາໃຊ້ສ່ວນຂະຫຍາຍເພື່ອເຮັດໃຫ້ໂປຣແກຣມທ່ອງເວັບຂອງທ່ານໃຊ້ໄດ້ເປັນປົກກະຕິອີກຄັ້ງ.</translation>
<translation id="3610776674893128619">ລຶບຮາດໄດຣຟ໌ ແລະ ຕິດຕັ້ງ Monyhar OS</translation>
<translation id="3639635944603682591">ຂໍ້ມູນການທ່ອງເວັບຂອງບຸກຄົນນີ້ຈະຖືກລຶບອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຄືນມາ, ກະລຸນາເຂົ້າສູ່ລະບົບ Monyhar ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{ມີການອັບເດດໃໝ່ສຳລັບ Monyhar ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່.}=1{ມີການອັບເດດໃໝ່ສຳລັບ Monyhar ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ມີການອັບເດດໃໝ່ສຳລັບ Monyhar ແລະ ຈະນຳໃຊ້ໃນທັນທີທີ່ທ່ານເປີດໃຊ້ຄືນໃໝ່. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="3651803019964686660">ເພື່ອສົ່ງເບີຈາກ <ph name="ORIGIN" /> ໃຫ້ໂທລະສັບ Android ຂອງທ່ານ, ກະລຸນາເຂົ້າສູ່ລະບົບ Monyhar ຢູ່ໃນທັງສອງອຸປະກອນ.</translation>
<translation id="3685209450716071127">Monyhar ບໍ່ສາມາດກວດລະຫັດຜ່ານຂອງທ່ານໄດ້. ລອງກວດເບິ່ງການເຊື່ອມຕໍ່ອິນເຕີເນັດຂອງທ່ານ.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Monyhar ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້}=1{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Monyhar ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານຈະບໍ່ເປີດຄືນໃໝ່.}other{ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຮ້ອງຂໍໃຫ້ທ່ານເປີດ Monyhar ຄືນໃໝ່ເພື່ອນຳໃຊ້ການອັບເດດນີ້. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຂອງທ່ານ # ລາຍການຈະບໍ່ເປີດຄືນໃໝ່.}}</translation>
<translation id="371088601698879021">Monyhar OS ສາມາດກູ້ຄືນແອັບ ແລະ ໜ້າຂອງທ່ານໄດ້ຫຼັງຈາກການປິດເປີດຄືນໃໝ່ໂດຍບໍ່ຕ້ອງຖາມໃນແຕ່ລະຄັ້ງ.</translation>
<translation id="3713809861844741608">ເປີດລິ້ງໃນແຖບ Monyhar ໃໝ່</translation>
<translation id="3728336900324680424">Monyhar ຈະເຂົ້າເຖິງ Drive ຂອງທ່ານເພື່ອໃຫ້ຄຳແນະນຳໃນແຖບທີ່ຢູ່</translation>
<translation id="378917192836375108">Monyhar ເຮັດໃຫ້ທ່ານຄລິກເບີໂທລະສັບຢູ່ໃນເວັບ ແລະ ໂທມັນດ້ວຍ Skype ໄດ້!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Monyhar</translation>
<translation id="388648406173476553">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Monyhar. ມີບາງຢ່າງທີ່ທ່ານຕ້ອງດຳເນີນການ - ຄລິກສຳລັບລາຍລະອຽດ.</translation>
<translation id="3889543394854987837">ຄລິກ​ທີ່​ຊື່​ຂອງ​ທ່ານ​ເພື່ອ​ເປີດ Monyhar ແລະ​ເລີ່ມ​ຕົ້ນທ່ອງເນັດ.</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບໂປຣໄຟລ໌ Monyhar ນີ້ຢູ່ກ່ອນແລ້ວ. ເພື່ອແຍກການທ່ອງເວັບຂອງທ່ານໄວ້ຕ່າງຫາກ, Monyhar ສາມາດສ້າງໂປຣໄຟລ໌ຂອງທ່ານເອງໃຫ້ທ່ານໄດ້.</translation>
<translation id="3945058413678539331">Monyhar ກໍາລັງພະຍາຍາມສຳເນົາລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="4036079820698952681">ຊ່ວຍເຮັດໃຫ້ Monyhar ດີຂຶ້ນໂດຍການລາຍງານ <ph name="BEGIN_LINK" />ການຕັ້ງຄ່າປັດຈຸບັນ<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">ການ​ປັບ​ປຸງ​ຄວາມ​ປອດ​ໄພ​ທີ່​ສຳ​ຄັນ ແລະ​ຄຸນ​ສົມ​ບັດ​ໃໝ່​ມີ​ໃຫ້​ຢູ່​ໃນ​ເວີ​ຊັນ​ຫຼ້າ​ສຸດ.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ - Monyhar</translation>
<translation id="421369550622382712">ຄົ້ນພົບແອັບ, ເກມ, ສ່ວນຂະຫຍາຍ ແລະ ຮູບແບບສີສັນສຳລັບ Monyhar.</translation>
<translation id="4216212958613226427">ລະບົບໃຊ້ພາສານີ້ເພື່ອສະແດງສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ Monyhar</translation>
<translation id="4230135487732243613">ລິ້ງ Monyhar ຂອງ​ທ່ານກັບບັນຊີນີ້ບໍ?</translation>
<translation id="4264410486868823224"><ph name="MANAGER" /> ກຳນົດໃຫ້ທ່ານອ່ານ ແລະ ຍອມຮັບຂໍ້ກຳນົດການບໍລິການຕໍ່ໄປນີ້ກ່ອນທີ່ຈະໃຊ້ອຸປະກອນນີ້. ຂໍ້ກຳນົດການບໍລິການເຫຼົ່ານີ້ບໍ່ຂະຫຍາຍ, ປ່ຽນແປງ ຫຼື ຈຳກັດຂໍ້ກຳນົດຂອງ Monyhar OS.</translation>
<translation id="4271805377592243930">ຂໍຄວາມຊ່ວຍເຫຼືອເລື່ອງ Monyhar</translation>
<translation id="4285930937574705105">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ​ອັນ ​ເນື່ອງ​ມາ​ຈາກ​ຄວາມ​ຜິດພາດທີ່ບໍ່ລະບຸໄວ້​. ຖ້າ Monyhar ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​, ກະ​ລຸ​ນາ​ປິດ​ມັນ ​ແລະ​ລອງໃໝ່​ອີກ​.</translation>
<translation id="4407044323746248786">ຢືນຢັນການອອກຈາກ Monyhar ບໍ?</translation>
<translation id="4415566066719264597">ໃຫ້ Monyhar ເປີດໃຊ້ຢູ່ໃນພື້ນຫຼັງ</translation>
<translation id="4423735387467980091">ກໍານົດໃຊ້ ແລະ​ຄວບ​ຄຸມ Monyhar</translation>
<translation id="4491398312037323794">ໜ້ານີ້ອະນຸຍາດໃຫ້ທ່ານຈັດການບັນຊີ Google ທີ່ເຂົ້າສູ່ລະບົບຂອງທ່ານ. ບັນຊີຂອງທ່ານຈະມີໃຫ້ນຳໃຊ້ໃນໂປຣແກຣມທ່ອງເວັບ Monyhar ແລະ Play Store, ເຊັ່ນດຽວກັບການບໍລິການຕ່າງໆ ເຊັ່ນ: Gmail, Drive ແລະ YouTube. <ph name="LINK_BEGIN" />ສຶກສາເພີ່ມເຕີມ<ph name="LINK_END" /></translation>
<translation id="452711251841752011">ຍິນດີຕ້ອນຮັບສູ່ Monyhar; ເປີດໜ້າຈໍໂປຣແກຣມທ່ອງເວັບໃໝ່ແລ້ວ</translation>
<translation id="4544142686420020088">Monyhar ບໍ່ອັບເດດ, ມີບາງຢ່າງຜິດພາດ. <ph name="BEGIN_LINK" />ແກ້ໄຂບັນຫາການອັບເດດ Monyhar ແລະ ການອັບເດດທີ່ບໍ່ສຳເລັດ.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">ສືບຕໍ່ໃນໂປຣໄຟລ໌ Monyhar ໃໝ່ບໍ?</translation>
<translation id="4567424176335768812">ທ່ານລົງຊື່ເຂົ້າ​ໃຊ້ເປັນ <ph name="USER_EMAIL_ADDRESS" />. ດຽວນີ້ທ່ານສາມາດເຂົ້າຫາບຸກມາກສ໌, ປະຫວັດ, ແລະການຕັ້ງຄ່າອື່ນຢູ່ໃນທຸກອຸປະກອນທີ່ລົງຊື່ເຂົ້າ​ໃຊ້ຂອງທ່ານ.</translation>
<translation id="459535195905078186">ແອັບ Monyhar</translation>
<translation id="4665829708273112819">ຄຳເຕືອນ: Monyhar ບໍ່ສາມາດປ້ອງກັນສ່ວນຂະຫຍາຍບໍ່ໃຫ້ບັນທຶກປະຫວັດການທ່ອງເວັບຂອງທ່ານໄດ້. ເພື່ອປິດການນຳໃຊ້ສ່ວນຂະຫຍາຍນີ້ໃນໂໝດທີ່ບໍ່ເປີດເຜີຍຕົວຕົນ, ກະລຸນາບໍ່ເລືອກຕົວເລືອກນີ້.</translation>
<translation id="4677944499843243528">ປະກົດວ່າໂປຣໄຟລ໌ໃຊ້ງານຢູ່ໂດຍຂະບວນການ Monyhar ອື່ນ (<ph name="PROCESS_ID" />) ຢູ່ໃນຄອມພິວເຕີອື່ນ (<ph name="HOST_NAME" />). Monyhar ໄດ້ລັອກໂປຣໄຟລ໌ໄວ້ ເພື່ອບໍ່ໃຫ້ມັນໄດ້ຮັບການ​ຂັດຂ້ອງ. ຖ້າທ່ານແນ່ໃຈວ່າ ບໍ່ມີຂະບວນການອື່ນໃຊ້ໂປຣໄຟລ໌ນີ້ຢູ່, ທ່ານສາມາດປົດລັອກໂປຣໄຟລ໌ ແລະເລີ່ມເປີດໃຊ້ Monyhar ໃໝ່ໄດ້.</translation>
<translation id="469338717132742108">ຂໍຄວາມຊ່ວຍເຫຼືອເລື່ອງ Monyhar OS</translation>
<translation id="4708774505295300557">ຄົນອື່ນເຄີຍເຂົ້າສູ່ລະບົບ Monyhar ໃນຄອມພິວເຕີນີ້ເປັນ <ph name="ACCOUNT_EMAIL_LAST" /> ມາກ່ອນແລ້ວ. ກະລຸນາສ້າງຜູ້ໃຊ້ Monyhar ໃໝ່ເພື່ອເກັບຂໍ້ມູນຂອງທ່ານໃຫ້ແຍກກັນຕ່າງຫາກ.</translation>
<translation id="4746050847053251315">ຢືນຢັນການອອກຈາກ Monyhar ບໍ?</translation>
<translation id="4748217263233248895">ຫາກໍນຳໃຊ້ການອັບເດດຄວາມປອດໄພພິເສດສຳລັບ Monyhar ແລ້ວ. ກະລຸນາປິດເປີດໃໝ່ຕອນນີ້ເລີຍ ແລ້ວພວກເຮົາຈະກູ້ຄືນແຖບຂອງທ່ານ.</translation>
<translation id="4750035648288509542">ເກືອບໃໝ່ຫຼ້າສຸດແລ້ວ! ເປີດໃຊ້ Monyhar ຄືນໃໝ່ເພື່ອສຳເລັດການອັບເດດ. ໜ້າຈໍທີ່ບໍ່ເປີດເຜີຍຕົວຕົນຈະບໍ່ເປີດຄືນໃໝ່.</translation>
<translation id="4788777615168560705">Monyhar ບໍ່ສາມາດກວດລະຫັດຜ່ານຂອງທ່ານໄດ້. ລອງໃໝ່ຫຼັງຈາກ 24 ຊົ່ວໂມງ ຫຼື <ph name="BEGIN_LINK" />ກວດລະຫັດຜ່ານໃນບັນຊີ Google ຂອງທ່ານ<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">ນີ້ໃຊ້ຕົວກວດການສະກົດຄໍາດຽວກັນກັບທີ່ໃຊ້ໃນ Google ຊອກຫາ. ຂໍ້ຄວາມທີ່ທ່ານພິມໃນໂປຣແກຣມທ່ອງເວັບຖືກສົ່ງໃຫ້ Google. ທ່ານສາມາດປ່ຽນລັກສະນະການນໍາໃຊ້ນີ້ໄດ້ສະເໝີໃນການຕັ້ງຄ່າ.</translation>
<translation id="4888717733111232871">ກົດລະບຽບຂາເຂົ້າສໍາລັບ Monyhar ເພື່ອອະນຸຍາດການຈາລະຈອນ mDNS.</translation>
<translation id="4893347770495441059">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Monyhar</translation>
<translation id="4943838377383847465">Monyhar ຢູ່ໃນໂໝດພື້ນຫຼັງ.</translation>
<translation id="4987820182225656817">ແຂກສາມາດໃຊ້ Monyhar ໂດຍ​ບໍ່​ມີ​ການປະອັນໃດໄວ້ເບື້ອງຫຼັງ.</translation>
<translation id="4994636714258228724">ເພີ່ມທ່ານເອງໃສ່ Monyhar</translation>
<translation id="5224391634244552924">ບໍ່ມີລະຫັດຜ່ານທີ່ບັນທຶກໄວ້. Monyhar ສາມາດກວດເບິ່ງລະຫັດຜ່ານຂອງທ່ານເມື່ອທ່ານບັນທຶກພວກມັນໄວ້.</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" /> ເຂົ້າສູ່ລະບົບໂປຣໄຟລ໌ Monyhar ນີ້ຢູ່ກ່ອນແລ້ວ. ນີ້ຈະເປັນການສ້າງໂປຣໄຟລ໌ Monyhar ໃໝ່ສຳລັບ <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="5277894862589591112">ເພື່ອນຳໃຊ້ການປ່ຽນແປງຂອງທ່ານ, ກະລຸນາເປີດ Monyhar ຄືນໃໝ່</translation>
<translation id="5358375970380395591">ທ່ານກໍາລັງລົງຊື່ເຂົ້າ​ໃຊ້ດ້ວຍບັນຊີຄຸ້ມຄອງ ແລະໃຫ້ຜູ້ຄວບຄຸມຂອງມັນຄວບຄຸມໂປຣໄຟລ໌ Monyhar ຂອງທ່ານ. ຂໍ້ມູນ Monyhar ຂອງທ່ານ, ເຊັ່ນ: ແອັບ, ບຸກມາກສ໌, ປະຫວັດ, ລະຫັດຜ່ານ, ແລະການຕັ້ງຄ່າອື່ນໆຂອງທ່ານຈະຖືກຜູກ​ມັດ​ກັບ <ph name="USER_NAME" /> ຢ່າງຖາວອນ. ທ່ານຈະສາມາດລຶບຂໍ້ມູນນີ້ໄດ້ຜ່ານ Google Accounts Dashboard, ແຕ່ທ່ານຈະບໍ່ສາມາດເອົາຂໍ້ມູນນີ້ເຂົ້າຮ່ວມກັບບັນຊີອື່ນໄດ້. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">ກຳລັງອັບເດດ Monyhar (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">ອະນຸຍາດການເຂົ້າສູ່ລະບົບ Monyhar</translation>
<translation id="5398878173008909840">ມີ Monyhar ລຸ້ນໃໝ່ຢູ່.</translation>
<translation id="5416696090975899932">Monyhar ບໍ່ສາມາດສະແດງຕົວຢ່າງການພິມເມື່ອບໍ່ມີໂປຣແກຣມເບິ່ງ PDF ທີ່ມາພ້ອມໃນຕົວ.</translation>
<translation id="5427571867875391349">ຕັ້ງ Monyhar ເປັນບຣາວ​ເຊີມາດຕະຖານຂອງທ່ານ</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Monyhar Beta</translation>
<translation id="5479196819031988440">Monyhar OS ບໍ່ສາມາດເປີດໜ້ານີ້ໄດ້.</translation>
<translation id="5480860683791598150">Monyhar ຕ້ອງການເຂົ້າເຖິງສະຖານທີ່ຂອງທ່ານເພື່ອແບ່ງປັນສະຖານທີ່ຂອງທ່ານກັບເວັບໄຊນີ້</translation>
<translation id="5481338274774984070">Monyhar ແນະນຳໃຫ້ທ່ານຢ່າດາວໂຫຼດ ຫຼື ເປີດໄຟລ໌ນີ້.</translation>
<translation id="549669000822060376">ກະ​ລຸ​ນາ​ລໍ​ຖ້າ​ໃນ​ຂະ​ນະ​ທີ່ Monyhar ​ຕິດ​ຕັ້ງ​ການອັບເດດລະບົບຫລ້າ​ສຸດ.</translation>
<translation id="5496810170689441661">Monyhar ກໍາລັງພະຍາຍາມແກ້ໄຂລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດໃຫ້ສຳເນົາໄດ້.</translation>
<translation id="5527463683072221100">ເປີດ PDF ໃນ Monyhar</translation>
<translation id="5623402015214259806">{0,plural, =0{ມີການອັບເດດ Monyhar}=1{ມີການອັບເດດ Monyhar}other{ມີການອັບເດດ Monyhar ເປັນເວລາ # ມື້ແລ້ວ}}</translation>
<translation id="5634636535844844681">Monyhar ຕ້ອງໃຊ້ Windows 7 ຫຼື ສູງກວ່າ.</translation>
<translation id="5653831366781983928">ກະລຸນາປິດເປີດ Monyhar ຄືນໃໝ່ຕອນນີ້</translation>
<translation id="5698481217667032250">ສະ​ແດງ Monyhar ເປັນພາສານີ້</translation>
<translation id="5820394555380036790">Monyhar OS</translation>
<translation id="5854740544000584380">Monyhar OS ເກີດຂຶ້ນໄດ້ໂດຍ <ph name="BEGIN_LINK_CROS_OSS" />ຊອບແວໂອເພນຊອດ<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ, ເຊັ່ນດຽວກັບ <ph name="BEGIN_LINK_LINUX_OSS" />ສະພາບແວດລ້ອມການພັດທະນາ Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="5862307444128926510">ຍິນ​ດີ​ຕ້ອນ​ຮັບສູ່ Monyhar</translation>
<translation id="5895138241574237353">ເລີ່ມຕົ້ນໃໝ່</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ການເຂົ້າສູ່ລະບົບເຄືອຂ່າຍ</translation>
<translation id="5987687638152509985">ອັບເດດ Monyhar ເພື່ອເລີ່ມຊິ້ງຂໍ້ມູນ</translation>
<translation id="6039377483953237732">ເວີຊັນ Monyhar OS</translation>
<translation id="6055895534982063517">ມີ Monyhar ລຸ້ນໃໝ່ຢູ່, ແລະມັນປອດໄພກ່ວາຜ່ານມາ.</translation>
<translation id="6063093106622310249">&amp;ເປີດໃນ Monyhar</translation>
<translation id="6072279588547424923">ເພີ່ມ <ph name="EXTENSION_NAME" /> ໃສ່ Monyhar ແລ້ວ</translation>
<translation id="608006075545470555">ເພີ່ມໂປຣໄຟລ໌ບ່ອນເຮັດວຽກໃສ່ໂປຣແກຣມທ່ອງເວັບນີ້</translation>
<translation id="608189560609172163">Monyhar ບໍ່​ສາ​ມາດຊິງຄ໌ຂໍ້​ມູນ​ຂອງ​ທ່ານໄດ້ ເນື່ອ​ງຈາກ​ການລົງຊື່ເຂົ້າ​ໃຊ້ຜິດພາດ.</translation>
<translation id="6096348254544841612">ປັບແຕ່ງ ແລະ ຄວບຄຸມ Monyhar. ມີການອັບເດດແລ້ວ</translation>
<translation id="6120345080069858279">Monyhar ຈະບັນທຶກລະຫັດຜ່ານນີ້ໄວ້ໃນບັນຊີ Google ຂອງທ່ານ. ທ່ານຈະບໍ່ຈຳເປັນຕ້ອງຈື່ມັນ.</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> ອັນຕະລາຍ, ສະນັ້ນ Monyhar ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="6134968993075716475">Safe Browsing ປິດຢູ່. Monyhar ຂໍແນະນຳໃຫ້ເປີດມັນ.</translation>
<translation id="6145820983052037069">ທ່ານສາມາດສະຫຼັບລະຫວ່າງໂປຣໄຟລ໌ Monyhar ໄດ້ຢູ່ບ່ອນນີ້</translation>
<translation id="61577490437262925"><ph name="BEGIN_PARAGRAPH1" />ພວກເຮົາພ້ອມຕິດຕັ້ງ Monyhar OS ແລ້ວ! ຫຼັງຈາກທີ່ທ່ານດຳເນີນການຕໍ່ແລ້ວ:
          <ph name="BEGIN_LIST" />
          <ph name="LIST_ITEM" />ໄຟລ໌, ຂໍ້ມູນ ແລະ ລະບົບປະຕິບັດການປັດຈຸບັນຂອງທ່ານຈະຖືກລຶບອອກ.
          <ph name="LIST_ITEM" />Monyhar OS ຈະຖືກຕິດຕັ້ງ.
          <ph name="LIST_ITEM" />ອຸປະກອນຂອງທ່ານຈະປິດເຄື່ອງເມື່ອການຕິດຕັ້ງສຳເລັດແລ້ວ.
          <ph name="END_LIST" />
          <ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />ການແຈ້ງເຕືອນເທື່ອສຸດທ້າຍ: ການຕິດຕັ້ງຈະລຶບທັງຮາດໄດຣຟ໌ຂອງທ່ານອອກ. ກະລຸນາກວດສອບວ່າທ່ານສຳຮອງຂໍ້ມູນທີ່ທ່ານຕ້ອງການໄວ້ໝົດແລ້ວ.<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />ຫຼັງຈາກເລີ່ມການຕິດຕັ້ງແລ້ວມັນຈະບໍ່ສາມາດຍົກເລີກໄດ້.<ph name="END_PARAGRAPH3" /></translation>
<translation id="6183079672144801177">ກວດໃຫ້ແນ່ໃຈວ່າທ່ານໄດ້ເຂົ້າສູ່ລະບົບ Chrome ໃນ <ph name="TARGET_DEVICE_NAME" /> ຂອງທ່ານ ແລ້ວລອງສົ່ງໃໝ່.</translation>
<translation id="6212496753309875659">ຄອມພິວເຕີນີ້ມີ Monyhar ລຸ້ນໃໝ່ກ່ວາຢູ່ຮຽບຮ້ອຍແລ້ວ. ຖ້າຊອບແວບໍ່ເຮັດວຽກ, ກະລຸນາຖອນຕິດຕັ້ງ Monyhar ແລະລອງໃໝ່ອີກ.</translation>
<translation id="6219195342503754812">{0,plural, =0{Monyhar ຈະເປີດຄືນໃໝ່ດຽວນີ້}=1{Monyhar ຈະເປີດຄືນໃໝ່ໃນ 1 ວິນາທີ}other{Monyhar ຈະເປີດຄືນໃໝ່ໃນ # ວິນາທີ}}</translation>
<translation id="6248213926982192922">ເຮັດ Monyhar ເປັນບຣາວ​ເຊີມາດຕະຖານ</translation>
<translation id="6266342355635466082">Monyhar ບໍ່ສາມາດກວດຫາການອັບເດດໄດ້. ລອງກວດເບິ່ງການເຊື່ອມຕໍ່ອິນເຕີເນັດຂອງທ່ານ.</translation>
<translation id="6268381023930128611">ອອກຈາກລະບົບ Monyhar ບໍ?</translation>
<translation id="6281746429495226318">ປັບແຕ່ງໂປຣໄຟລ໌ Monyhar ຂອງທ່ານ</translation>
<translation id="6290827346642914212">ຕັ້ງຊື່ໂປຣໄຟລ໌ Monyhar ຂອງທ່ານ</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> ອາດຈະອັນຕະລາຍ, ສະນັ້ນ Monyhar ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="6309712487085796862">Monyhar ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບຂອງ​ທ່ານ​.</translation>
<translation id="6333502561965082103">ການດຳເນີນການອື່ນໃນ Monyhar ພວມດຳເນີນຢູ່. ກະລຸນາລອງອີກຄັ້ງໃນພາຍຫຼັງ.</translation>
<translation id="6334986366598267305">ດຽວນີ້ມັນງ່າຍທີ່ຈະໃຊ້ Monyhar ກັບບັນຊີ Google ຂອງທ່ານ ແລະຢູ່ໃນຄອມພິວເຕີທີ່ແຊຣ໌ແລ້ວ.</translation>
<translation id="6373523479360886564">ທ່ານແນ່ໃຈບໍວ່າ ທ່ານຕ້ອງການຖອນຕິດຕັ້ງ Monyhar?</translation>
<translation id="6403826409255603130">Monyhar ແມ່ນບຣາວເຊີເວັບທີ່ແລ່ນໜ້າເວັບ ແລະແອັບພລິເຄຊັນດ້ວຍຄວາມໄວແບບສາຍຟ້າແມັບ. ມັນໄວ, ໝັ້ນຄົງ, ແລະໃຊ້ງ່າຍ. ທ່ອງເວັບໄດ້ປອດໄພກ່ວາດ້ວຍການປົກປ້ອງມາລແວ ແລະພິຊຊິງທີ່ສ້າງຢູ່ໃນຕົວ Monyhar.</translation>
<translation id="6434250628340475518">ລະບົບປະຕິບັດການຂອງ Monyhar</translation>
<translation id="6455857529632101747">ຍິນດີຕ້ອນຮັບສູ່ໂປຣໄຟລ໌ Monyhar</translation>
<translation id="6457450909262716557">{SECONDS,plural, =1{Monyhar ຈະປິດແລ້ວເປີດໃໝ່ໃນ 1 ວິນາທີ}other{Monyhar ຈະປິດແລ້ວເປີດໃໝ່ໃນ # ວິນາທີ}}</translation>
<translation id="646620589868199210">ພ້ອມຕິດຕັ້ງ Monyhar OS ແລ້ວ</translation>
<translation id="6475912303565314141">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ Monyhar.</translation>
<translation id="6510925080656968729">ຖອນ​ຕິດ​ຕັ້ງ Monyhar</translation>
<translation id="6542839706527980775">ແຕ່ລະໂປຣໄຟລ໌ມີຂໍ້ມູນ Monyhar ຂອງມັນເອງ ເຊັ່ນ: ບຸກມາກ, ປະຫວັດ, ລະຫັດຜ່ານ ແລະ ອື່ນໆອີກ</translation>
<translation id="6570579332384693436">ເພື່ອແກ້ໄຂການສະກົດຄຳຜິດ, Monyhar ສົ່ງຂໍ້ຄວາມທີ່ທ່ານພິມໃນຊ່ອງຂໍ້ຄວາມໃຫ້ Google</translation>
<translation id="6598877126913850652">ໄປຫາການຕັ້ງຄ່າການແຈ້ງເຕືອນຂອງ Monyhar</translation>
<translation id="6613594504749178791">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ Monyhar ໃໝ່.</translation>
<translation id="6676384891291319759">ການເຂົ້າຫາອິນເຕີເນັດ</translation>
<translation id="6717134281241384636">ບໍ່ສາມາດໃຊ້ໂປຣໄຟລ໌ຂອງທ່ານໄດ້ ເພາະວ່າມັນມາຈາກ Monyhar ລຸ້ນໃໝ່ກ່ວາ.

ບາງ​ຄຸນສົມບັດອາດຈະບໍ່ມີ​ໃຫ້. ກະລຸນາລະບຸລາຍຊື່ບັນຊີໂປຣໄຟລ໌ຕ່າງ ຫຼືໃຊ້ Monyhar ລຸ້ນໃໝ່ກ່ວາ.</translation>
<translation id="6734080038664603509">ອັບເດດ Monyhar</translation>
<translation id="6734291798041940871">ຕິດຕັ້ງ Monyhar ສຳລັບຜູ້ໃຊ້ທຸກຄົນໃນຄອມພິວເຕີຂອງທ່ານແລ້ວ.</translation>
<translation id="673636774878526923">ເພື່ອເຂົ້າເຖິງຂໍ້ມູນໃນ Monyhar ຂອງທ່ານຢູ່ໃນອຸປະກອນທັງໝົດຂອງທ່ານ, ກະລຸນາເຂົ້າສູ່ລະບົບ ແລ້ວເປີດການຊິ້ງຂໍ້ມູນ.</translation>
<translation id="6774082503108938489">ພໍ່ແມ່ຂອງທ່ານໄດ້ປິດ "ການອະນຸຍາດສຳລັບເວັບໄຊ, ແອັບ ແລະ ສ່ວນຂະຫຍາຍ" ສຳລັບ Monyhar ແລ້ວ. ການເປີດການນຳໃຊ້ <ph name="EXTENSION_TYPE_PARAMETER" /> ນີ້ບໍ່ໄດ້ຮັບອະນຸຍາດ.</translation>
<translation id="6827182711503025204">ການຕິດຕັ້ງ Monyhar OS ຈະຂຽນທັບຂໍ້ມູນທັງໝົດຢູ່ອຸປະກອນຂອງທ່ານ.</translation>
<translation id="6847869444787758381">Monyhar ແຈ້ງໃຫ້ທ່ານຮູ້ຖ້າມີຄົນຮູ້ລະຫັດຜ່ານຂອງທ່ານ</translation>
<translation id="6857782730669500492">Monyhar - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (ສຳເນົາໄວ້ໃນ Monyhar ແລ້ວ)</translation>
<translation id="6893813176749746474">ອັບເດດ Monyhar ແລ້ວ, ແຕ່ທ່ານບໍ່ໄດ້ໃຊ້ມັນເປັນເວລາຢ່າງໜ້ອຍ 30 ວັນແລ້ວ​.</translation>
<translation id="691026815377248078">Monyhar ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສືບຕໍ່ 
 ການຈັບຄູ່. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6964305034639999644">ເປີດລິ້ງໃນໜ້າຈໍທີ່ບໍ່ເຜີຍຕົວຕົນຂອງ Monyhar</translation>
<translation id="6978145336957848883">ລະຫັດຜ່ານງ່າຍແມ່ນລະຫັດຜ່ານທີ່ເດົາໄດ້ງ່າຍ. ອະນຸຍາດໃຫ້ Monyhar <ph name="BEGIN_LINK" />ສ້າງ ແລະ ຈື່ລະຫັດຜ່ານຍາກສຳລັບທ່ານ<ph name="END_LINK" />.</translation>
<translation id="6990124437352146030">Monyhar ຕ້ອງການການອະນຸຍາດເພື່ອເຂົ້າເຖິງໄມໂຄຣໂຟນຂອງທ່ານສຳລັບເວັບໄຊນີ້</translation>
<translation id="705851970750939768">ອັບເດດ Monyhar</translation>
<translation id="7067091210845072982">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, Monyhar ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google.</translation>
<translation id="7196312274710523067">ບໍ່ສາມາດເປີດໃຊ້ Monyhar ໄດ້. ກະລຸນາລອງອີກຄັ້ງ.</translation>
<translation id="7197677400338048821">Monyhar ບໍ່ສາມາດກວດລະຫັດຜ່ານຂອງທ່ານໄດ້. ກະລຸນາລອງໃໝ່ຫຼັງຈາກ 24 ຊົ່ວໂມງ.</translation>
<translation id="7223968959479464213">ຕົວຈັດການໜ້າວຽກ - Monyhar</translation>
<translation id="731644333568559921">ອັບເດດ Monyhar OS</translation>
<translation id="731795002583552498">ກໍາລັງອັບເດດ Monyhar</translation>
<translation id="7318036098707714271">ໄຟລ໌ທີ່ມັກຂອງທ່ານເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້.

Monyhar ບໍ່ສາມາດກູ້ການຕັ້ງຄ່າຂອງທ່ານຄືນໄດ້.</translation>
<translation id="7337881442233988129">Monyhar</translation>
<translation id="7339898014177206373">ໜ້າ​ຕ່າງໃໝ່</translation>
<translation id="734373864078049451">ເວັບຂອງທ່ານ, ບຸກມາກສ໌, ແລະ Monyhar ອື່ນສົດຢູ່ທີ່ນີ້.</translation>
<translation id="7349591376906416160">ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານໄດ້ກຳນົດຄ່າໃຫ້ Monyhar ເປີດ <ph name="ALTERNATIVE_BROWSER_NAME" /> ເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7448255348454382571">ປິດເປີດ Monyhar OS ຄືນໃໝ່</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - Monyhar Dev</translation>
<translation id="7451052299415159299">Monyhar ຕ້ອງການການອະນຸຍາດເພື່ອເຂົ້າເຖິງກ້ອງຖ່າຍຮູບຂອງທ່ານສຳລັບເວັບໄຊນີ້</translation>
<translation id="7483335560992089831">ບໍ່ສາມາດຕິດຕັ້ງ Monyhar ລຸ້ນດຽວກັບທີ່ກໍາລັງແລ່ນຢູ່ໃນປະຈຸບັນ​ໄດ້. ກະລຸນາປິດ Monyhar ແລະລອງໃໝ່ອີກ.</translation>
<translation id="753534427205733210">{0,plural, =1{Monyhar ຈະເປີດຄືນໃໝ່ໃນ 1 ນາທີ}other{Monyhar ຈະເປີດຄືນໃໝ່ໃນ # ນາທີ}}</translation>
<translation id="7549178288319965365">ກ່ຽວ​ກັບ Monyhar OS</translation>
<translation id="7561906087460245826">ລຶບລ້າງຂໍ້ມູນອອກຈາກ Monyhar (<ph name="URL" />) ນຳ</translation>
<translation id="7585853947355360626">ຖ້າການຕັ້ງຄ່າບໍ່ສະແດງໃນໜ້ານີ້, ກະລຸນາກວດເບິ່ງໃນ <ph name="LINK_BEGIN" />
    ການຕັ້ງຄ່າ Monyhar OS<ph name="LINK_END" /> ຂອງທ່ານ</translation>
<translation id="761356813943268536">Monyhar ກໍາລັງໃຊ້​ກ້ອງ​ຖ່າຍ​ຮູບ​ ແລະໄມໂຄຣໂຟນຂອງ​ທ່ານ​.</translation>
<translation id="7617377681829253106">Monyhar ​ດີກ​ວ່າແລ້ວ</translation>
<translation id="7627575518938382525"><ph name="BEGIN_PARAGRAPH1" />ກ່ອນທີ່ພວກເຮົາຈະເລີ່ມ, ກະລຸນາກວດສອບວ່າທ່ານສຳຮອງຂໍ້ມູນຫຼ້າສຸດຂອງທ່ານໄວ້ແລ້ວ. ການຕິດຕັ້ງ Monyhar OS ຈະຂຽນທັບຂໍ້ມູນທັງໝົດຢູ່ຮາດໄດຣຟ໌ຂອງທ່ານ.<ph name="END_PARAGRAPH1" />
          <ph name="BEGIN_PARAGRAPH2" />Google ບໍ່ຮັບຜິດຊອບຕໍ່ການສູນເສຍຂໍ້ມູນໃດກໍຕາມ ແລະ ບໍ່ຮັບປະກັນວ່າ Monyhar OS ຈະເຮັດວຽກໄດ້ຢູ່ຮຸ່ນທີ່ບໍ່ໄດ້ຮັບການຮັບຮອງ. ກະລຸນາເຂົ້າໄປ [TBD] ເພື່ອສຶກສາເພີ່ມເຕີມກ່ຽວກັບຮຸ່ນທີ່ໄດ້ຮັບການຮັບຮອງ.<ph name="END_PARAGRAPH2" />
          <ph name="BEGIN_PARAGRAPH3" />ສຶກສາເພີ່ມເຕີມກ່ຽວກັບການຕິດຕັ້ງ Monyhar OS ແລະ ການລຶບຂໍ້ມູນ: [TBD URL]<ph name="END_PARAGRAPH3" />
          <ph name="BEGIN_PARAGRAPH4" />ຫາກທ່ານພ້ອມດຳເນີນການແລ້ວ, ໃຫ້ຄລິກໃສ່ “ຕິດຕັ້ງ Monyhar OS” ແລ້ວພວກເຮົາຈະພາທ່ານເຂົ້າສູ່ການຕິດຕັ້ງໃນສອງສາມຂັ້ນຕອນງ່າຍໆ. ທ່ານຈະມີໂອກາດຢືນຢັນອີກເທື່ອໜຶ່ງກ່ອນທີ່ພວກເຮົາຈະປ່ຽນແປງຄອມພິວເຕີຂອງທ່ານ.<ph name="END_PARAGRAPH4" /></translation>
<translation id="7686590090926151193">Monyhar ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານ</translation>
<translation id="7689606757190482937">ຊິ້ງຂໍ້ມູນ ແລະ ປັບແຕ່ງ Monyhar ໃຫ້ເປັນແບບສ່ວນຕົວໃນທົ່ວອຸປະກອນຂອງທ່ານ</translation>
<translation id="7729447699958282447">Monyhar ບໍ່​ສາ​ມາດຊິງຄ໌ຂໍ້​ມູນ​ຂອງ​ທ່ານໄດ້ ເພາະວ່າບໍ່ມີການຊິງຄ໌ຢູ່ໃນໂດເມນຂອງທ່ານ.</translation>
<translation id="7745317241717453663">ນີ້ຈະລຶບຂໍ້ມູນການທ່ອງເວັບຂອງທ່ານອອກຈາກອຸປະກອນນີ້. ເພື່ອກູ້ຂໍ້ມູນຂອງທ່ານຄືນໃນພາຍຫຼັງ, ກະລຸນາເຂົ້າສູ່ລະບົບ Monyhar ເປັນ <ph name="USER_EMAIL" />.</translation>
<translation id="7747138024166251722">ຕົວຕິດຕັ້ງບໍ່ສາມາດສ້າງໄດເຣັກຕໍຣີຊົ່ວຄາວໄດ້. ກະລຸນາກວດເບິ່ງບ່ອນ​ວ່າງດິສກ໌ ແລະການອະນຸຍາດ ເພື່ອຕິດຕັ້ງຊອບແວ.</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - Monyhar Canary</translation>
<translation id="7828947555739565424">ມີໂປຣໄຟລ໌ Monyhar ກັບບັນຊີນີ້ຢູ່ອຸປະກອນນີ້ຢູ່ກ່ອນແລ້ວ</translation>
<translation id="7857220146454061152">ເພື່ອຮັບການອັບເດດ Monyhar ໃນອະນາຄົດ, ທ່ານຈະຈຳເປັນຕ້ອງມີ OS X 10.11 ຫຼື ໃໝ່ກວ່າ. ຄອມພິວເຕີນີ້ກຳລັງໃຊ້ OS X 10.10.</translation>
<translation id="7867198900892795913">Monyhar ບໍ່ສາມາດອັບເດດເປັນເວີຊັນຫຼ້າສຸດໄດ້, ສະນັ້ນທ່ານກຳລັງພາດຄຸນສົມບັດ ແລະ ການແກ້ໄຂດ້ານຄວາມປອດໄພໃໝ່ໆຢູ່.</translation>
<translation id="7898472181347242998">ເພື່ອເບິ່ງວ່າອຸປະກອນຂອງທ່ານໃໝ່ຫຼ້າສຸດຫຼືບໍ່, ກະລຸນາໄປທີ່ <ph name="LINK_BEGIN" />ການຕັ້ງຄ່າ Monyhar OS<ph name="LINK_END" /></translation>
<translation id="7907774600618164274">Monyhar OS ປິດຢ່າງບໍ່ຖືກຕ້ອງ.</translation>
<translation id="7937630085815544518">ທ່ານ​ໄດ້ລົງຊື່ເຂົ້າໃຊ້ Monyhar ເປັນ <ph name="USER_EMAIL_ADDRESS" />. ກະ​ລຸ​ນາ​​ໃຊ້​ບັນ​ຊີ​ດຽວ​ກັນ​ ເພື່ອລົງຊື່ເຂົ້າໃຊ້ອີກ.</translation>
<translation id="7975919845073681630">ນີ້ແມ່ນການຕິດຕັ້ງສຳຮອງຂອງ Monyhar ແລະ ບໍ່ສາມາດຖືກຕັ້ງເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນໄດ້.</translation>
<translation id="8013436988911883588">ເມື່ອ Monyhar ມີການເຂົ້າເຖິງ, ເວັບໄຊຈະສາມາດຮ້ອງຂໍການເຂົ້າເຖິງນຳທ່ານ.</translation>
<translation id="81770708095080097">ໄຟລ໌ນີ້ເປັນອັນຕະລາຍ, ສະນັ້ນ Monyhar ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="8248265253516264921">ຖ້າຮູບບໍ່ມີລາຍລະອຽດທີ່ເປັນປະໂຫຍດ, Monyhar ຈະພະຍາຍາມໃຫ້ລາຍລະອຽດແກ່ທ່ານ. ເພື່ອສ້າງລາຍລະອຽດ, ລະບົບຈະສົ່ງຮູບພາບໃຫ້ Google. ທ່ານສາມາດປິດສິ່ງນີ້ໃນການຕັ້ງຄ່າໄດ້ທຸກເວລາ.</translation>
<translation id="8266560134891435528">Monyhar ບໍ່ສາມາດກວດລະຫັດຜ່ານຂອງທ່ານໄດ້ ເພາະວ່າທ່ານບໍ່ໄດ້ເຂົ້າສູ່ລະບົບ</translation>
<translation id="8276522524898344151">Monyhar ກໍາລັງພະຍາຍາມສຳເນົາລະຫັດຜ່ານ.</translation>
<translation id="8290862415967981663">ໄຟລ໌ນີ້ອາດຈະເປັນອັນຕະລາຍ, ສະນັ້ນ Monyhar ໄດ້ບລັອກມັນໄວ້ແລ້ວ.</translation>
<translation id="8330519371938183845">ເຂົ້າສູ່ລະບົບເພື່ອຊິ້ງຂໍ້ມູນ ແລະ ປັບແຕ່ງ Monyhar ໃຫ້ເປັນແບບສ່ວນຕົວໃນທົ່ວອຸປະກອນຂອງທ່ານ</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> ເຄີຍໃຊ້ Monyhar ໃນເມື່ອກ່ອນ</translation>
<translation id="8417404458978023919">{0,plural, =1{ເປີດໃຊ້ Monyhar ຄືນໃໝ່ພາຍໃນໜຶ່ງມື້}other{ເປີດໃຊ້ Monyhar ຄືນໃໝ່ພາຍໃນ # ມື້}}</translation>
<translation id="8453117565092476964">ຄັງຕົວຕິດຕັ້ງຖືກເສຍຫາຍ ຫຼືໃຊ້ບໍ່ໄດ້. ກະລຸນາດາວໂຫຼດ Monyhar ອີກ.</translation>
<translation id="8493179195440786826">Monyhar ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="8550334526674375523">ໂປຣໄຟລ໌ບ່ອນເຮັດວຽກນີ້ແຍກກັນຢ່າງສິ້ນເຊີງຈາກໂປຣໄຟລ໌ສ່ວນຕົວຂອງທ່ານ.</translation>
<translation id="8558383651099478961">ພໍ່ແມ່ຂອງທ່ານໄດ້ປິດ "ການອະນຸຍາດສຳລັບເວັບໄຊ, ແອັບ ແລະ ສ່ວນຂະຫຍາຍ" ສຳລັບ Monyhar ແລ້ວ. ການເພີ່ມ <ph name="EXTENSION_TYPE_PARAMETER" /> ນີ້ບໍ່ໄດ້ຮັບອະນຸຍາດ.</translation>
<translation id="8568283329061645092">Monyhar ສາມາດກວດເບິ່ງລະຫັດຜ່ານຂອງທ່ານ ເມື່ອທ່ານເຂົ້າສູ່ລະບົບດ້ວຍບັນຊີ Google ຂອງທ່ານໄດ້</translation>
<translation id="8586442755830160949">ລິຂະສິດ <ph name="YEAR" /> ຜູ້ຂຽນ Monyhar. ສະຫງວນສິດທັງໝົດ.</translation>
<translation id="8619360774459241877">ກຳລັງເປີດໃຊ້ Monyhar...</translation>
<translation id="8621669128220841554">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ ​ເນື່ອງ​ຈາກ​ຄວາມຜິດພາດທີ່ບໍ່ໄດ້ລະບຸ​. ກະ​ລຸ​ນາ​ດາວ​ໂຫລດ Monyhar ອີກ​.</translation>
<translation id="8697124171261953979">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ສະແດງໜ້າໃດຂຶ້ນ ເມື່ອທ່ານເລີ່ມຕົ້ນເປີດ Monyhar ຫຼືຄົ້ນຫາຈາກ Omnibox.</translation>
<translation id="8704119203788522458">ນີ້​ແມ່ນ Monyhar ຂອງ​ທ່ານ</translation>
<translation id="8796602469536043152">Monyhar ຕ້ອງການການອະນຸຍາດເພື່ອເຂົ້າເຖິງກ້ອງຖ່າຍຮູບ ແລະ ໄມໂຄຣໂຟນຂອງທ່ານສຳລັບເວັບໄຊນີ້</translation>
<translation id="8803635938069941624">​ເງື່ອນ​ໄຂ​ກໍາ​ນົດຂອງ Monyhar OS</translation>
<translation id="8821041990367117597">Monyhar ບໍ່ສາມາດຊິງຄ໌ຂໍ້ມູນຂອງທ່ານໄດ້ ເພາະວ່າລາຍລະອຽດລົງຊື່ເຂົ້າ​ໃຊ້ບັນຊີຂອງທ່ານຫຼ້າສະໄໝແລ້ວ.</translation>
<translation id="8862326446509486874">ທ່ານບໍ່ມີສິດທິທີ່ເໝາະສົມສໍາລັບຕິດຕັ້ງ​ໃນລະດັບລະບົບ. ລອງແລ່ນຕົວຕິດຕັ້ງນີ້ອີກ​ໃນ​ຖານະ​ເປັນ​ຜູ້ຄວບຄຸມ.</translation>
<translation id="8880203542552872219">ຖ້າເປັນເຊັ່ນນັ້ນ, ກະລຸນາແກ້ໄຂລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ຂອງທ່ານໃນ Monyhar ເພື່ອໃຫ້ມັນກົງກັບລະຫັດຜ່ານໃໝ່ຂອງທ່ານ.</translation>
<translation id="8897323336392112261">ມັນຍັງຄວບຄຸມວ່າຈະໃຫ້ໜ້າໃດສະແດງຂຶ້ນມາ ເມື່ອທ່ານເລີ່ມເປີດ Monyhar ຫຼືຄລິກປຸ່ມໂຮມ.</translation>
<translation id="8907580949721785412">Monyhar ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດອັນນີ້.</translation>
<translation id="8941642502866065432">ບໍ່ສາມາດອັບເດດ Monyhar ໄດ້</translation>
<translation id="8974095189086268230">Monyhar OS ເຮັດໃຫ້ເປັນໄປໄດ້ໂດຍຊອບແວ <ph name="BEGIN_LINK_CROS_OSS" />open source<ph name="END_LINK_CROS_OSS" /> ເພີ່ມເຕີມ.</translation>
<translation id="8986207147630327271">ທ່ານກຳລັງເພີ່ມໂປຣໄຟລ໌ບ່ອນເຮັດວຽກໃສ່ໂປຣແກຣມທ່ອງເວັບນີ້ ແລະ ໃຫ້ຜູ້ເບິ່ງແຍງລະບົບຂອງທ່ານຄວບຄຸມໂປຣໄຟລ໌ບ່ອນເຮັດວຽກດັ່ງກ່າວເທົ່ານັ້ນ.</translation>
<translation id="9019929317751753759">ເພື່ອເຮັດໃຫ້ Monyhar ປອດໄພຂຶ້ນ, ພວກເຮົາປິດໃຊ້ງານບາງສ່ວນການ​ຕໍ່​ເຂົ້າ​ຫາ ທີ່​ບໍ່​ໄດ້​ເຮັດ​ເປັນ​ລາຍ​ການ​ໄວ້​ຢູ່​ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ແລະ​ອາດ​ຈະ​ຖືກ​ເອົາ​ເພີ່ມ​ເຂົ້າ​ໂດຍ​ທີ່​ທ່ານ​ບໍ່​ຮູ້​ຈັກ.</translation>
<translation id="9047197236183657400">ຍ້າຍບັນຊີໄປໃສ່ໂປຣໄຟລ໌ Monyhar ໃໝ່ບໍ?</translation>
<translation id="9089354809943900324">Monyhar ຫຼ້າສະໄໝແລ້ວ</translation>
<translation id="9093206154853821181">{0,plural, =1{Monyhar ຈະເປີດຄືນໃໝ່ໃນໜຶ່ງຊົ່ວໂມງ}other{Monyhar ຈະເປີດຄືນໃໝ່ໃນ # ຊົ່ວໂມງ}}</translation>
<translation id="91086099826398415">ເປີດລິ້ງໃນແຖບ Monyhar ໃໝ່</translation>
<translation id="911206726377975832">ລຶບຂໍ້ມູນການທ່ອງເນັດຂອງທ່ານນໍາບໍ?</translation>
<translation id="9158494823179993217">ຜູ້ເບິ່ງແຍງລະບົບໄດ້ກຳນົດຄ່າ Monyhar ໃຫ້ເປີດໂປຣແກຣມທ່ອງເວັບສຳຮອງເພື່ອເຂົ້າເຖິງ <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="9185526690718004400">ເລີ່ມເປີດໃຊ້ໃໝ່ເພື່ອອັບເດດ &amp;Monyhar</translation>
<translation id="9190841055450128916">Monyhar (mDNS-In)</translation>
<translation id="9214764063801632699">ລະບົບປະຕິບັດການຂອງ Monyhar</translation>
<translation id="93478295209880648">Monyhar ອາດຈະບໍ່ເຮັດວຽກຢ່າງຖືກຕ້ອງ ເພາະວ່າມັນບໍ່ຖືກຮອງຮັບໃນ Windows XP ຫຼື Windows Vista ອີກຕໍ່ໄປ</translation>
<translation id="965162752251293939">ໃຜກຳລັງໃຊ້ Monyhar)</translation>
<translation id="985602178874221306">ຜູ້ຂຽນ Monyhar</translation>
</translationbundle>