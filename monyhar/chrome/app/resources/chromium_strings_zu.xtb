<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="1098170124587656448">I-Monyhar ingasiza ukukugcina uphephile kusukela ekuphulweni kwedatha, kuzandiso ezimbi, nokuningi</translation>
<translation id="1104942323762546749">I-Monyhar ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="113122355610423240">I-Monyhar iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="1131805035311359397">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Monyhar<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">Mayelana ne-Monyhar</translation>
<translation id="1315551408014407711">Setha iphrofayela yakho entsha ye-Monyhar</translation>
<translation id="1396446129537741364">I-Monyhar izama ukubonisa amaphasiwedi.</translation>
<translation id="1414495520565016063">Ungene ngemvume ku-Monyhar!</translation>
<translation id="151962892725702025">I-Monyhar OS ayikwazanga ukuvumelanisa idatha yakho ngoba Ukuvumelanisa akutholakali kusizinda sakho.</translation>
<translation id="1524282610922162960">Yabelana ngethebhu ye-Monyhar</translation>
<translation id="1553461853655228091">I-Monyhar idinga imvume yokufinyelela kwikhamera yakho ukudala imephu engu-3D yendawo yakho ekuzungezile</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="1708666629004767631">Kukhona inguqulo entsha, ephephile ye-Monyhar etholakalayo.</translation>
<translation id="1774152462503052664">Vumela i-Monyhar ukuthi isebenze ngemuva</translation>
<translation id="1779356040007214683">Ukuze senze i-Monyhar ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="1808667845054772817">Phinda ufake i-Monyhar</translation>
<translation id="1881322772814446296">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-Monyhar. Idatha yakho ye-Monyhar, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Monyhar ihlukile. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Google njenge-Gmail ngaphandle kokungena ngemvume ku-Monyhar</translation>
<translation id="1929939181775079593">I-Monyhar ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="1966382378801805537">I-Monyhar ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="1981611865800294956">Qalisa kabusha ukuze ubuyekeze i-&amp;Monyhar OS</translation>
<translation id="2008474315282236005">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Monyhar njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="2020032459870799438">Ukuze uhlole uma ngabe amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zokuvikela, <ph name="BEGIN_LINK" />ngena ngemvume ku-Monyhar<ph name="END_LINK" />.</translation>
<translation id="2174178932569897599">Yenza i-Monyhar ngokwezifiso</translation>
<translation id="2185166961232948079">I-Monyhar - Inethiwekhi Yokungena ngemvume - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">Uma wabelana ngekhompyutha, abangani nomndeni bangadlulisa amehlo ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo nje.</translation>
<translation id="2294245788148774212">Ongakukhetha: Siza ekuthuthukiseni izici nokusebenza kwe-Chromim OS ngokuthumela ngokuzenzekelayo idatha yokusetshenziswa neyokuxilonga ku-Google.</translation>
<translation id="2343156876103232566">Ukuze uthumele inombolo kusukela lapha kufoni yakho ye-Android, ngena ngemvume ku-Monyhar kuwo womabili amadivayisi.</translation>
<translation id="2347108572062610441">Lesi sandiso siguqule ukuthi yiliphi ikhasi eliboniswayo uma uqala i-Monyhar.</translation>
<translation id="2396765026452590966">Isandiso esingu-"<ph name="EXTENSION_NAME" />" siguqule ukuthi yiliphi ikhasi eliboniswayo uma uqala i-Monyhar.</translation>
<translation id="2483889755041906834">Ku-Monyhar</translation>
<translation id="2485422356828889247">Khipha</translation>
<translation id="2535480412977113886">I-Monyhar OS ayikwazanga ukuvumelanisa idatha yakho ngoba imininingwane yokungena ngemvume kwi-akhawunti yakho iphelelwe isikhathi.</translation>
<translation id="2560420686485554789">I-Monyhar idinga ukufinyelela kusitoreji ukuze ilande amafayela</translation>
<translation id="2572494885440352020">Isisizi se-Monyhar</translation>
<translation id="2577788541081224677">Ukuze ufinyelelele ezintweni zakho ze-Monyhar kuwo wonke amadivayisi wakho, ngena ngemvume ukuze uvule ukuvumelanisa.</translation>
<translation id="2580426763510374355">Faka i-Monyhar OS</translation>
<translation id="2583187216237139145">Noma iyiphi idatha ye-Monyhar ekhiqizwa ngesikhathi sokusetshenziswa kwale phrofayela (efana nokudalwa kwamabhukhimakhi, umlando, amaphasiwedi, namanye amasethingi) ingasuswa umlawuli wephrofayela yomsebenzi. <ph name="LEARN_MORE" /></translation>
<translation id="2587578672395088481">I-Monyhar OS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="2648074677641340862">Iphutha le sistimu yokusebenza livele ngesikhathi sokufaka. Sicela uphinde ulande i-Monyhar.</translation>
<translation id="2661879430930417727">Uma wabelana ngedivayisi, abangane nomndeni bangaphequlula ngokuhlukile baphinde basethe i-Chrome ngendlela abafuna ngayo</translation>
<translation id="2711502716910134313">Ithebhu le-Monyhar</translation>
<translation id="2718390899429598676">Ngokuvikela okungeziwe, i-Monyhar izobethela idatha yakho.</translation>
<translation id="2770231113462710648">Guqula isiphequluli esizenzakalelayo sibe yi-:</translation>
<translation id="2799223571221894425">Qalisa kabusha</translation>
<translation id="2816712596130903444">Hlukanisa iphrofayela ye-Monyhar?</translation>
<translation id="2837693172913560447">Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS" /> iphrofayela entsha ye-Monyhar</translation>
<translation id="2847479871509788944">Susa kusuka  ku-Monyhar...</translation>
<translation id="2885378588091291677">Isiphathi somsebenzi</translation>
<translation id="2910007522516064972">Mayelana ne-&amp;Monyhar</translation>
<translation id="2977470724722393594">I-Monyhar isesikhathini samanje</translation>
<translation id="2983934633046890458">I-Monyhar izama ukuhlela amaphasiwedi.</translation>
<translation id="3032706164202344641">I-Monyhar ayikwazi ukuhlola iphasiwedi yakho. Zama futhi emuva kwesikhathi.</translation>
<translation id="3032787606318309379">Ingeza ku-Monyhar...</translation>
<translation id="3068515742935458733">Siza ukwenza i-Monyhar ibe ngcono ngokuthumela imibiko yokuphahlazeka ne-<ph name="UMA_LINK" /> ku-Google</translation>
<translation id="3103660991484857065">Isifaki sihlulekile ukungaminyanisi ingobo yomlando. Sicela ulande i-Monyhar futhi.</translation>
<translation id="3130323860337406239">I-Monyhar isebenzisa imakrofoni yakho.</translation>
<translation id="3155163173539279776">Phinda uqalise i-Monyhar</translation>
<translation id="3179665906251668410">Vula isixhumanisi kuwindi le-Monyhar Inco&amp;gnito</translation>
<translation id="3185330573522821672">Yenza ngendlela oyifisayo iphrofayela yakho entsha ye-Monyhar</translation>
<translation id="3190315855212034486">Eshu! I-Monyhar iphahlazekile. Qalisa kabusha manje?</translation>
<translation id="3229526316128325841">I-Monyhar ifuna ukuthumela amaphasiwedi akho.</translation>
<translation id="3258596308407688501">I-Monyhar ayikwazi ukufunda nokubhala umkhombandlela wayo wedatha:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">Inguqulo ye-Monyhar engu-<ph name="PRODUCT_VERSION" /> ifakiwe</translation>
<translation id="328888136576916638">Okhiye be-Google API abekho. Okunye ukusebenza kwe-Monyhar kuzokhutshazwa.</translation>
<translation id="3296368748942286671">Qhubeka usebenzise izinhlelo zokusebenza ezingemuva uma i-Monyhar ivaliwe</translation>
<translation id="331951419404882060">I-Monyhar OS ayikwazanga ukuvumelanisa idatha yakho yenxa yephutha lokungena ngemvume.</translation>
<translation id="3350761136195634146">Iphrofayela ye-Monyhar enale akhawunti isikhona kakade</translation>
<translation id="3406848076815591792">Shintshela kwiphrofayela le-Monyhar elikhona kakade?</translation>
<translation id="3430503420100763906">Ngamaphrofayela we-Monyhar ungahlukanisa zonke izinto zakho ze-Monyhar. Dala amaphrofayela wabangane nomndeni, noma uhlukanise phakathi komsebenzi nobumnandi.</translation>
<translation id="3433271666494956603">Ukufaka i-Monyhar OS kuyaqhubeka</translation>
<translation id="347328004046849135">I-Monyhar izokwazisa uma ungena ngemvume ngephasiwedi eyonakalisiwe</translation>
<translation id="3474745554856756813">Lokhu kuzobuyekeza izinto ezingu-<ph name="ITEMS_COUNT" /> kusuka kule divayisi. Ukuze ubuyise idatha yakho, ngena ngemvume ku-<ph name="USER_EMAIL" /> njengo.</translation>
<translation id="3497319089134299931">I-<ph name="SHORTCUT" /> ingashintsha phakathi kwamaphrofayela we-Monyhar</translation>
<translation id="3509308970982693815">Sicela uvale wonke amawindi we-Monyhar uphinde uzame futhi.</translation>
<translation id="3575459661164320785">Kunesofthiwe eyingozi kwikhompyutha yakho. I-Monyhar ingayisusa, ibuyise izilungiselelo zakho, futhi ikhubaze izandiso ukwenza isiphequluli sakho sisebenze kahle futhi.</translation>
<translation id="3610776674893128619">Sula Okuphakelayo futhi Ufake i-Monyhar OS</translation>
<translation id="3639635944603682591">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-Monyhar njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{Isibuyekezo esisha se-Monyhar siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha.}=1{Isibuyekezo esisha se-Monyhar siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Isibuyekezo esisha se-Monyhar siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Isibuyekezo esisha se-Monyhar siyatholakala futhi sizosetshenziswa maduze ngemuva kokuthi uqalise kabusha. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="3651803019964686660">Ukuze uthumele inombolo kusukela ku-<ph name="ORIGIN" /> kufoni yakho ye-Android, ngena ngemvume ku-Monyhar kuwo womabili amadivayisi.</translation>
<translation id="3685209450716071127">I-Monyhar ayikwazi ukuhlola iphasiwedi yakho. Zama ukuhlola ukuxhumeka kwakho ku-inthanethi.</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Umlawuli wakho ucela ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe lesi sibuyekezo}=1{Umlawuli wakho ucela ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe lesi sibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho ucela ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho ucela ukuthi uqalise kabusha i-Monyhar ukuze kusetshenziswe lesi sibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="371088601698879021">I-Monyhar OS ingabuyisela izinhlelo zakho zokusebenza namakhasi ngaso sonke isikhathi ngemva kokuqalisa kabusha ngaphandle kokubuza njalo.</translation>
<translation id="3713809861844741608">Vula isixhumanisi ku&amp;thebhu elisha le-Monyhar</translation>
<translation id="3728336900324680424">I-Monyhar izofinyelela iDrayivu yakho ukwenza iziphakamiso kwibha lekheli</translation>
<translation id="378917192836375108">I-Monyhar ikuvumela ukuthi uchofoze inombolo yefoni kuwebhu uphinde uyishayele nge-Skype!</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Monyhar</translation>
<translation id="388648406173476553">Yenza ngokwezifiso uphinde ulawule i-Monyhar. Okuthile kudinga ukuthi ukunake - chofoza ngemininingwane.</translation>
<translation id="3889543394854987837">Chofoza igama lakho ukuze uvule i-Monyhar uphinde uqale ukudlulisa amehlo.</translation>
<translation id="390528597099634151">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-Monyhar. Ukuze uqhubeke nokuphequlula ngokwehlukile, i-Monyhar ingakwazi ukukudalela iphrofayela yakho.</translation>
<translation id="3945058413678539331">I-Monyhar izama ukukopisha amaphasiwedi. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="4036079820698952681">Siza i-Monyhar ibengcono ngokubika <ph name="BEGIN_LINK" />izilungiselelo zamanje<ph name="END_LINK" /></translation>
<translation id="4050175100176540509">Ukuthuthukiswa kokuphepha okubalulekile nezici ezintsha kuyathokala kunguqulo yakamuva.</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Inethiwekhi Yokungena ngemvume - i-Monyhar</translation>
<translation id="421369550622382712">Thola izinhlelo zokusebenza ezinhle, amageyimu, izandiso, namatimu we-Monyhar.</translation>
<translation id="4216212958613226427">Lolu limi lusetshenziselwa ukubonisa i-Monyhar UI</translation>
<translation id="4230135487732243613">Xhumanisa idatha yakho ye-Monyhar kule akhawunti?</translation>
<translation id="4264410486868823224">I-<ph name="MANAGER" /> idinga ukuthi ufunde uphinde wamukele Imigomo Yesevisi elandelayo ngaphambi kokusebenzisa le divayisi. Le migomo ayinwebi, iguqule noma ikhawulele Imigomo ye-Monyhar OS.</translation>
<translation id="4271805377592243930">Thola usizo nge-Monyhar</translation>
<translation id="4285930937574705105">Ukufaka kuhlulekile ngenxa yephutha elingacacisiwe. Uma ngabe i-Monyhar iyasebenza manje, sicela uyivale uphinde uzame futhi.</translation>
<translation id="4407044323746248786">Phuma ku-Monyhar noma kunjalo?</translation>
<translation id="4415566066719264597">Vumela i-Monyhar isebenze ngemuva</translation>
<translation id="4423735387467980091">Yenza ngokwezifiso uphinde ulawule i-Monyhar</translation>
<translation id="4491398312037323794">Leli khasi likuvumela ukuba uphathe ama-akhawunti akho we-Google ongene kuwo ngemvume. La makhawunti akho azotholakala kusiphequluli se-Monyhar nezinhlelo zokusebenza ze-Google Play Isitolo, kanye namasevisi afana ne-Gmail, Idrayivu, ne-YouTube. <ph name="LINK_BEGIN" />Funda kabanzi<ph name="LINK_END" /></translation>
<translation id="452711251841752011">Siyakwamukela ku-Monyhar; iwindi elisha lesiphequluli livuliwe</translation>
<translation id="4544142686420020088">I-Monyhar ayibuyekezekanga, kunokuthile okungahambanga kahle. <ph name="BEGIN_LINK" />Lungisa izinkinga zokubuyekaza kwe-Monyhar nezibuyekezo ezihlulekile.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">Qhubeka kuphrofayela entsha ye-Monyhar?</translation>
<translation id="4567424176335768812">Ungene ngemvume njengo-<ph name="USER_EMAIL_ADDRESS" />. Manje ungakwazi ukufinyelela amabhukhimakhi, umlando, nezinye izilungiselelo kuwo wonke amadivayisi wakho ongene kuwo ngemvume.</translation>
<translation id="459535195905078186">Izinhlelo zokusebenza ze-Monyhar</translation>
<translation id="4665829708273112819">Isexwayiso: I-Monyhar ayikwazi ukuvimbela izandiso kusuka ekurekhodeni umlando wakho wokudlulisa amehlo. Ukuze ukhubaze lesi sandiso kumodi ye-incognito, yekisa ukukhetha le nketho.</translation>
<translation id="4677944499843243528">Iphrofayela ibukeka isetshenziswa enye inqubo ye-Monyhar (<ph name="PROCESS_ID" />) kwenye ikhompyutha (<ph name="HOST_NAME" />). I-Monyhar ikhiye iphrofayela ukuze ingamosheki. Uma uqinisekile ukuthi azikho ezinye izinqubo ezisebenzisa le phrofayela, ungavula iphrofayela uphinde uqalise i-Monyhar.</translation>
<translation id="469338717132742108">Thola usizo nge-Monyhar OS</translation>
<translation id="4708774505295300557">Umuntu othile ungene ngemvume ngaphambilini ku-Monyhar kule khompuyutha njengo-<ph name="ACCOUNT_EMAIL_LAST" />. Sicela udale umsebenzisi omusha we-Monyhar ukuze ugcine ulwazi lwakho luhlukile.</translation>
<translation id="4746050847053251315">Phuma ku-Monyhar noma kunjalo?</translation>
<translation id="4748217263233248895">Isibuyekezo esibalulekile sokuvikela se-Monyhar sisanda kufakwa. Qalisa kabusha manje bese sizobuyisela amathebhu akho.</translation>
<translation id="4750035648288509542">Icishe isisesikhathini! Qalisa kabusha i-Monyhar ukuqeda ukubuyekeza. Ama-modi e-Incognito ngeke aze aphinde avuleke.</translation>
<translation id="4788777615168560705">I-Monyhar ayikwazi ukuhlola iphasiwedi yakho. Zama futhi ngemva kwamahora angu-24 noma <ph name="BEGIN_LINK" />hlola amaphasiwedi ku-akhawunti yakho ye-Google<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Lokhu kusebenzisa isihloli sokupeleta esifanayo naleso esisetshenziswe kusesho lwe-Google. Umbhalo owuthayiphayo kusiphequluli uthunyelwa ku-Google. Ungahlala ushintsha le mpatho kuzilungiselelo.</translation>
<translation id="4888717733111232871">Umyalo obambeke ngaphakathi we-Monyhar wokuvumela ithrafikhi ye-mDNS.</translation>
<translation id="4893347770495441059">Qalisa kabusha ukuze Ubuyekeze i-&amp;Monyhar</translation>
<translation id="4943838377383847465">I-Monyhar kumodi yasemuva.</translation>
<translation id="4987820182225656817">Izihambeli zingasebenzisa i-Monyhar ngaphandle kokushiya noma yini ngemuva.</translation>
<translation id="4994636714258228724">Zingeze ngokwakho ku-Monyhar</translation>
<translation id="5224391634244552924">Awekho amaphasiwedi alondoloziwe. I-Monyhar ingahlola amaphasiwedi akho lapho uwalondoloza khona.</translation>
<translation id="5252179775517634216">U-<ph name="EXISTING_USER" /> usengene ngemvume kakade kule phrofayela ye-Monyhar. Lokhu kuzodalela u-<ph name="USER_EMAIL_ADDRESS" /> iphrofayela entsha ye-Monyhar</translation>
<translation id="5277894862589591112">Ukuze ufake izinguquko zakho, qalisa kabusha i-Monyhar</translation>
<translation id="5358375970380395591">Ungena ngemvume nge-akhawunti ephethwe futhi unikeza umlawuli wayo ukulawula okungaphezulu kwephrofayela yakho ye-Monyhar. Idatha yakho ye-Monyhar, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshezelwa unaphakade ku-<ph name="USER_NAME" />. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Google, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">Ibuyekeza i-Monyhar (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">Vumela ukungena ngemvume kwe-Monyhar</translation>
