<translation id="130631256467250065">Aldaketek gailua abiarazten duzun hurrengo aldian izango dute eragina.</translation>
<translation id="275588974610408078">Monyhar-ek ez du hutsegiteen berri emateko aukerarik ematen.</translation>
<translation id="3064346599913645280">Monyhar-eko orri seguru bat ari zara ikusten</translation>
<translation id="3550966579244642892">Monyhar OS sistemak ez du amaitu hasierako konfigurazioa.</translation>
<translation id="358997566136285270">Monyhar logotipoa</translation>
<translation id="4365115785552740256">Kode irekiko <ph name="BEGIN_LINK_CHROMIUM" />Monyhar<ph name="END_LINK_CHROMIUM" /> proiektuari esker eta <ph name="BEGIN_LINK_OSS" />kode irekiko softwareari<ph name="END_LINK_OSS" /> esker da posible Monyhar arakatzailea.</translation>
<translation id="4559775032954821361">Sakatu Monyhar menua &gt; <ph name="SETTINGS_TITLE" /> &gt; <ph name="ADVANCED_TITLE" /> &gt; <ph name="PROXIES_TITLE" /> &gt; LAN ezarpenak, eta desautatu "Erabili proxy-zerbitzaria LAN sarean" koadroa.</translation>
<translation id="4622039161600275920">Monyhar-ek blokeatu du orria</translation>
<translation id="48558539577516920">Eman suebakiaren edo birusen aurkako softwarearen ezarpenetan sarea atzitzeko baimena Monyhar-i.</translation>
<translation id="580822234363523061">Sakatu Monyhar menua &gt; <ph name="SETTINGS_TITLE" /> &gt; <ph name="ADVANCED_TITLE" /> &gt; <ph name="PROXIES_TITLE" /> eta ziurtatu konfigurazioan "proxyrik ez" edo "zuzena" gisa ezarrita dagoela.</translation>
<translation id="6613594504749178791">Aldaketek Monyhar abiarazten duzun hurrengo aldian izango dute eragina.</translation>
<translation id="7861509383340276692">Sakatu
          Monyhar menua &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          eta desautatu "<ph name="NO_PREFETCH_DESCRIPTION" />."
          Arazoa horrela konpontzen ez bada, aukera hori berriro hautatzea gomendatzen dizugu errendimendua hobetzeko.</translation>
<translation id="8187289872471304532">Zoaz
          Aplikazioak &gt; Sistemaren hobespenak &gt; Sarea &gt; Aurreratua &gt; Proxyak
          atalera eta desautatu hautatutako proxy guztiak.</translation>
<translation id="8684913864886094367">Monyhar ez da behar bezala itxi.</translation>
